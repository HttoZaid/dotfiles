String _formatDuration(Duration d) {
  final hours = d.inHours;
  final mins = d.inMinutes.remainder(60);
  return hours > 0 ? '$hours h $mins min' : '$mins min';
}

String _formatDistance(int meters) {
  if (meters >= 1000) {
    return '${(meters / 1609.34).toStringAsFixed(1)} mi';
  }
  return '${(meters * 3.28084).round()} ft';
}

double _calcProgress(CalculatedRoute route, GuidanceState guidance) {
  final total = route.distanceMeters;
  if (total <= 0) return 0;
  final remaining = guidance.remainingDistanceMeters;
  return (1.0 - (remaining / total)).clamp(0.0, 1.0);
}

class NavigationSheet extends StatefulWidget {
  final double maxHeight;
  final ValueChanged<double>? onHeightChanged;
  final Future<void> Function()? onExpandRequested;
  final Widget? child;
  final CalculatedRoute? route;
  final bool isCalculating;
  final VoidCallback? onCancelRoute;
  final Map<int, List<Checkpoint>> routeCheckpoints;
  final void Function(Checkpoint)? onRouteCheckpointTapped;
  final GuidanceState guidance;

  const NavigationSheet({
    required this.maxHeight,
    this.onHeightChanged,
    this.onExpandRequested,
    this.child,
    this.route,
    this.isCalculating = false,
    this.onCancelRoute,
    this.routeCheckpoints = const {},
    this.onRouteCheckpointTapped,
    this.guidance = const GuidanceState(),
    super.key,
  });

  @override
  State<NavigationSheet> createState() => NavigationSheetState();
}

class NavigationSheetState extends State<NavigationSheet> {
  bool _expanded = false;
  bool _showExpanded = false;

  double get _collapsedHeight {
    if (widget.guidance.isActive) return 188;
    if (widget.route != null) return 110;
    return 84;
  }

  double get _currentHeight =>
      _expanded ? widget.maxHeight * 0.5 : _collapsedHeight;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      widget.onHeightChanged?.call(_collapsedHeight);
    });
  }

  void _handleTap() {
    if (!_expanded) {
      _doExpand();
    } else {
      _doCollapse();
    }
    _notifyHeight();
  }

  void expand() {
    _doExpand();
    _notifyHeight();
  }

  void collapse() {
    _doCollapse();
    _notifyHeight();
  }

  void _doExpand() {
    setState(() {
      _expanded = true;
      _showExpanded = false;
    });
    Future.delayed(ThemeMotion.durBase, () {
      if (mounted && _expanded) {
        setState(() => _showExpanded = true);
      }
    });
  }

  void _doCollapse() {
    setState(() {
      _expanded = false;
      _showExpanded = false;
    });
  }

  void _notifyHeight() {
    WidgetsBinding.instance.addPostFrameCallback((_) {
      widget.onHeightChanged?.call(_currentHeight);
    });
  }

  @override
  Widget build(BuildContext context) {
    final bottomSafe = MediaQuery.of(context).padding.bottom;

    return ClipRRect(
      borderRadius: const BorderRadius.vertical(
        top: Radius.circular(ThemeRadius.r2xl),
      ),
      child: AnimatedContainer(
        duration: ThemeMotion.durSlow,
        curve: ThemeMotion.smooth,
        height: _currentHeight + bottomSafe,
        decoration: const BoxDecoration(
          color: ThemeColors.bgRaised,
          boxShadow: ThemeShadows.lg,
        ),
        child: GestureDetector(
          behavior: HitTestBehavior.translucent,
          onVerticalDragEnd: (details) {
            if (details.primaryVelocity == null) return;
            if (details.primaryVelocity! < -300) {
              _doExpand();
            } else if (details.primaryVelocity! > 300) {
              _doCollapse();
            }
            _notifyHeight();
          },
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              const _DragHandle(),
              if (_expanded)
                Expanded(child: _buildContent())
              else
                Flexible(child: _buildContent()),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildContent() {
    final guidance = widget.guidance;
    final route = widget.route;

    if (widget.isCalculating) {
      return const Center(
        child: Padding(
          padding: EdgeInsets.all(ThemeSpacing.sp5),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              SizedBox(
                width: 20,
                height: 20,
                child: CircularProgressIndicator(strokeWidth: 2),
              ),
              SizedBox(width: ThemeSpacing.sp3),
              Text('Calculating route...', style: ThemeText.callout),
            ],
          ),
        ),
      );
    }

    if (guidance.isActive && _showExpanded && route != null) {
      return _GuidanceExpanded(
        guidance: guidance,
        route: route,
        routeCheckpoints: widget.routeCheckpoints,
        onCancel: widget.onCancelRoute,
        onCheckpointTapped: widget.onRouteCheckpointTapped,
      );
    }

    if (guidance.isActive && route != null) {
      return _RouteWithProgress(
        duration: guidance.remainingEta,
        distance: guidance.remainingDistanceMeters,
        progress: _calcProgress(route, guidance),
        showChevron: true,
        onCancel: widget.onCancelRoute,
      );
    }

    if (_showExpanded && route != null) {
      return _RouteDetailView(
        route: route,
        routeCheckpoints: widget.routeCheckpoints,
        onCancel: widget.onCancelRoute,
        onCheckpointTapped: widget.onRouteCheckpointTapped,
      );
    }

    if (_showExpanded && widget.child != null) {
      return widget.child!;
    }

    if (route != null) {
      return _RouteWithProgress(
        duration: route.eta,
        distance: route.distanceMeters,
        onCancel: widget.onCancelRoute,
      );
    }

    return _PlanRoutePrompt(onTap: _doExpand);
  }
}

