class _RouteProgressBar extends StatelessWidget {
  final double progress;
  final String startLabel;
  final String endLabel;
  final bool showChevron;

  const _RouteProgressBar({
    required this.progress,
    required this.startLabel,
    required this.endLabel,
    this.showChevron = false,
  });

  @override
  Widget build(BuildContext context) {
    final clampedProgress = progress.clamp(0.0, 1.0);

    return Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        SizedBox(
          height: 22,
          child: LayoutBuilder(
            builder: (context, constraints) {
              final w = constraints.maxWidth;
              final padding = 14.0;
              final trackLeft = padding;
              final trackRight = padding;
              final trackW = w - trackLeft - trackRight;
              final fillW = trackW * clampedProgress;
              final chevronX = trackLeft + fillW - 10;

              return Stack(
                clipBehavior: Clip.none,
                children: [
                  Positioned(
                    left: trackLeft,
                    right: trackRight,
                    top: 9,
                    child: Container(
                      height: 4,
                      decoration: BoxDecoration(
                        color: ThemeColors.border,
                        borderRadius: ThemeRadius.brFull,
                      ),
                    ),
                  ),
                  if (fillW > 2)
                    Positioned(
                      left: trackLeft,
                      top: 9,
                      width: fillW,
                      child: Container(
                        height: 4,
                        decoration: BoxDecoration(
                          color: ThemeColors.accent,
                          borderRadius: ThemeRadius.brFull,
                        ),
                      ),
                    ),
                  if (showChevron && clampedProgress > 0.02)
                    Positioned(
                      left: chevronX,
                      top: 2,
                      child: Icon(
                        Icons.play_arrow,
                        size: 18,
                        color: ThemeColors.accent,
                      ),
                    ),
                  Positioned(
                    left: padding - 5,
                    top: 6,
                    child: Container(
                      width: 10,
                      height: 10,
                      decoration: const BoxDecoration(
                        color: ThemeColors.accent,
                        shape: BoxShape.circle,
                      ),
                    ),
                  ),
                  Positioned(
                    right: padding - 5,
                    top: 6,
                    child: Container(
                      width: 10,
                      height: 10,
                      decoration: BoxDecoration(
                        shape: BoxShape.circle,
                        border: Border.all(
                          color: ThemeColors.borderStrong,
                          width: 2,
                        ),
                      ),
                    ),
                  ),
                ],
              );
            },
          ),
        ),
        const SizedBox(height: 2),
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text(startLabel, style: ThemeText.footnote),
            Text(endLabel, style: ThemeText.footnote),
          ],
        ),
      ],
    );
  }
}

