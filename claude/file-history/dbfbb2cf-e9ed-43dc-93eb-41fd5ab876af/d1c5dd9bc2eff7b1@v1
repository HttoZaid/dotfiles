class _GuidanceExpanded extends StatelessWidget {
  final GuidanceState guidance;
  final CalculatedRoute route;
  final VoidCallback? onCancel;
  final Map<int, List<Checkpoint>> routeCheckpoints;
  final void Function(Checkpoint)? onCheckpointTapped;

  const _GuidanceExpanded({
    required this.guidance,
    required this.route,
    this.onCancel,
    this.routeCheckpoints = const {},
    this.onCheckpointTapped,
  });

  static const double _lookAheadThresholdMeters = 500;

  @override
  Widget build(BuildContext context) {
    final nextDist = guidance.nextManeuverDistance;
    final lookAheadAction = guidance.nextManeuverAction;
    final lookAheadText = guidance.nextManeuverText;
    final showLookAhead =
        lookAheadAction != null &&
        nextDist != null &&
        nextDist <= _lookAheadThresholdMeters;

    return ListView(
      padding: const EdgeInsets.symmetric(horizontal: ThemeSpacing.sp4),
      children: [
        const SizedBox(height: ThemeSpacing.sp2),

        _ManeuverCard(
          action: guidance.currentAction,
          text: guidance.currentManeuverText ?? 'Continue',
          subtitle: nextDist != null ? 'in ${_formatDistance(nextDist)}' : null,
          isCurrent: true,
        ),

        if (showLookAhead)
          Padding(
            padding: const EdgeInsets.only(top: ThemeSpacing.sp2),
            child: _ManeuverCard(
              action: lookAheadAction,
              text: lookAheadText!,
              subtitle: null,
              isCurrent: false,
            ),
          ),

        const SizedBox(height: ThemeSpacing.sp4),

        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text(
              _formatDuration(guidance.remainingEta),
              style: ThemeText.headline,
            ),
            Text(
              _formatDistance(guidance.remainingDistanceMeters),
              style: ThemeText.subheadline,
            ),
          ],
        ),

        const SizedBox(height: ThemeSpacing.sp2),
        _RouteProgressBar(
          progress: _calcProgress(route, guidance),
          startLabel: 'Start',
          endLabel: 'End',
          showChevron: true,
        ),

        if (onCancel != null) ...[
          const SizedBox(height: ThemeSpacing.sp4),
          Padding(
            padding: const EdgeInsets.only(bottom: ThemeSpacing.sp4),
            child: SizedBox(
              width: double.infinity,
              height: 44,
              child: OutlinedButton(
                onPressed: onCancel,
                style: OutlinedButton.styleFrom(
                  foregroundColor: ThemeColors.danger,
                  side: const BorderSide(color: ThemeColors.danger),
                  shape: RoundedRectangleBorder(
                    borderRadius: ThemeRadius.brMd,
                  ),
                ),
                child: const Text('End navigation'),
              ),
            ),
          ),
        ],
      ],
    );
  }
}

