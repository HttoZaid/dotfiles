}

class _CheckpointChip extends StatelessWidget {
  final Checkpoint checkpoint;
  final VoidCallback? onTap;

  const _CheckpointChip({required this.checkpoint, this.onTap});

  Color _statusColor(ContributionStatusEnum? status) {
    return switch (status) {
      ContributionStatusEnum.ACTIVE => ThemeColors.danger,
      ContributionStatusEnum.INACTIVE => const Color(0xFF34C759),
      ContributionStatusEnum.POLICE_ALERT => const Color(0xFFFF9500),
      _ => ThemeColors.stone400,
    };
  }

  @override
  Widget build(BuildContext context) {
    final status = checkpoint.contributions.isNotEmpty
        ? checkpoint.contributions.first.status
        : null;
    final lastContribution = checkpoint.contributions.firstOrNull;
    final lastUpdate = lastContribution?.createdAt ?? checkpoint.createdAt;
    final timeStr = DateFormat('HH:mm').format(lastUpdate.toLocal());

    return Padding(
      padding: const EdgeInsets.only(bottom: ThemeSpacing.sp1),
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          onTap: onTap,
          borderRadius: ThemeRadius.brSm,
          child: Container(
            padding: const EdgeInsets.symmetric(
              horizontal: ThemeSpacing.sp3,
              vertical: ThemeSpacing.sp2,
            ),
            constraints: const BoxConstraints(minHeight: 44),
            decoration: BoxDecoration(
              color: ThemeColors.bgSubtle,
              borderRadius: ThemeRadius.brSm,
            ),
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                Container(
                  width: 8,
                  height: 8,
                  decoration: BoxDecoration(
                    color: _statusColor(status),
                    shape: BoxShape.circle,
                  ),
                ),
                const SizedBox(width: ThemeSpacing.sp2),
                Flexible(
                  child: Text(
                    checkpoint.name,
                    style: const TextStyle(
                      fontSize: 13,
                      fontWeight: FontWeight.w500,
                      color: ThemeColors.textPrimary,
                    ),
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                  ),
                ),
                const SizedBox(width: ThemeSpacing.sp2),
                Text(
                  timeStr,
                  style: const TextStyle(
                    fontSize: 11,
                    fontWeight: FontWeight.w500,
                    color: ThemeColors.textTertiary,
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}
