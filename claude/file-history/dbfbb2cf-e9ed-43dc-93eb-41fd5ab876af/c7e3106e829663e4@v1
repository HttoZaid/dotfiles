import 'package:flutter/material.dart';
import 'package:flutter_native_splash/flutter_native_splash.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:here_sdk/core.dart';
import 'package:here_sdk/core.engine.dart';
import 'package:here_sdk/core.errors.dart';
import 'package:sentry_flutter/sentry_flutter.dart';
import 'package:ukcheckpoints_app/core/api/deep_link_provider.dart';
import 'package:ukcheckpoints_app/core/providers/location_provider.dart';
import 'package:ukcheckpoints_app/core/router/router.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/auth/providers/auth_controller.dart';

Future<void> main() async {
  final widgetsBinding = SentryWidgetsFlutterBinding.ensureInitialized();
  FlutterNativeSplash.preserve(widgetsBinding: widgetsBinding);

  SdkContext.init(IsolateOrigin.main);

  const accessKeyId = String.fromEnvironment(
    'HERESDK_ACCESS_KEY_ID',
    defaultValue: 'YOUR_KEY_ID',
  );
  const accessKeySecret = String.fromEnvironment(
    'HERESDK_ACCESS_KEY_SECRET',
    defaultValue: 'YOUR_SECRET',
  );

  if (accessKeyId.isEmpty || accessKeySecret.isEmpty) {
    throw Exception(
      "HERE SDK credentials are missing. Check your --dart-define-from-file setup.",
    );
  }

  final sdkOptions = SDKOptions.withAuthenticationMode(
    AuthenticationMode.withKeySecret(accessKeyId, accessKeySecret),
  );

  try {
    await SDKNativeEngine.makeSharedInstance(sdkOptions);
  } on InstantiationException {
    throw Exception('Failed to initialize HERE SDK.');
  }

  await SentryFlutter.init(
    (options) {
      options.dsn =
          'https://0d481c7048c44c2881f90115f0f802ad@telemetry.ukcheckpoints.info/4';
      options.tracesSampleRate = 1.0;
      options.reportPackages = false;
      options.attachScreenshot = false;
    },
    appRunner:
        () => runApp(
          ProviderScope(
            child: DefaultAssetBundle(
              bundle: SentryAssetBundle(),
              child: const UKCheckpointsApp(),
            ),
          ),
        ),
  );
}

class UKCheckpointsApp extends ConsumerStatefulWidget {
  const UKCheckpointsApp({super.key});

  @override
  ConsumerState<UKCheckpointsApp> createState() => _UKCheckpointsAppState();
}

class _UKCheckpointsAppState extends ConsumerState<UKCheckpointsApp> {
  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      ref.read(locationControllerProvider.notifier).checkStatus();
    });
  }

  @override
  Widget build(BuildContext context) {
    final router = ref.watch(routerProvider);

    ref.listen<AsyncValue<Uri>>(deepLinkProvider, (previous, next) {
      final uri = next.value;
      if (uri != null) {
        router.push(uri.path + (uri.hasQuery ? '?${uri.query}' : ''));
      }
    });

    ref.listen(authControllerProvider, (previous, next) {
      if (!next.isLoading) {
        FlutterNativeSplash.remove();
      }
    });

    return MaterialApp.router(
      debugShowCheckedModeBanner: false,
      title: "UKcheckpoints",
      theme: AppTheme.light,
      routerConfig: router,
    );
  }
}
