class MapScreen extends ConsumerStatefulWidget {
  const MapScreen({super.key});

  @override
  ConsumerState<MapScreen> createState() => _MapScreenState();
}

class _MapScreenState extends ConsumerState<MapScreen> {
  MapImage? _activeIcon;
  MapImage? _inactiveIcon;
  MapImage? _policeIcon;
  MapImage? _unknownIcon;

  List<Checkpoint>? _pendingCheckpoints;

  double _sheetHeight = 120;

  final _navSheetKey = GlobalKey<NavigationSheetState>();

  @override
  void initState() {
    super.initState();
    unawaited(_loadIcons());
  }

  Future<void> _loadIcons() async {
    _activeIcon = await _loadImage('assets/images/marker_active.png');
    _inactiveIcon = await _loadImage('assets/images/marker_inactive.png');
    _policeIcon = await _loadImage('assets/images/marker_police.png');
    _unknownIcon = await _loadImage('assets/images/marker_unknown.png');
    if (!mounted) return;

    setState(() {});

    final checkpoints =
        _pendingCheckpoints ??
        ref.read(checkpointNotifierProvider).value?.checkpoints ??
        [];
    if (checkpoints.isNotEmpty) {
      _updateMapCheckpoints(checkpoints);
      _pendingCheckpoints = null;
    }
  }

  void _updateMapCheckpoints(List<Checkpoint> checkpoints) {
    final active = _activeIcon;
    final inactive = _inactiveIcon;
    final police = _policeIcon;
    final unknown = _unknownIcon;

    if (active == null ||
        inactive == null ||
        police == null ||
        unknown == null) {
      _pendingCheckpoints = checkpoints;
      return;
    }

    ref.read(mapControllerProvider.notifier).updateCheckpoints(checkpoints, {
      ContributionStatusEnum.ACTIVE: active,
      ContributionStatusEnum.INACTIVE: inactive,
      ContributionStatusEnum.POLICE_ALERT: police,
      ContributionStatusEnum.UNKNOWN: unknown,
    });
  }

  Future<MapImage> _loadImage(String asset) async {
    final bytes = await rootBundle.load(asset);
    return MapImage.withPixelDataAndImageFormat(
      bytes.buffer.asUint8List(),
      ImageFormat.png,
    );
  }

  Future<void> _onExpandRequested() async {
    final service = ref.read(vehicleProfileRepositoryProvider);
    final count = await service.count();
    if (!mounted) return;

    if (count == 0) {
      _openProfileCreateSheet();
    } else {
      _openProfileSelectSheet();
    }
  }

  void _openProfileCreateSheet() {
    final service = ref.read(vehicleProfileRepositoryProvider);
    unawaited(
      showModalBottomSheet<void>(
        context: context,
        isScrollControlled: true,
        useSafeArea: true,
        builder:
            (_) => VehicleProfileSheet(
              service: service,
              onProfileCreated: () {
                _navSheetKey.currentState?.expand();
              },
            ),
      ),
    );
  }

  void _openProfileSelectSheet() {
    final service = ref.read(vehicleProfileRepositoryProvider);
    unawaited(
      showModalBottomSheet<void>(
        context: context,
        isScrollControlled: true,
        useSafeArea: true,
        builder:
            (_) => VehicleProfileSelectSheet(
              service: service,
              onProfileReady: () {
                _navSheetKey.currentState?.expand();
              },
            ),
      ),
    );
  }

  void _onMapCreated(HereMapController hereMapController) {
    final controllerNotifier = ref.read(mapControllerProvider.notifier);
    controllerNotifier.setController(
      hereMapController,
      _onCheckpointTapped,
    );

    hereMapController.camera.addListener(
      MapCameraListener((cameraState) {
        ref.read(mapBearingProvider.notifier).state =
            cameraState.orientationAtTarget.bearing;
      }),
    );

    ref
        .read(navigationGuidanceProvider.notifier)
        .startRendering(
          hereMapController,
        );
  }

  void _onCheckpointTapped(String checkpointId) {
    final checkpoints =
        ref.read(checkpointNotifierProvider).value?.checkpoints ?? [];
    final checkpoint =
        checkpoints.where((c) => c.id == checkpointId).firstOrNull;
    if (checkpoint != null && context.mounted) {
      unawaited(
        showModalBottomSheet<void>(
          context: context,
          isScrollControlled: true,
          backgroundColor: Colors.transparent,
          builder: (context) => CheckpointActionSheet(checkpoint: checkpoint),
        ),
      );
    }
  }

  void _onStartNavigation(VehicleProfileModel profile) {
    final nav = ref.read(navigationRouteProvider);
    if (nav.origin == null || nav.destination == null) return;

    ref
        .read(routeCalculationProvider.notifier)
        .calculate(
          origin: nav.origin!,
          destination: nav.destination!,
          profile: profile,
        );
  }

  void _onCancelRoute() {
    ref.read(routeCalculationProvider.notifier).reset();
    ref.read(mapControllerProvider.notifier).clearRoute();
    ref.read(navigationGuidanceProvider.notifier).stopGuidance();
  }

  Map<ContributionStatusEnum, MapImage>? _getIconMap() {
    final active = _activeIcon;
    final inactive = _inactiveIcon;
    final police = _policeIcon;
    final unknown = _unknownIcon;
    if (active == null || inactive == null || police == null || unknown == null)
      return null;
    return {
      ContributionStatusEnum.ACTIVE: active,
      ContributionStatusEnum.INACTIVE: inactive,
      ContributionStatusEnum.POLICE_ALERT: police,
      ContributionStatusEnum.UNKNOWN: unknown,
    };
  }

  void _renderAllCheckpoints(WidgetRef ref) {
    final checkpoints =
        ref.read(checkpointNotifierProvider).value?.checkpoints ?? [];
    _updateMapCheckpoints(checkpoints);
  }

  void _onRouteCheckpointTapped(Checkpoint checkpoint) {
    ref.read(mapControllerProvider.notifier).focusOnCheckpoint(checkpoint);
    _navSheetKey.currentState?.collapse();
  }

  @override
  Widget build(BuildContext context) {
    ref.listen(userLocationStreamProvider, (previous, next) {
      final position = next.value;
      if (position != null) {
        ref
            .read(mapControllerProvider.notifier)
            .updateLocation(
              GeoCoordinates(position.latitude, position.longitude),
            );
      }
    });

    ref.listen(checkpointNotifierProvider, (previous, next) {
      next.whenData((data) {
        _updateMapCheckpoints(data.checkpoints);
      });
    });

    final locationAsync = ref.watch(userLocationStreamProvider);
    final userPos = locationAsync.value;
    final userCoords =
        userPos != null
            ? GeoCoordinates(userPos.latitude, userPos.longitude)
            : null;

    final routeState = ref.watch(routeCalculationProvider);
    final route = routeState.valueOrNull;
    final isCalculating = routeState is AsyncLoading;
    final guidance = ref.watch(navigationGuidanceProvider);

    ref.watch(nearbyCheckpointProvider);

    ref.listen(routeCalculationProvider, (prev, next) {
      next.whenData((r) {
        if (r != null) {
          ref.read(mapControllerProvider.notifier).clearRoute();
          ref.read(mapControllerProvider.notifier).drawRoute(r.route.geometry);
          _navSheetKey.currentState?.collapse();
          final origin = ref.read(navigationRouteProvider).origin;
          if (origin != null) {
            ref.read(mapControllerProvider.notifier).focusOnCoordinates(origin);
          }
          ref
              .read(navigationGuidanceProvider.notifier)
              .startGuidance(
                route: r.route,
                locationStream: Geolocator.getPositionStream(
                  locationSettings: const LocationSettings(
                    accuracy: LocationAccuracy.bestForNavigation,
                    distanceFilter: 1,
                  ),
                ),
              );
        } else {
          ref.read(mapControllerProvider.notifier).clearRoute();
          ref.read(navigationGuidanceProvider.notifier).stopGuidance();
          _renderAllCheckpoints(ref);
        }
      });
    });

    final routeCheckpoints = ref.watch(routeCheckpointsProvider);

    ref.listen(routeCheckpointsProvider, (prev, next) {
      final icons = _getIconMap();
      if (icons != null && next.isNotEmpty) {
        ref
            .read(mapControllerProvider.notifier)
            .showRouteCheckpoints(
              routeCheckpoints: next,
              icons: icons,
            );
      }
    });

    final hasRoute = route != null;

    return Scaffold(
      appBar: const PreferredSize(
        preferredSize: Size.fromHeight(120),

        child: SafeArea(
          bottom: false,
          child: ManeuverBanner(),
        ),
      ),
      body: Stack(
        children: [
          GestureDetector(
            behavior: HitTestBehavior.translucent,
            onTap: () => FocusScope.of(context).unfocus(),
            child: HereMap(onMapCreated: _onMapCreated),
          ),

          Positioned(
            top: 0,
            left: 0,
            right: 0,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                if (!guidance.isActive)
                  MapSearchBar(
                    onCheckpointSelected: (checkpoint) {
                      ref
                          .read(mapControllerProvider.notifier)
                          .focusOnCheckpoint(checkpoint);
                    },
                  ),
              ],
            ),
          ),

          Positioned(
            bottom: _sheetHeight + 8,
            left: 0,
            right: 0,
            child: const NearbyCheckpointPopup(),
          ),

          Positioned(
            bottom: _sheetHeight + 16,
            left: 16,
            child: const MapSpeedOverlay(),
          ),

          Positioned(
            bottom: _sheetHeight + 16,
            right: 16,
            child: const MapOverlayButtons(),
          ),

          Positioned(
            bottom: 0,
            left: 0,
            right: 0,
            child: NavigationSheet(
              key: _navSheetKey,
              maxHeight: MediaQuery.of(context).size.height,
              onHeightChanged: (height) {
                setState(() => _sheetHeight = height);
              },
              onExpandRequested: _onExpandRequested,
              route: route,
              isCalculating: isCalculating,
              onCancelRoute: _onCancelRoute,
              routeCheckpoints: routeCheckpoints,
              onRouteCheckpointTapped: _onRouteCheckpointTapped,
              guidance: guidance,
              child: NavigationInputBar(
                userLocation: userCoords,
                onNavigate: _onStartNavigation,
              ),
            ),
          ),
        ],
      ),
    );
  }
}
