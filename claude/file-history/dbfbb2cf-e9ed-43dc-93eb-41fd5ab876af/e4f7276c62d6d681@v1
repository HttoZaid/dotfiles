import 'dart:async';

import 'dart:ui' show Color;

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:here_sdk/core.dart';
import 'package:here_sdk/gestures.dart';
import 'package:here_sdk/mapview.dart';
import 'package:riverpod_annotation/riverpod_annotation.dart';
import 'package:ukcheckpoints_api/ukcheckpoints_api.dart';

import 'package:ukcheckpoints_app/core/utils/logger.dart';
import 'package:ukcheckpoints_app/features/map/data/map_preferences_repository.dart';

part 'map_controller.g.dart';

final mapBearingProvider = StateProvider<double>((ref) => 0.0);

final currentMapSchemeProvider = StateProvider<MapScheme>(
  (ref) => MapScheme.normalDay,
);

final isTrafficEnabledProvider = StateProvider<bool>((ref) => false);

final isPublicTransitEnabledProvider = StateProvider<bool>((ref) => false);

@Riverpod(keepAlive: true)
class MapController extends _$MapController {
  LocationIndicator? _locationIndicator;
  GeoCoordinates? _lastLocation;
  final List<MapMarker> _markers = [];

  @override
  HereMapController? build() {
    ref.onDispose(() {
      _locationIndicator = null;
      _markers.clear();
    });
    return null;
  }

  void setController(
    HereMapController controller,
    void Function(String) onCheckpointTap,
  ) {
    state = controller;
    _setupLocationIndicator(controller);
    _setupGestureListeners(controller, onCheckpointTap);
    unawaited(_loadAndApplyPreferences());
  }

  Future<void> _loadAndApplyPreferences() async {
    final prefs = ref.read(mapPreferencesRepositoryProvider);
    final schemeName = await prefs.getMapScheme();
    final trafficOn = await prefs.isTrafficEnabled();
    final transitOn = await prefs.isPublicTransitEnabled();

    final scheme = MapScheme.values.firstWhere(
      (s) => s.name == schemeName,
      orElse: () => MapScheme.normalDay,
    );

    ref.read(isTrafficEnabledProvider.notifier).state = trafficOn;
    ref.read(isPublicTransitEnabledProvider.notifier).state = transitOn;

    if (state != null) {
      setMapScheme(scheme, refocus: true);
    }
  }

  void _setupGestureListeners(
    HereMapController controller,
    void Function(String) onCheckpointTap,
  ) {
    controller.gestures.tapListener = TapListener((Point2D point) {
      final current = state;
      if (current == null) return;

      current.pick(
        MapSceneMapPickFilter([MapSceneMapPickFilterContentType.mapItems]),
        Rectangle2D(point, Size2D(40, 40)),
        (MapPickResult? result) {
          final marker = result?.mapItems?.markers.firstOrNull;
          if (marker == null) return;
          final id = marker.metadata?.getString('checkpointId');
          if (id != null) {
            onCheckpointTap(id);
          }
        },
      );
    });
  }

  void _setupLocationIndicator(HereMapController controller) {
    _locationIndicator = LocationIndicator.withMapView(controller);
    _locationIndicator?.locationIndicatorStyle =
        LocationIndicatorIndicatorStyle.pedestrian;
    _locationIndicator?.enable(controller);
  }

  void updateLocation(GeoCoordinates coordinates) {
    final isFirstLocation = _lastLocation == null;
    _lastLocation = coordinates;
    _locationIndicator?.updateLocation(
      Location.withCoordinates(coordinates),
    );

    if (isFirstLocation) {
      focusOnUserLocation();
    }
  }

  void focusOnUserLocation() {
    _animateTo(_lastLocation);
  }

  void focusOnCoordinates(GeoCoordinates coords) {
    _animateTo(coords);
  }

  void _animateTo(GeoCoordinates? coords) {
    if (coords == null || state == null) return;
    final animation = MapCameraAnimationFactory.flyToWithZoom(
      GeoCoordinatesUpdate(coords.latitude, coords.longitude),
      MapMeasure(MapMeasureKind.distanceInMeters, 1000),
      0.0,
      const Duration(milliseconds: 800),
    );
    state!.camera.startAnimation(animation);
  }

  void resetOrientationToNorth() {
    final controller = state;
    if (controller == null) return;

    final cameraState = controller.camera.state;
    final animation = MapCameraAnimationFactory.flyToWithOrientationAndZoom(
      GeoCoordinatesUpdate(
        cameraState.targetCoordinates.latitude,
        cameraState.targetCoordinates.longitude,
      ),
      GeoOrientationUpdate(0.0, cameraState.orientationAtTarget.tilt),
      MapMeasure(
        MapMeasureKind.distanceInMeters,
        cameraState.distanceToTargetInMeters,
      ),
      0.0,
      const Duration(milliseconds: 600),
    );
    controller.camera.startAnimation(animation);

    ref.read(mapBearingProvider.notifier).state = 0.0;
  }

  void updateCheckpoints(
    List<Checkpoint> checkpoints,
    Map<ContributionStatusEnum, MapImage> icons,
  ) {
    final controller = state;
    if (controller == null) return;

    for (final marker in _markers) {
      controller.mapScene.removeMapMarker(marker);
    }
    _markers.clear();

    for (final checkpoint in checkpoints) {
      final status =
          checkpoint.contributions.isNotEmpty
              ? checkpoint.contributions.first.status
              : ContributionStatusEnum.UNKNOWN;

      final icon = icons[status] ?? icons[ContributionStatusEnum.UNKNOWN]!;

      final marker = MapMarker(
        GeoCoordinates(
          checkpoint.latitude.toDouble(),
          checkpoint.longitude.toDouble(),
        ),
        icon,
      );

      marker.metadata = Metadata();
      marker.metadata!.setString('checkpointId', checkpoint.id);

      controller.mapScene.addMapMarker(marker);
      _markers.add(marker);
    }
  }

  void setMapScheme(MapScheme scheme, {bool refocus = false}) {
    ref.read(currentMapSchemeProvider.notifier).state = scheme;

    unawaited(
      ref.read(mapPreferencesRepositoryProvider).setMapScheme(scheme.name),
    );

    final coordinates = refocus ? _lastLocation : null;

    final options = MapSceneLoadOptionsBuilder().withMapScheme(scheme).build();
    state?.mapScene.loadScene(options, (MapError? error) {
      if (error != null) {
        AppLogger.error(
          'Map scene load failed',
          error: error,
          stackTrace: StackTrace.current,
        );
        return;
      }
      _reapplyFeatures();
      if (coordinates != null) {
        _animateTo(coordinates);
      }
    });
  }

  void _reapplyFeatures() {
    final controller = state;
    if (controller == null) return;

    final scheme = ref.read(currentMapSchemeProvider);
    final trafficOn = ref.read(isTrafficEnabledProvider);
    final transitOn = ref.read(isPublicTransitEnabledProvider);

    if (scheme == MapScheme.satellite) return;

    if (trafficOn) {
      controller.mapScene.enableFeatures({
        MapFeatures.trafficFlow: MapFeatureModes.trafficFlowWithFreeFlow,
        MapFeatures.trafficIncidents: MapFeatureModes.trafficIncidentsAll,
      });
    }
    if (transitOn) {
      controller.mapScene.enableFeatures({
        MapFeatures.publicTransit: MapFeatureModes.publicTransitAll,
      });
    }
  }

  void toggleTrafficFlow() {
    final newValue = !ref.read(isTrafficEnabledProvider);
    ref.read(isTrafficEnabledProvider.notifier).state = newValue;

    unawaited(
      ref.read(mapPreferencesRepositoryProvider).setTrafficEnabled(newValue),
    );

    final controller = state;
    if (controller == null) return;

    if (ref.read(currentMapSchemeProvider) == MapScheme.satellite) return;

    if (newValue) {
      controller.mapScene.enableFeatures({
        MapFeatures.trafficFlow: MapFeatureModes.trafficFlowWithFreeFlow,
        MapFeatures.trafficIncidents: MapFeatureModes.trafficIncidentsAll,
      });
    } else {
      controller.mapScene.disableFeatures([
        MapFeatures.trafficFlow,
        MapFeatures.trafficIncidents,
      ]);
    }
  }

  void togglePublicTransit() {
    final newValue = !ref.read(isPublicTransitEnabledProvider);
    ref.read(isPublicTransitEnabledProvider.notifier).state = newValue;

    unawaited(
      ref
          .read(mapPreferencesRepositoryProvider)
          .setPublicTransitEnabled(newValue),
    );

    final controller = state;
    if (controller == null) return;

    if (ref.read(currentMapSchemeProvider) == MapScheme.satellite) return;

    if (newValue) {
      controller.mapScene.enableFeatures({
        MapFeatures.publicTransit: MapFeatureModes.publicTransitAll,
      });
    } else {
      controller.mapScene.disableFeatures([
        MapFeatures.publicTransit,
      ]);
    }
  }

  void focusOnCheckpoint(Checkpoint checkpoint) {
    final controller = state;
    if (controller == null) return;

    final animation = MapCameraAnimationFactory.flyToWithZoom(
      GeoCoordinatesUpdate(
        checkpoint.latitude.toDouble(),
        checkpoint.longitude.toDouble(),
      ),
      MapMeasure(MapMeasureKind.distanceInMeters, 500),
      0.0,
      const Duration(milliseconds: 800),
    );
    controller.camera.startAnimation(animation);
  }

  MapPolyline? _routePolyline;

  void drawRoute(GeoPolyline polyline) {
    final controller = state;
    if (controller == null) return;

    clearRoute();

    final lineWidth = MapMeasureDependentRenderSize.withSingleSize(
      RenderSizeUnit.pixels,
      6.0,
    );
    final representation = MapPolylineSolidRepresentation(
      lineWidth,
      const Color(0xFF2563EB),
      LineCap.round,
    );
    final mapPolyline =
        MapPolyline.withRepresentation(polyline, representation);

    controller.mapScene.addMapPolyline(mapPolyline);
    _routePolyline = mapPolyline;
  }

  void clearRoute() {
    final controller = state;
    final polyline = _routePolyline;
    if (controller == null || polyline == null) return;
    controller.mapScene.removeMapPolylines([polyline]);
    _routePolyline = null;
  }

  void showRouteCheckpoints({
    required Map<int, List<Checkpoint>> routeCheckpoints,
    required Map<ContributionStatusEnum, MapImage> icons,
  }) {
    final controller = state;
    if (controller == null) return;

    for (final marker in _markers) {
      controller.mapScene.removeMapMarker(marker);
    }
    _markers.clear();

    for (final entry in routeCheckpoints.entries) {
      for (final checkpoint in entry.value) {
        final status =
            checkpoint.contributions.isNotEmpty
                ? checkpoint.contributions.first.status
                : ContributionStatusEnum.UNKNOWN;

        final icon = icons[status] ?? icons[ContributionStatusEnum.UNKNOWN]!;

        final marker = MapMarker(
          GeoCoordinates(
            checkpoint.latitude.toDouble(),
            checkpoint.longitude.toDouble(),
          ),
          icon,
        );

        marker.metadata = Metadata();
        marker.metadata!.setString('checkpointId', checkpoint.id);

        controller.mapScene.addMapMarker(marker);
        _markers.add(marker);
      }
    }
  }
}
