// ─── Helpers ─────────────────────────────────────────────────────────────────

String _formatDuration(Duration d) {
  final h = d.inHours;
  final m = d.inMinutes.remainder(60);
  return h > 0 ? '$h h $m min' : '$m min';
}

String _formatDistance(int meters) {
  if (meters >= 1609) return '${(meters / 1609.34).toStringAsFixed(1)} mi';
  return '${(meters * 3.28084).round()} ft';
}

double _calcProgress(CalculatedRoute route, GuidanceState guidance) {
  final total = route.distanceMeters;
  if (total <= 0) return 0;
  return (1.0 - guidance.remainingDistanceMeters / total).clamp(0.0, 1.0);
}

// ─── NavigationSheet ─────────────────────────────────────────────────────────

/// A three-snap bottom sheet: peek → half (50%) → full (100%).
///
/// Call expand() to snap to half; collapse() to snap to peek.
/// Drag the handle to resize; fling to jump one level.
class NavigationSheet extends StatefulWidget {
  final double maxHeight;
  final ValueChanged<double>? onHeightChanged;
  final Future<void> Function()? onExpandRequested;
  final Widget? child;
  final CalculatedRoute? route;
  final bool isCalculating;
  final VoidCallback? onCancelRoute;
  final Map<int, List<Checkpoint>> routeCheckpoints;
  final void Function(Checkpoint)? onRouteCheckpointTapped;
  final GuidanceState guidance;

  const NavigationSheet({
    required this.maxHeight,
    this.onHeightChanged,
    this.onExpandRequested,
    this.child,
    this.route,
    this.isCalculating = false,
    this.onCancelRoute,
    this.routeCheckpoints = const {},
    this.onRouteCheckpointTapped,
    this.guidance = const GuidanceState(),
    super.key,
  });

  @override
  State<NavigationSheet> createState() => NavigationSheetState();
}

class NavigationSheetState extends State<NavigationSheet>
    with SingleTickerProviderStateMixin {

  static const int _peek = 0;
  static const int _half = 1;
  static const int _full = 2;

  late AnimationController _snapAnim;
  int _snapIndex = _peek;
  double _currentH = 0;
  double _startH = 0;
  double _endH = 0;

  // Peek height adapts to the current navigation state.
  double get _peekH {
    if (widget.guidance.isActive) return 108;
    if (widget.route != null) return 92;
    return 84;
  }

  double get _halfH => widget.maxHeight * 0.5;
  double get _fullH => widget.maxHeight;

  double _heightFor(int snap) => switch (snap) {
    _peek => _peekH,
    _half => _halfH,
    _full => _fullH,
    _ => _peekH,
  };

  @override
  void initState() {
    super.initState();
    _currentH = _peekH;
    _startH = _peekH;
    _endH = _peekH;

    _snapAnim = AnimationController(
      vsync: this,
      duration: ThemeMotion.durBase,
    )..addListener(_onAnimTick);

    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (mounted) widget.onHeightChanged?.call(_peekH);
    });
  }

  void _onAnimTick() {
    final t = ThemeMotion.smooth.transform(_snapAnim.value);
    final h = _startH + (_endH - _startH) * t;
    setState(() => _currentH = h);
    widget.onHeightChanged?.call(h);
  }

  @override
  void didUpdateWidget(NavigationSheet oldWidget) {
    super.didUpdateWidget(oldWidget);
    // If at peek and the peek target height changed (e.g. guidance started),
    // animate to the new peek height so the sheet resizes smoothly.
    if (_snapIndex == _peek && (_endH - _peekH).abs() > 2) {
      _animateTo(_peek);
    }
  }

  @override
  void dispose() {
    _snapAnim.dispose();
    super.dispose();
  }

  void _animateTo(int snap) {
    _snapAnim.stop();
    _startH = _currentH;
    _endH = _heightFor(snap);
    _snapIndex = snap;
    _snapAnim.reset();
    unawaited(_snapAnim.forward());
  }

  /// Snaps the sheet to the half position.
  void expand() => _animateTo(_half);

  /// Snaps the sheet to the peek position.
  void collapse() => _animateTo(_peek);

  void _onHandleTap() {
    _animateTo(_snapIndex == _peek ? _half : _peek);
  }

  void _onDragUpdate(DragUpdateDetails d) {
    _snapAnim.stop();
    final newH = (_currentH - d.delta.dy).clamp(_peekH, _fullH);
    setState(() => _currentH = newH);
    widget.onHeightChanged?.call(newH);
  }

  void _onDragEnd(DragEndDetails d) {
    final vel = -(d.primaryVelocity ?? 0); // positive = upward fling
    int target;
    if (vel > 400) {
      target = math.min(_snapIndex + 1, _full);
    } else if (vel < -400) {
      target = math.max(_snapIndex - 1, _peek);
    } else {
      final heights = [_peekH, _halfH, _fullH];
      var minDist = double.infinity;
      target = 0;
      for (var i = 0; i < heights.length; i++) {
        final dist = (_currentH - heights[i]).abs();
        if (dist < minDist) {
          minDist = dist;
          target = i;
        }
      }
    }
    _animateTo(target);
  }

  @override
  Widget build(BuildContext context) {
    final bottomSafe = MediaQuery.of(context).padding.bottom;

    return ClipRRect(
      borderRadius: const BorderRadius.vertical(
        top: Radius.circular(ThemeRadius.r2xl),
      ),
      child: Container(
        height: _currentH + bottomSafe,
        decoration: const BoxDecoration(
          color: ThemeColors.bgRaised,
          boxShadow: ThemeShadows.lg,
        ),
        child: Column(
          children: [
            _DragHandle(
              onTap: _onHandleTap,
              onDragUpdate: _onDragUpdate,
              onDragEnd: _onDragEnd,
            ),
            Expanded(child: _buildContent()),
          ],
        ),
      ),
    );
  }

  Widget _buildContent() {
    if (widget.isCalculating) return const _CalculatingView();

    final guidance = widget.guidance;
    final route = widget.route;

    if (_snapIndex == _peek) {
      return _PeekContent(
        guidance: guidance,
        route: route,
        onTap: () => _animateTo(_half),
      );
    }

    if (guidance.isActive && route != null) {
      return _snapIndex == _full
          ? _GuidanceFullContent(
              guidance: guidance,
              route: route,
              routeCheckpoints: widget.routeCheckpoints,
              onCancel: widget.onCancelRoute,
              onCheckpointTapped: widget.onRouteCheckpointTapped,
            )
          : _GuidanceHalfContent(
              guidance: guidance,
              route: route,
              onCancel: widget.onCancelRoute,
              onExpand: () => _animateTo(_full),
            );
    }

    if (route != null) {
      return _snapIndex == _full
          ? _RouteFullContent(
              route: route,
              routeCheckpoints: widget.routeCheckpoints,
              onCancel: widget.onCancelRoute,
              onCheckpointTapped: widget.onRouteCheckpointTapped,
              onStartNavigation: widget.onExpandRequested,
            )
          : _RouteHalfContent(
              route: route,
              onCancel: widget.onCancelRoute,
              onExpand: () => _animateTo(_full),
              onStartNavigation: widget.onExpandRequested,
            );
    }

    // Idle: pass through the NavigationInputBar child.
    return _IdleContent(child: widget.child);
  }
}

