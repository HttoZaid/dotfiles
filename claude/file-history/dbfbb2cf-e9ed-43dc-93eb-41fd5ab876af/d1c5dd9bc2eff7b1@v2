// ─── Guidance (active navigation) ────────────────────────────────────────────

class _GuidanceHalfContent extends StatelessWidget {
  final GuidanceState guidance;
  final CalculatedRoute route;
  final VoidCallback? onCancel;
  final VoidCallback onExpand;

  const _GuidanceHalfContent({
    required this.guidance,
    required this.route,
    required this.onExpand,
    this.onCancel,
  });

  static const double _lookAheadThresholdMeters = 500;

  @override
  Widget build(BuildContext context) {
    final nextDist = guidance.nextManeuverDistance;
    final showLookAhead = guidance.nextManeuverAction != null &&
        nextDist != null &&
        nextDist <= _lookAheadThresholdMeters;

    return Padding(
      padding: const EdgeInsets.fromLTRB(
        ThemeSpacing.sp4,
        ThemeSpacing.sp2,
        ThemeSpacing.sp4,
        ThemeSpacing.sp4,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          _ManeuverCard(
            action: guidance.currentAction,
            text: guidance.currentManeuverText ?? 'Continue',
            subtitle: nextDist != null
                ? 'in ${_formatDistance(nextDist)}'
                : null,
            isCurrent: true,
          ),
          if (showLookAhead) ...[
            const SizedBox(height: ThemeSpacing.sp2),
            _ManeuverCard(
              action: guidance.nextManeuverAction,
              text: guidance.nextManeuverText ?? '',
              isCurrent: false,
            ),
          ],
          const SizedBox(height: ThemeSpacing.sp3),
          Row(
            children: [
              Text(
                _formatDuration(guidance.remainingEta),
                style: ThemeText.headline,
              ),
              const SizedBox(width: ThemeSpacing.sp3),
              Expanded(
                child: Text(
                  _formatDistance(guidance.remainingDistanceMeters),
                  style: ThemeText.subheadline,
                ),
              ),
              TextButton(
                onPressed: onExpand,
                style: TextButton.styleFrom(
                  foregroundColor: ThemeColors.accent,
                  padding: EdgeInsets.zero,
                  textStyle: ThemeText.footnote,
                ),
                child: const Text('All steps'),
              ),
            ],
          ),
          const SizedBox(height: ThemeSpacing.sp1),
          _RouteProgressBar(
            progress: _calcProgress(route, guidance),
            startLabel: 'Start',
            endLabel: 'End',
            showChevron: true,
          ),
          const Spacer(),
          if (onCancel != null)
            SizedBox(
              height: 44,
              child: OutlinedButton(
                onPressed: onCancel,
                style: OutlinedButton.styleFrom(
                  foregroundColor: ThemeColors.danger,
                  side: const BorderSide(color: ThemeColors.danger),
                  shape: RoundedRectangleBorder(
                    borderRadius: ThemeRadius.brMd,
                  ),
                ),
                child: const Text('End navigation'),
              ),
            ),
        ],
      ),
    );
  }
}

