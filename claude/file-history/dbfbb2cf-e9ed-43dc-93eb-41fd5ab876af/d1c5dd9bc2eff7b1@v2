              const SizedBox(height: ThemeSpacing.sp2),
            ],
          ),
        ),
        const Divider(height: 1),
        Expanded(
          child: ListView.builder(
            padding: const EdgeInsets.symmetric(vertical: ThemeSpacing.sp2),
            itemCount: route.maneuvers.length,
            itemBuilder: (context, index) => _ManeuverRow(
              maneuver: route.maneuvers[index],
              isFirst: index == 0,
              isLast: index == route.maneuvers.length - 1,
              checkpoints: routeCheckpoints[index] ?? [],
              onCheckpointTapped: onCheckpointTapped,
            ),
          ),
        ),
        if (onCancel != null) ...[
          const Divider(height: 1),
          Padding(
            padding: const EdgeInsets.all(ThemeSpacing.sp4),
            child: SizedBox(
              height: 44,
              child: OutlinedButton(
                onPressed: onCancel,
                style: OutlinedButton.styleFrom(
                  foregroundColor: ThemeColors.danger,
                  side: const BorderSide(color: ThemeColors.danger),
                  shape: RoundedRectangleBorder(
                    borderRadius: ThemeRadius.brMd,
                  ),
                ),
                child: const Text('End navigation'),
              ),
            ),
          ),
        ],
      ],
    );
  }
}

