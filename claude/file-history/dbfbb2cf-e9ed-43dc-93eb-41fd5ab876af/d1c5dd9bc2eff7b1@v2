class ManeuverIcon extends StatelessWidget {
  final ManeuverAction? action;
  final bool isActive;

  const ManeuverIcon({super.key, this.action, this.isActive = false});

  @override
  Widget build(BuildContext context) {
    return Container(
      width: ThemeSpacing.sp8,
      height: ThemeSpacing.sp8,
      decoration: isActive
          ? const BoxDecoration(
              color: ThemeColors.accent,
              shape: BoxShape.circle,
            )
          : BoxDecoration(
              shape: BoxShape.circle,
              border: Border.all(color: ThemeColors.borderStrong, width: 2),
            ),
      child: Center(
        child: Icon(
          _iconData,
          size: isActive ? 18 : 14,
          color: isActive ? Colors.white : ThemeColors.accent,
        ),
      ),
    );
  }

  IconData get _iconData {
    if (action == null) return Icons.flag;
    return switch (action!) {
      ManeuverAction.depart => Icons.radio_button_checked,
      ManeuverAction.arrive => Icons.flag,
      ManeuverAction.leftTurn => Icons.turn_left,
      ManeuverAction.rightTurn => Icons.turn_right,
      ManeuverAction.leftUTurn => Icons.u_turn_left,
      ManeuverAction.rightUTurn => Icons.u_turn_right,
      ManeuverAction.sharpLeftTurn => Icons.turn_sharp_left,
      ManeuverAction.sharpRightTurn => Icons.turn_sharp_right,
      ManeuverAction.slightLeftTurn => Icons.turn_slight_left,
      ManeuverAction.slightRightTurn => Icons.turn_slight_right,
      ManeuverAction.continueOn => Icons.arrow_upward,
      ManeuverAction.leftRamp => Icons.merge,
      ManeuverAction.rightRamp => Icons.merge,
      ManeuverAction.leftFork => Icons.call_split,
      ManeuverAction.middleFork => Icons.call_split,
      ManeuverAction.rightFork => Icons.call_split,
      ManeuverAction.leftExit => Icons.exit_to_app,
      ManeuverAction.rightExit => Icons.exit_to_app,
      ManeuverAction.enterHighwayFromLeft => Icons.add_road,
      ManeuverAction.enterHighwayFromRight => Icons.add_road,
      _ => Icons.straight,
    };
  }
}

// ─── _CheckpointChip ─────────────────────────────────────────────────────────

class _CheckpointChip extends StatelessWidget {
  final Checkpoint checkpoint;
  final VoidCallback? onTap;

  const _CheckpointChip({required this.checkpoint, this.onTap});

  Color _statusColor(ContributionStatusEnum? status) => switch (status) {
    ContributionStatusEnum.ACTIVE => ThemeColors.danger,
    ContributionStatusEnum.INACTIVE => const Color(0xFF34C759),
    ContributionStatusEnum.POLICE_ALERT => const Color(0xFFFF9500),
    _ => ThemeColors.stone400,
  };

  @override
  Widget build(BuildContext context) {
    final status = checkpoint.contributions.isNotEmpty
        ? checkpoint.contributions.first.status
        : null;
    final lastContribution = checkpoint.contributions.firstOrNull;
    final lastUpdate = lastContribution?.createdAt ?? checkpoint.createdAt;
    final timeStr = DateFormat('HH:mm').format(lastUpdate.toLocal());

    return Padding(
      padding: const EdgeInsets.only(bottom: ThemeSpacing.sp1),
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          onTap: onTap,
          borderRadius: ThemeRadius.brSm,
          child: Container(
            padding: const EdgeInsets.symmetric(
              horizontal: ThemeSpacing.sp3,
              vertical: ThemeSpacing.sp2,
            ),
            constraints: const BoxConstraints(minHeight: 44),
            decoration: BoxDecoration(
              color: ThemeColors.bgSubtle,
              borderRadius: ThemeRadius.brSm,
            ),
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                Container(
                  width: 8,
                  height: 8,
                  decoration: BoxDecoration(
                    color: _statusColor(status),
                    shape: BoxShape.circle,
                  ),
                ),
                const SizedBox(width: ThemeSpacing.sp2),
                Flexible(
                  child: Text(
                    checkpoint.name,
                    style: const TextStyle(
                      fontSize: 13,
                      fontWeight: FontWeight.w500,
                      color: ThemeColors.textPrimary,
                    ),
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                  ),
                ),
                const SizedBox(width: ThemeSpacing.sp2),
                Text(
                  timeStr,
                  style: const TextStyle(
                    fontSize: 11,
                    fontWeight: FontWeight.w500,
                    color: ThemeColors.textTertiary,
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}
