  const _PeekContent({
    required this.guidance,
    required this.route,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    if (guidance.isActive) {
      return _GuidancePeekRow(guidance: guidance, onTap: onTap);
    }
    if (route != null) {
      return _RoutePeekRow(route: route!, onTap: onTap);
    }
    return _SearchPill(onTap: onTap);
  }
}

