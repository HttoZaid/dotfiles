@import "tailwindcss/theme.css" layer(theme);
@import "tailwindcss/preflight.css" layer(base);
@import "tailwindcss/utilities.css";

@import "nativewind/theme";

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);

  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);

  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);

  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);

  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);

  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);

  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);

  --color-success: var(--success);
  --color-success-foreground: var(--success-foreground);
  --color-warning: var(--warning);
  --color-warning-foreground: var(--warning-foreground);
  --color-info: var(--info);
  --color-info-foreground: var(--info-foreground);

  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);

  --radius: 0.625rem;
  --radius-sm: 0.375rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.625rem;
  --radius-xl: 0.875rem;

  --font-sans: "Geist", "Inter", system-ui, sans-serif;
  --font-mono: "Geist Mono", "JetBrains Mono", ui-monospace, monospace;

  --duration-fast: 100ms;
  --duration-normal: 200ms;
  --duration-slow: 300ms;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-snappy: cubic-bezier(0.2, 0, 0, 1);
}

:root {
  --background: hsl(210 40% 99%);
  --foreground: hsl(214 32% 12%);

  --card: hsl(0 0% 100%);
  --card-foreground: hsl(214 32% 12%);
  --popover: hsl(0 0% 100%);
  --popover-foreground: hsl(214 32% 12%);

  --primary: hsl(214 90% 48%);
  --primary-foreground: hsl(210 40% 99%);

  --secondary: hsl(214 30% 95%);
  --secondary-foreground: hsl(214 32% 18%);

  --muted: hsl(214 24% 95%);
  --muted-foreground: hsl(214 14% 42%);

  --accent: hsl(204 94% 94%);
  --accent-foreground: hsl(214 80% 30%);

  --destructive: hsl(0 72% 51%);
  --destructive-foreground: hsl(0 0% 100%);

  --success: hsl(150 60% 40%);
  --success-foreground: hsl(0 0% 100%);
  --warning: hsl(38 92% 50%);
  --warning-foreground: hsl(38 92% 12%);
  --info: hsl(204 94% 50%);
  --info-foreground: hsl(0 0% 100%);

  --border: hsl(214 24% 90%);
  --input: hsl(214 24% 90%);
  --ring: hsl(214 90% 48%);

  --chart-1: hsl(214 90% 52%);
  --chart-2: hsl(190 80% 42%);
  --chart-3: hsl(250 70% 60%);
  --chart-4: hsl(150 60% 45%);
  --chart-5: hsl(38 92% 55%);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: hsl(214 40% 7%);
    --foreground: hsl(210 30% 96%);

    --card: hsl(214 36% 10%);
    --card-foreground: hsl(210 30% 96%);
    --popover: hsl(214 36% 10%);
    --popover-foreground: hsl(210 30% 96%);

    --primary: hsl(210 95% 62%);
    --primary-foreground: hsl(214 40% 8%);

    --secondary: hsl(214 28% 16%);
    --secondary-foreground: hsl(210 30% 96%);

    --muted: hsl(214 26% 16%);
    --muted-foreground: hsl(214 16% 64%);

    --accent: hsl(214 40% 18%);
    --accent-foreground: hsl(210 90% 80%);

    --destructive: hsl(0 70% 58%);
    --destructive-foreground: hsl(0 0% 100%);

    --success: hsl(150 55% 50%);
    --success-foreground: hsl(150 60% 8%);
    --warning: hsl(38 90% 58%);
    --warning-foreground: hsl(38 92% 10%);
    --info: hsl(204 90% 62%);
    --info-foreground: hsl(214 40% 8%);

    --border: hsl(214 28% 18%);
    --input: hsl(214 28% 20%);
    --ring: hsl(210 95% 62%);

    --chart-1: hsl(210 95% 62%);
    --chart-2: hsl(190 80% 55%);
    --chart-3: hsl(250 75% 70%);
    --chart-4: hsl(150 55% 55%);
    --chart-5: hsl(38 90% 62%);
  }
}