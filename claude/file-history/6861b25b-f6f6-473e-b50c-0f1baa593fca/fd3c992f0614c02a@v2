import type { GeoJsonFeature } from "expo-here-maps";
import { MapPin } from "lucide-react-native";
import { Pressable, StyleSheet, Text, View } from "react-native";
import Animated, { FadeIn } from "react-native-reanimated";

type SearchResultRowProps = {
	feature: GeoJsonFeature;
	onPress: () => void;
};

// anti-slop rule #6: no Card-everything. List item style with section divider.
export function SearchResultRow({ feature, onPress }: SearchResultRowProps) {
	const hasSubtitle = !!feature.properties.subtitle;

	return (
		<Animated.View entering={FadeIn.duration(180)}>
			<Pressable
				onPress={onPress}
				style={({ pressed }) => [styles.row, pressed && styles.rowPressed]}
			>
				{/* Icon */}
				<View style={styles.iconWrap}>
					<MapPin size={17} color="hsl(215, 12%, 46%)" strokeWidth={2} />
				</View>

				{/* Labels */}
				<View style={styles.labelBlock}>
					<Text style={styles.title} numberOfLines={1}>
						{feature.properties.title}
					</Text>
					{hasSubtitle ? (
						<Text style={styles.subtitle} numberOfLines={1}>
							{feature.properties.subtitle}
						</Text>
					) : null}
				</View>
			</Pressable>

			{/* Section divider — left-aligned under the label, not full bleed */}
			<View style={styles.divider} />
		</Animated.View>
	);
}

const styles = StyleSheet.create({
	row: {
		flexDirection: "row",
		alignItems: "center",
		gap: 14,
		paddingVertical: 12,
		paddingHorizontal: 2,
		borderRadius: 8,
	},
	rowPressed: {
		opacity: 0.6,
	},
	iconWrap: {
		width: 38,
		height: 38,
		borderRadius: 19,
		alignItems: "center",
		justifyContent: "center",
		backgroundColor: "hsla(218, 18%, 93%, 1)",
		flexShrink: 0,
	},
	labelBlock: {
		flex: 1,
		gap: 2,
	},
	title: {
		fontSize: 16,
		fontWeight: "500",
		color: "hsl(218, 30%, 11%)",
		letterSpacing: -0.1,
	},
	subtitle: {
		fontSize: 13,
		fontWeight: "400",
		color: "hsl(215, 12%, 46%)",
	},
	divider: {
		height: StyleSheet.hairlineWidth,
		backgroundColor: "hsla(218, 16%, 88%, 1)",
		marginLeft: 52,
	},
});
