import { useSheet } from "@/components/ui/sheet";
import { useRouteState } from "@/features/navigation/route-context";
import { formatDistance, formatDuration, formatEta } from "@/features/navigation/lib/format-route";
import { Search, X } from "lucide-react-native";
import { useEffect } from "react";
import { Pressable, Text, View } from "react-native";
import Animated, {
	Extrapolation,
	interpolate,
	useAnimatedStyle,
	useSharedValue,
	withTiming,
} from "react-native-reanimated";

function NavPeek() {
	const { etaSeconds, remainingMeters, totalMeters, stopNavigation } = useRouteState();

	const progress =
		totalMeters != null && remainingMeters != null
			? Math.max(0, Math.min(1, 1 - remainingMeters / totalMeters))
			: 0;

	const progressAnim = useSharedValue(progress);

	useEffect(() => {
		progressAnim.value = withTiming(progress, { duration: 1000 });
	}, [progress, progressAnim]);

	const barStyle = useAnimatedStyle(() => ({
		width: `${interpolate(progressAnim.value, [0, 1], [0, 100], Extrapolation.CLAMP)}%`,
	}));

	const durationText = etaSeconds != null ? formatDuration(etaSeconds) : "—";
	const metaText = [
		remainingMeters != null ? formatDistance(remainingMeters) : null,
		etaSeconds != null ? `Arrive ${formatEta(etaSeconds)}` : null,
	]
		.filter(Boolean)
		.join("  ·  ");

	return (
		<View className="gap-2.5">
			{/* Progress track */}
			<View className="h-1 w-full overflow-hidden rounded-full bg-muted">
				<Animated.View style={barStyle} className="h-full rounded-full bg-primary" />
			</View>

			{/* Stats */}
			<View className="flex-row items-center justify-between">
				<View className="gap-0.5">
					<Text className="text-[26px] font-bold leading-tight tracking-tight text-foreground">
						{durationText}
					</Text>
					{metaText ? (
						<Text className="text-[13px] text-muted-foreground">{metaText}</Text>
					) : null}
				</View>

				<Pressable onPress={stopNavigation} hitSlop={14} className="active:opacity-60">
					<View className="h-10 w-10 items-center justify-center rounded-full bg-destructive/10">
						<X size={17} className="text-destructive" strokeWidth={2.5} />
					</View>
				</Pressable>
			</View>
		</View>
	);
}

export function SheetSearchDecoy() {
	const { expand } = useSheet();
	const { phase } = useRouteState();

	if (phase === "navigating") {
		return <NavPeek />;
	}

	return (
		<Pressable onPress={expand} className="active:opacity-85">
			<View className="flex-row items-center gap-3 rounded-xl border border-border bg-card px-4 py-[15px] shadow-sm">
				<Search size={20} className="text-primary" strokeWidth={2.25} />
				<Text className="flex-1 text-[17px] font-medium tracking-tight text-foreground">
					Where to?
				</Text>
				{/* GPS active indicator */}
				<View className="h-2 w-2 rounded-full bg-success" />
			</View>
		</Pressable>
	);
}
