import { useSheet } from "@/components/ui/sheet";
import { useRouteState } from "@/features/navigation/route-context";
import { formatDistance, formatDuration, formatEta } from "@/features/navigation/lib/format-route";
import { Search, X } from "lucide-react-native";
import { Pressable, StyleSheet, Text, View } from "react-native";
import Animated, {
	Extrapolation,
	interpolate,
	useAnimatedStyle,
	useSharedValue,
	withTiming,
} from "react-native-reanimated";
import { useEffect } from "react";

function NavPeek() {
	const { etaSeconds, remainingMeters, totalMeters, stopNavigation } = useRouteState();

	const progress =
		totalMeters != null && remainingMeters != null
			? Math.max(0, Math.min(1, 1 - remainingMeters / totalMeters))
			: 0;

	const progressAnim = useSharedValue(progress);

	useEffect(() => {
		progressAnim.value = withTiming(progress, { duration: 1000 });
	}, [progress, progressAnim]);

	const barStyle = useAnimatedStyle(() => ({
		width: `${interpolate(progressAnim.value, [0, 1], [0, 100], Extrapolation.CLAMP)}%`,
	}));

	const durationText = etaSeconds != null ? formatDuration(etaSeconds) : "—";
	const metaText = [
		remainingMeters != null ? formatDistance(remainingMeters) : null,
		etaSeconds != null ? `Arrive ${formatEta(etaSeconds)}` : null,
	]
		.filter(Boolean)
		.join("  ·  ");

	return (
		<View style={styles.navPeekRoot}>
			{/* Progress track */}
			<View style={styles.progressTrack}>
				<Animated.View style={[styles.progressFill, barStyle]} />
			</View>

			{/* Stats row */}
			<View style={styles.statsRow}>
				<View style={styles.statsLeft}>
					<Text style={styles.durationText}>{durationText}</Text>
					{metaText ? <Text style={styles.metaText}>{metaText}</Text> : null}
				</View>

				<Pressable
					onPress={stopNavigation}
					hitSlop={14}
					style={({ pressed }) => [styles.stopButton, pressed && { opacity: 0.6 }]}
				>
					<X size={17} color="#dc2626" strokeWidth={2.5} />
				</Pressable>
			</View>
		</View>
	);
}

export function SheetSearchDecoy() {
	const { expand } = useSheet();
	const { phase } = useRouteState();

	if (phase === "navigating") {
		return <NavPeek />;
	}

	return (
		<Pressable
			onPress={expand}
			style={({ pressed }) => [styles.searchPill, pressed && { opacity: 0.85 }]}
		>
			<Search size={20} color="hsl(198 68% 36%)" strokeWidth={2.25} />
			<Text style={styles.searchLabel}>Where to?</Text>
			{/* GPS active dot */}
			<View style={styles.gpsDot} />
		</Pressable>
	);
}

