import { cn } from "@/lib/utils";
import { useRouteState } from "@/features/navigation/route-context";
import { formatManeuverDistance } from "@/features/navigation/lib/format-route";
import {
	ArrowLeft,
	ArrowRight,
	ArrowUp,
	ArrowUpLeft,
	ArrowUpRight,
	CircleDot,
	CornerDownLeft,
	CornerDownRight,
	MapPin,
	Navigation,
	RotateCcw,
	RotateCw,
} from "lucide-react-native";
import type React from "react";
import { Text, View } from "react-native";
import Animated, { FadeInDown, FadeOutUp, LinearTransition } from "react-native-reanimated";
import { useSafeAreaInsets } from "react-native-safe-area-context";

/* Google Maps arrow icon style — white icon inside a coloured circle */
function ManeuverIcon({ action, imminent }: { action: string; imminent: boolean }): React.ReactNode {
	const props = { size: 22, strokeWidth: 2.75, color: "#fff" } as const;

	const icon = (() => {
		switch (action) {
			case "TURN_LEFT":
			case "SHARPLY_LEFT":
			case "LEFT_FORK":
			case "LEFT_RAMP":
			case "LEFT_EXIT":
			case "MOTORWAY_CHANGE_LEFT":
				return <ArrowLeft {...props} />;
			case "TURN_RIGHT":
			case "SHARPLY_RIGHT":
			case "RIGHT_FORK":
			case "RIGHT_RAMP":
			case "RIGHT_EXIT":
			case "MOTORWAY_CHANGE_RIGHT":
				return <ArrowRight {...props} />;
			case "SLIGHT_LEFT":
			case "KEEP_LEFT":
				return <ArrowUpLeft {...props} />;
			case "SLIGHT_RIGHT":
			case "KEEP_RIGHT":
				return <ArrowUpRight {...props} />;
			case "U_TURN_LEFT":
				return <RotateCcw {...props} />;
			case "U_TURN_RIGHT":
				return <RotateCw {...props} />;
			case "ROUNDABOUT_ENTER":
			case "ROUNDABOUT_EXIT":
			case "ROUNDABOUT_PASS":
				return <CircleDot {...props} />;
			case "ENTER_HIGHWAY":
				return <CornerDownLeft {...props} />;
			case "EXIT_HIGHWAY":
				return <CornerDownRight {...props} />;
			case "ARRIVE":
				return <MapPin {...props} />;
			case "DEPART":
				return <Navigation {...props} />;
			default:
				return <ArrowUp {...props} />;
		}
	})();

	return (
		<View
			className={cn(
				"h-11 w-11 items-center justify-center rounded-full",
				imminent ? "bg-warning" : "bg-primary",
			)}
		>
			{icon}
		</View>
	);
}

export function ManeuverBanner() {
	const { phase, maneuverText, maneuverAction, maneuverDistanceMeters } = useRouteState();
	const insets = useSafeAreaInsets();

	if (phase !== "navigating" || !maneuverText) return null;

	const distanceLabel =
		maneuverDistanceMeters != null && maneuverDistanceMeters > 20
			? formatManeuverDistance(maneuverDistanceMeters)
			: null;

	const imminent = maneuverDistanceMeters != null && maneuverDistanceMeters <= 20;

	return (
		<Animated.View
			entering={FadeInDown.duration(260).springify().damping(22)}
			exiting={FadeOutUp.duration(180)}
			layout={LinearTransition.springify().damping(22)}
			style={{ top: insets.top + 8 }}
			className="absolute inset-x-3 z-50"
		>
			{/* Google Maps style — always dark pill, blue arrow circle left, text right */}
			<View className="flex-row items-center gap-4 rounded-2xl bg-overlay px-4 py-4 shadow-2xl">

				{/* Arrow icon in coloured circle */}
				<ManeuverIcon action={maneuverAction ?? "CONTINUE"} imminent={imminent} />

				{/* Text block: distance hero + street name */}
				<View className="flex-1">
					{distanceLabel ? (
						/* Distance is the primary info — large, bold, glanceable */
						<Text className="text-[22px] font-bold leading-tight tracking-tight text-overlay-foreground">
							{distanceLabel}
						</Text>
					) : (
						<Text className="text-[16px] font-semibold text-overlay-foreground/60">
							Now
						</Text>
					)}
					<Text
						className="text-[14px] font-medium leading-snug text-overlay-foreground/70"
						numberOfLines={1}
					>
						{maneuverText}
					</Text>
				</View>
			</View>
		</Animated.View>
	);
}
