import { useSheet } from "@/components/ui/sheet";
import { NavigatingCard } from "@/features/navigation/components/NavigatingCard";
import { RoutePointField } from "@/features/navigation/components/RoutePointField";
import { SearchResultRow } from "@/features/navigation/components/SearchResultRow";
import { useRouteSearch } from "@/features/navigation/hooks/use-route-search";
import type { ActiveField, RoutePoint } from "@/features/navigation/hooks/use-route-search";
import { useRouteState } from "@/features/navigation/route-context";
import type { GeoJsonFeature, HereMapsViewRef } from "expo-here-maps";
import { ArrowUpDown, Navigation } from "lucide-react-native";
import type { RefObject } from "react";
import { useCallback } from "react";
import { ActivityIndicator, Pressable, Text, View } from "react-native";
import Animated, { FadeIn, FadeInUp, LinearTransition } from "react-native-reanimated";

type SheetSearchProps = {
	mapRef: RefObject<HereMapsViewRef | null>;
};

// --- sub-components ---

type RouteInputsProps = {
	active: ActiveField;
	origin: RoutePoint;
	destination: RoutePoint | null;
	originValue: string;
	destinationValue: string;
	canSwap: boolean;
	onSetQuery: (q: string) => void;
	onFocusOrigin: () => void;
	onFocusDestination: () => void;
	onUseLocationOrigin: () => void;
	onUseLocationDestination: () => void;
	onClearOrigin: () => void;
	onClearDestination: () => void;
	onSwap: () => void;
};

function RouteInputs({
	active,
	origin,
	destination,
	originValue,
	destinationValue,
	canSwap,
	onSetQuery,
	onFocusOrigin,
	onFocusDestination,
	onUseLocationOrigin,
	onUseLocationDestination,
	onClearOrigin,
	onClearDestination,
	onSwap,
}: RouteInputsProps) {
	return (
		<View className="flex-row items-stretch">
			<View className="w-7 items-center justify-center py-5">
				<View className="h-3 w-3 rounded-full border-[2.5px] border-muted-foreground" />
				<View className="my-2 w-0.5 flex-1 rounded-full bg-border" />
				<View className="h-3 w-3 rounded-[3px] bg-primary" />
			</View>

			<View className="flex-1 overflow-hidden rounded-3xl border border-border bg-card">
				<RoutePointField
					value={originValue}
					active={active === "origin"}
					isCurrentLocation={origin.isCurrentLocation && active !== "origin"}
					canUseLocation={active === "origin" && !origin.isCurrentLocation}
					onChangeText={onSetQuery}
					onFocus={onFocusOrigin}
					onUseLocation={onUseLocationOrigin}
					onClear={onClearOrigin}
					placeholder="Choose start"
				/>
				<View className="ml-4 h-px bg-border" />
				<RoutePointField
					value={destinationValue}
					active={active === "destination"}
					isCurrentLocation={destination?.isCurrentLocation === true && active !== "destination"}
					canUseLocation={active === "destination"}
					onChangeText={onSetQuery}
					onFocus={onFocusDestination}
					onUseLocation={onUseLocationDestination}
					onClear={onClearDestination}
					placeholder="Where to?"
				/>
			</View>

			<View className="w-12 items-center justify-center">
				<Pressable
					onPress={onSwap}
					disabled={!canSwap}
					hitSlop={10}
					className={canSwap ? "active:opacity-50" : "opacity-30"}
				>
					<View className="h-10 w-10 items-center justify-center rounded-full border border-border bg-background">
						<ArrowUpDown size={17} className="text-foreground" strokeWidth={2.25} />
					</View>
				</Pressable>
			</View>
		</View>
	);
}

type StartButtonProps = {
	isStarting: boolean;
	onPress: () => void;
};

function StartButton({ isStarting, onPress }: StartButtonProps) {
	return (
		<Animated.View entering={FadeInUp.duration(220)}>
			<Pressable onPress={onPress} disabled={isStarting} className="active:opacity-90">
				<View className="flex-row items-center justify-center gap-2.5 rounded-2xl bg-primary py-4">
					{isStarting ? (
						<ActivityIndicator size="small" color="white" />
					) : (
						<Navigation size={19} className="text-primary-foreground" fill="currentColor" />
					)}
					<Text className="text-[16px] font-semibold text-primary-foreground">
						{isStarting ? "Starting…" : "Start navigation"}
					</Text>
				</View>
			</Pressable>
		</Animated.View>
	);
}

// --- main export ---

export function SheetSearch({ mapRef }: SheetSearchProps) {
	const { snapTo } = useSheet();
	const { phase } = useRouteState();
	const {
		query,
		setQuery,
		results,
		isLoading,
		hasSearched,
		origin,
		destination,
		active,
		canRoute,
		isStartingNavigation,
		editField,
		selectResult,
		setFieldToCurrent,
		clearField,
		swap,
		startNavigation,
		stopNavigation,
	} = useRouteSearch(mapRef);

	const handleStart = useCallback(async () => {
		const ok = await startNavigation();
		if (ok) snapTo(0);
	}, [startNavigation, snapTo]);

	if (phase === "navigating") {
		return (
			<NavigatingCard
				destination={destination?.label ?? "Destination"}
				onEnd={stopNavigation}
			/>
		);
	}

	const originValue =
		active === "origin" ? query : origin.isCurrentLocation ? "Current location" : origin.label;

	const destinationValue = active === "destination" ? query : (destination?.label ?? "");
	const canSwap = !!destination || !origin.isCurrentLocation;
	const hasResults = results.length > 0;

	return (
		<View className="flex-1 gap-7">
			<RouteInputs
				active={active}
				origin={origin}
				destination={destination}
				originValue={originValue}
				destinationValue={destinationValue}
				canSwap={canSwap}
				onSetQuery={setQuery}
				onFocusOrigin={() => editField("origin")}
				onFocusDestination={() => editField("destination")}
				onUseLocationOrigin={() => setFieldToCurrent("origin")}
				onUseLocationDestination={() => setFieldToCurrent("destination")}
				onClearOrigin={() => clearField("origin")}
				onClearDestination={() => clearField("destination")}
				onSwap={swap}
			/>

			{canRoute && active === null ? (
				<StartButton isStarting={isStartingNavigation} onPress={handleStart} />
			) : null}

			{isLoading ? (
				<View className="items-center py-8">
					<ActivityIndicator size="small" />
				</View>
			) : null}

			{hasResults ? (
				<Animated.View layout={LinearTransition.duration(220)} className="gap-3">
					{results.map((feature: GeoJsonFeature) => (
						<SearchResultRow
							key={feature.properties.placeId}
							feature={feature}
							onPress={() => selectResult(feature)}
						/>
					))}
				</Animated.View>
			) : null}

			{hasSearched && !isLoading && !hasResults ? (
				<Animated.View entering={FadeIn.duration(220)} className="items-center gap-1.5 py-14">
					<Text className="text-lg font-semibold text-foreground">No places found</Text>
					<Text className="text-[15px] text-muted-foreground">Try a different search</Text>
				</Animated.View>
			) : null}
		</View>
	);
}
