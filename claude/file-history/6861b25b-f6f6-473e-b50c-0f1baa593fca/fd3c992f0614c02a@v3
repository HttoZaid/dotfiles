				<View className="flex-row items-center gap-3.5 rounded-lg py-3 px-0.5">
					<View className="h-9 w-9 items-center justify-center rounded-full bg-muted flex-shrink-0">
						<MapPin size={16} className="text-muted-foreground" strokeWidth={2} />
