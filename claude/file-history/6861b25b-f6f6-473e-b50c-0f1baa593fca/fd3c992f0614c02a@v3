					<View className="flex-1 gap-0.5">
						<Text
							className="text-[16px] font-medium leading-snug text-foreground tracking-tight"
							numberOfLines={1}
						>
							{feature.properties.title}
						</Text>
						{feature.properties.subtitle ? (
							<Text
								className="text-[13px] leading-snug text-muted-foreground"
								numberOfLines={1}
							>
								{feature.properties.subtitle}
							</Text>
						) : null}
					</View>
				</View>
			</Pressable>
			{/* Inset divider aligned under label */}
			<View className="ml-[52px] h-px bg-border" />
		</Animated.View>
