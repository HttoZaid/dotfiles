import { cn } from "@/lib/utils";
import { useRouteState } from "@/features/navigation/route-context";
import { formatManeuverDistance } from "@/features/navigation/lib/format-route";
import {
	ArrowLeft,
	ArrowRight,
	ArrowUp,
	ArrowUpLeft,
	ArrowUpRight,
	CircleDot,
	CornerDownLeft,
	CornerDownRight,
	MapPin,
	Navigation,
	RotateCcw,
	RotateCw,
} from "lucide-react-native";
import type React from "react";
import { Text, View } from "react-native";
import Animated, { FadeInDown, FadeOutUp, LinearTransition } from "react-native-reanimated";
import { useSafeAreaInsets } from "react-native-safe-area-context";

function ManeuverIcon({ action, imminent }: { action: string; imminent: boolean }): React.ReactNode {
	const cls = imminent ? "text-warning-foreground" : "text-overlay-foreground";
	const props = { size: 26, strokeWidth: 2.5, className: cls } as const;

	switch (action) {
		case "TURN_LEFT":
		case "SHARPLY_LEFT":
		case "LEFT_FORK":
		case "LEFT_RAMP":
		case "LEFT_EXIT":
		case "MOTORWAY_CHANGE_LEFT":
			return <ArrowLeft {...props} />;
		case "TURN_RIGHT":
		case "SHARPLY_RIGHT":
		case "RIGHT_FORK":
		case "RIGHT_RAMP":
		case "RIGHT_EXIT":
		case "MOTORWAY_CHANGE_RIGHT":
			return <ArrowRight {...props} />;
		case "SLIGHT_LEFT":
		case "KEEP_LEFT":
			return <ArrowUpLeft {...props} />;
		case "SLIGHT_RIGHT":
		case "KEEP_RIGHT":
			return <ArrowUpRight {...props} />;
		case "U_TURN_LEFT":
			return <RotateCcw {...props} />;
		case "U_TURN_RIGHT":
			return <RotateCw {...props} />;
		case "ROUNDABOUT_ENTER":
		case "ROUNDABOUT_EXIT":
		case "ROUNDABOUT_PASS":
			return <CircleDot {...props} />;
		case "ENTER_HIGHWAY":
			return <CornerDownLeft {...props} />;
		case "EXIT_HIGHWAY":
			return <CornerDownRight {...props} />;
		case "ARRIVE":
			return <MapPin {...props} />;
		case "DEPART":
			return <Navigation {...props} />;
		default:
			return <ArrowUp {...props} />;
	}
}

export function ManeuverBanner() {
	const { phase, maneuverText, maneuverAction, maneuverDistanceMeters } = useRouteState();
	const insets = useSafeAreaInsets();

	if (phase !== "navigating" || !maneuverText) return null;

	const distanceLabel =
		maneuverDistanceMeters != null && maneuverDistanceMeters > 30
			? formatManeuverDistance(maneuverDistanceMeters)
			: null;

	// Amber warning when turn is ≤30m away
	const imminent = maneuverDistanceMeters != null && maneuverDistanceMeters <= 30;

	return (
		<Animated.View
			entering={FadeInDown.duration(260).springify().damping(22)}
			exiting={FadeOutUp.duration(180)}
			layout={LinearTransition.springify().damping(22)}
			style={{ top: insets.top + 10 }}
			className="absolute inset-x-3 z-50"
		>
			<View
				className={cn(
					"flex-row items-center gap-3.5 rounded-xl px-4 py-3.5 shadow-xl",
					imminent ? "bg-warning" : "bg-overlay",
				)}
			>
				{/* Icon cell */}
				<View className="h-12 w-12 items-center justify-center rounded-xl bg-white/15">
					<ManeuverIcon action={maneuverAction ?? "CONTINUE"} imminent={imminent} />
				</View>

				{/* Text */}
				<View className="flex-1 gap-1">
					{distanceLabel ? (
						<Text className="text-[11px] font-bold uppercase tracking-widest text-overlay-foreground/55">
							In {distanceLabel}
						</Text>
					) : null}
					<Text
						className="text-[19px] font-bold leading-tight text-overlay-foreground"
						numberOfLines={2}
					>
						{maneuverText}
					</Text>
				</View>
			</View>
		</Animated.View>
	);
}
