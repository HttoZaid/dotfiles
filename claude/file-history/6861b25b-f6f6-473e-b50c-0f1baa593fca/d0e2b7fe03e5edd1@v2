@import "tailwindcss/theme.css" layer(theme);
@import "tailwindcss/preflight.css" layer(base);
@import "tailwindcss/utilities.css";

@import "nativewind/theme";

/* ─── Token map: semantic vars → @theme ───────────────────────────────────── */
@theme inline {
  --color-background:   var(--background);
  --color-foreground:   var(--foreground);

  --color-card:                 var(--card);
  --color-card-foreground:      var(--card-foreground);
  --color-popover:              var(--popover);
  --color-popover-foreground:   var(--popover-foreground);

  --color-primary:              var(--primary);
  --color-primary-foreground:   var(--primary-foreground);

  --color-secondary:            var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);

  --color-muted:                var(--muted);
  --color-muted-foreground:     var(--muted-foreground);

  --color-accent:               var(--accent);
  --color-accent-foreground:    var(--accent-foreground);

  --color-destructive:          var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);

  --color-success:              var(--success);
  --color-success-foreground:   var(--success-foreground);
  --color-warning:              var(--warning);
  --color-warning-foreground:   var(--warning-foreground);
  --color-info:                 var(--info);
  --color-info-foreground:      var(--info-foreground);

  --color-border:               var(--border);
  --color-input:                var(--input);
  --color-ring:                 var(--ring);

  /* Always-dark map overlay surface (banner, badges over map) */
  --color-overlay:              var(--overlay);
  --color-overlay-foreground:   var(--overlay-foreground);

  /* ─── Radius system (anti-slop: systematic, not rounded-2xl everywhere) ─── */
  --radius:     0.875rem;   /* 14dp — sheet/modal */
  --radius-sm:  0.25rem;    /*  4dp — inputs */
  --radius-md:  0.5rem;     /*  8dp — cards */
  --radius-lg:  0.875rem;   /* 14dp — large cards */
  --radius-xl:  1.25rem;    /* 20dp — sheets, banners */
  --radius-pill: 9999px;    /* capsule — buttons, badges */

  /* ─── Typography ────────────────────────────────────────────────────────── */
  --font-sans:  "Geist", "Inter", system-ui, sans-serif;
  --font-mono:  "Geist Mono", "JetBrains Mono", ui-monospace, monospace;

  /* ─── Motion tokens ─────────────────────────────────────────────────────── */
  --duration-fast:    100ms;
  --duration-normal:  200ms;
  --duration-slow:    300ms;
  --ease-out:         cubic-bezier(0.16, 1, 0.3, 1);
  --ease-snappy:      cubic-bezier(0.2, 0, 0, 1);
  --ease-spring:      cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ─── Light mode ─────────────────────────────────────────────────────────── */
:root {
  /* Surfaces */
  --background:           hsl(220 18% 98%);   /* cold near-white */
  --foreground:           hsl(218 30% 11%);   /* deep navy-black */

  --card:                 hsl(0 0% 100%);
  --card-foreground:      hsl(218 30% 11%);
  --popover:              hsl(0 0% 100%);
  --popover-foreground:   hsl(218 30% 11%);

  /* Petrol teal — UK navigation, Ordnance Survey authority */
  --primary:              hsl(198 68% 36%);
  --primary-foreground:   hsl(0 0% 100%);

  --secondary:            hsl(198 22% 93%);
  --secondary-foreground: hsl(198 45% 22%);

  --muted:                hsl(218 18% 93%);
  --muted-foreground:     hsl(215 12% 46%);

  --accent:               hsl(195 42% 91%);
  --accent-foreground:    hsl(198 62% 28%);

  --destructive:          hsl(4 80% 54%);
  --destructive-foreground: hsl(0 0% 100%);

  --success:              hsl(148 55% 40%);
  --success-foreground:   hsl(0 0% 100%);
  --warning:              hsl(40 92% 50%);
  --warning-foreground:   hsl(40 92% 10%);
  --info:                 hsl(204 90% 48%);
  --info-foreground:      hsl(0 0% 100%);

  --border:               hsl(218 16% 88%);
  --input:                hsl(218 16% 88%);
  --ring:                 hsl(198 68% 36%);

  /* Always-dark overlay (map banner, floating controls) */
  --overlay:              hsl(218 35% 10%);
  --overlay-foreground:   hsl(210 10% 97%);
}

/* ─── Dark mode ─────────────────────────────────────────────────────────── */
@media (prefers-color-scheme: dark) {
  :root {
    /* Deep navy — designed for night driving */
    --background:           hsl(218 30% 7%);
    --foreground:           hsl(210 18% 95%);

    --card:                 hsl(218 26% 11%);
    --card-foreground:      hsl(210 18% 95%);
    --popover:              hsl(218 26% 11%);
    --popover-foreground:   hsl(210 18% 95%);

    /* Lifted teal for dark surfaces */
    --primary:              hsl(196 58% 52%);
    --primary-foreground:   hsl(218 30% 7%);

    --secondary:            hsl(218 22% 17%);
    --secondary-foreground: hsl(210 18% 95%);

    --muted:                hsl(218 22% 15%);
    --muted-foreground:     hsl(215 14% 58%);

    --accent:               hsl(198 30% 19%);
    --accent-foreground:    hsl(196 68% 72%);

    --destructive:          hsl(4 72% 58%);
    --destructive-foreground: hsl(0 0% 100%);

    --success:              hsl(148 52% 50%);
    --success-foreground:   hsl(148 60% 8%);
    --warning:              hsl(40 88% 58%);
    --warning-foreground:   hsl(40 92% 10%);
    --info:                 hsl(204 85% 58%);
    --info-foreground:      hsl(218 30% 7%);

    --border:               hsl(218 20% 18%);
    --input:                hsl(218 20% 20%);
    --ring:                 hsl(196 58% 52%);

    --overlay:              hsl(218 35% 8%);
    --overlay-foreground:   hsl(210 10% 97%);
  }
}
