import { formatDistance, formatEta } from "@/features/navigation/lib/format-route";
import { useRouteState } from "@/features/navigation/route-context";
import { X } from "lucide-react-native";
import { Pressable, Text, View } from "react-native";
import Animated, { FadeIn } from "react-native-reanimated";

type NavigatingCardProps = {
	destination: string;
	onEnd: () => void;
};

export function NavigatingCard({ destination, onEnd }: NavigatingCardProps) {
	const { etaSeconds, remainingMeters } = useRouteState();

	return (
		<Animated.View entering={FadeIn.duration(250)} className="gap-5">
			<View className="gap-1.5 overflow-hidden rounded-3xl border border-border bg-card px-5 py-4">
				<Text className="text-[11px] font-bold uppercase tracking-widest text-muted-foreground">
					Navigating to
				</Text>
				<Text className="text-[20px] font-bold text-foreground" numberOfLines={1}>
					{destination}
				</Text>
				{remainingMeters != null && etaSeconds != null ? (
					<Text className="text-[14px] text-muted-foreground">
						{formatDistance(remainingMeters)}{"  ·  Arrive "}
						{formatEta(etaSeconds)}
					</Text>
				) : null}
			</View>

			<Pressable onPress={onEnd} className="active:opacity-90">
				<View className="flex-row items-center justify-center gap-2 rounded-2xl bg-destructive py-4">
					<X size={19} className="text-destructive-foreground" strokeWidth={2.5} />
					<Text className="text-[16px] font-semibold text-destructive-foreground">
						End navigation
					</Text>
				</View>
			</Pressable>
		</Animated.View>
	);
}
