import { Sheet, SheetExpanded, SheetPeek } from "@/components/ui/sheet";
import { useCurrentLocation } from "@/features/location/use-current-location";
import { ArrivalScreen } from "@/features/navigation/components/ArrivalScreen";
import { ManeuverBanner } from "@/features/navigation/components/ManeuverBanner";
import { SheetSearch } from "@/features/navigation/components/SheetSearch";
import { SheetSearchDecoy } from "@/features/navigation/components/SheetSearchDecoy";
import { RouteStateProvider, useRouteState } from "@/features/navigation/route-context";
import type { GuidanceProgressEvent, HereMapsViewRef, LatLng, ManeuverEvent } from "expo-here-maps";
import { HereMapsView } from "expo-here-maps";
import { Compass, LocateFixed } from "lucide-react-native";
import { useCallback, useEffect, useRef, useState } from "react";
import { Pressable, StyleSheet, Text, View } from "react-native";
import Animated, {
	Easing,
	FadeIn,
	FadeOut,
	interpolate,
	useAnimatedStyle,
	useSharedValue,
	withDelay,
	withRepeat,
	withTiming,
} from "react-native-reanimated";
import { useSafeAreaInsets } from "react-native-safe-area-context";

// ─── Locating screen ─────────────────────────────────────────────────────────

function PulseRing({ delay = 0 }: { delay?: number }) {
	const progress = useSharedValue(0);

	useEffect(() => {
		progress.value = withDelay(
			delay,
			withRepeat(
				withTiming(1, { duration: 1800, easing: Easing.out(Easing.quad) }),
				-1,
			),
		);
	}, [delay, progress]);

	const style = useAnimatedStyle(() => ({
		opacity: interpolate(progress.value, [0, 0.4, 1], [0.45, 0.12, 0]),
		transform: [{ scale: interpolate(progress.value, [0, 1], [1, 2.6]) }],
	}));

	return (
		<Animated.View
			style={[style, { position: "absolute", width: 80, height: 80, borderRadius: 40 }]}
			className="bg-primary/20"
		/>
	);
}

function LocatingScreen() {
	const insets = useSafeAreaInsets();
	return (
		<View
			className="flex-1 items-center justify-center bg-background"
			style={{ paddingBottom: insets.bottom + 32 }}
		>
			<View className="h-48 w-48 items-center justify-center">
				<PulseRing delay={0} />
				<PulseRing delay={700} />
				<View className="h-20 w-20 items-center justify-center rounded-full bg-primary/10">
					<LocateFixed size={32} className="text-primary" strokeWidth={2} />
				</View>
			</View>
			<View className="items-center gap-1.5">
				<Text className="text-[19px] font-semibold tracking-tight text-foreground">
					Finding your location
				</Text>
				<Text className="text-[15px] text-muted-foreground">This just takes a moment</Text>
			</View>
		</View>
	);
}

// ─── Compass button ───────────────────────────────────────────────────────────

type CompassButtonProps = {
	mapRef: React.RefObject<HereMapsViewRef | null>;
	location: LatLng | null;
};

function CompassButton({ mapRef, location }: CompassButtonProps) {
	const handlePress = useCallback(() => {
		if (!location) return;
		mapRef.current?.setCameraPosition({
			lat: location.lat,
			lng: location.lng,
			bearing: 0,
			animated: true,
			distanceMeters: 800,
		});
	}, [mapRef, location]);

	return (
		<Pressable onPress={handlePress} hitSlop={8} className="active:opacity-60">
			<View className="h-12 w-12 items-center justify-center rounded-full bg-card shadow-md border border-border/60">
				<Compass size={22} className="text-foreground" strokeWidth={1.75} />
			</View>
		</Pressable>
	);
}

// ─── Map screen ───────────────────────────────────────────────────────────────

function MapScreen() {
	const mapRef = useRef<HereMapsViewRef>(null);
	const location = useCurrentLocation();
	const [located, setLocated] = useState(false);
	const didCenter = useRef(false);
	const insets = useSafeAreaInsets();
	const { set, phase } = useRouteState();

	useEffect(() => {
		if (location && !didCenter.current) {
			didCenter.current = true;
			mapRef.current?.setCameraPosition({
				lat: location.lat,
				lng: location.lng,
				distanceMeters: 800,
			});
			setLocated(true);
		}
	}, [location]);

	const handleGuidanceProgress = useCallback(
		(e: { nativeEvent: GuidanceProgressEvent }) => {
			set({
				remainingMeters: e.nativeEvent.remainingMeters,
				etaSeconds: e.nativeEvent.etaSeconds,
			});
		},
		[set],
	);

	const handleManeuver = useCallback(
		(e: { nativeEvent: ManeuverEvent }) => {
			set({
				maneuverText: e.nativeEvent.text,
				maneuverAction: e.nativeEvent.action,
				maneuverDistanceMeters: e.nativeEvent.distanceMeters,
			});
		},
		[set],
	);

	const handleArrived = useCallback(() => {
		set({ phase: "arrived" });
	}, [set]);

	return (
		<View style={{ flex: 1 }}>
			<HereMapsView
				ref={mapRef}
				style={StyleSheet.absoluteFill}
				bearing={0}
				tilt={0}
				onGuidanceProgress={handleGuidanceProgress}
				onManeuver={handleManeuver}
				onArrived={handleArrived}
			/>

			{/* Maneuver banner — top centre */}
			<ManeuverBanner />

			{/* Compass button — top right, hidden during navigation (DynamicCameraBehavior runs the camera) */}
			{phase !== "navigating" ? (
				<Animated.View
					entering={FadeIn.duration(200)}
					exiting={FadeOut.duration(150)}
					style={{ position: "absolute", top: insets.top + 16, right: 16, zIndex: 40 }}
				>
					<CompassButton mapRef={mapRef} location={location} />
				</Animated.View>
			) : null}

			<Sheet snapPoints={["peek", "half", "full"]}>
				<SheetPeek>
					<SheetSearchDecoy />
				</SheetPeek>
				<SheetExpanded>
					<SheetSearch mapRef={mapRef} />
				</SheetExpanded>
			</Sheet>

			<ArrivalScreen />

			{!located ? (
				<Animated.View exiting={FadeOut.duration(400)} style={StyleSheet.absoluteFill}>
					<LocatingScreen />
				</Animated.View>
			) : null}
		</View>
	);
}

// ─── Root ─────────────────────────────────────────────────────────────────────

export default function Home() {
	return (
		<RouteStateProvider>
			<MapScreen />
		</RouteStateProvider>
	);
}
