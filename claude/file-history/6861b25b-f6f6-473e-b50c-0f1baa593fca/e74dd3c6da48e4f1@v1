import { BottomSheetTextInput } from "@gorhom/bottom-sheet";
import { LocateFixed, X } from "lucide-react-native";
import { Pressable, Text, View } from "react-native";

type RoutePointFieldProps = {
	value: string;
	active: boolean;
	isCurrentLocation: boolean;
	canUseLocation: boolean;
	onChangeText: (t: string) => void;
	onFocus: () => void;
	onUseLocation: () => void;
	onClear: () => void;
	placeholder: string;
};

export function RoutePointField({
	value,
	active,
	isCurrentLocation,
	canUseLocation,
	onChangeText,
	onFocus,
	onUseLocation,
	onClear,
	placeholder,
}: RoutePointFieldProps) {
	const hasValue = value.length > 0;

	return (
		<View className="h-16 flex-row items-center gap-2 px-4">
			{active ? (
				<BottomSheetTextInput
					value={value}
					onChangeText={onChangeText}
					placeholder={placeholder}
					placeholderTextColor="hsl(214 14% 42%)"
					autoFocus
					returnKeyType="search"
					autoCorrect={false}
					className="flex-1 text-[17px] font-medium text-foreground"
				/>
			) : (
				<Pressable onPress={onFocus} className="flex-1 flex-row items-center gap-2 active:opacity-60">
					{isCurrentLocation ? (
						<LocateFixed size={15} className="text-primary" strokeWidth={2.5} />
					) : null}
					<Text
						className={`flex-1 text-[17px] font-medium ${hasValue ? "text-foreground" : "text-muted-foreground"}`}
						numberOfLines={1}
					>
						{value || placeholder}
					</Text>
				</Pressable>
			)}

			{active && canUseLocation ? (
				<Pressable onPress={onUseLocation} hitSlop={10} className="active:opacity-50">
					<View className="h-8 w-8 items-center justify-center rounded-full bg-primary/10">
						<LocateFixed size={16} className="text-primary" strokeWidth={2.5} />
					</View>
				</Pressable>
			) : hasValue && !isCurrentLocation && !active ? (
				<Pressable onPress={onClear} hitSlop={10} className="active:opacity-50">
					<View className="h-7 w-7 items-center justify-center rounded-full bg-muted-foreground/15">
						<X size={14} className="text-muted-foreground" strokeWidth={2.5} />
					</View>
				</Pressable>
			) : null}
		</View>
	);
}