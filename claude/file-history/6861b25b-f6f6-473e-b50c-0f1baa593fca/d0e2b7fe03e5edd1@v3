@import "tailwindcss/theme.css" layer(theme);
@import "tailwindcss/preflight.css" layer(base);
@import "tailwindcss/utilities.css";

@import "nativewind/theme";

/* ─── Token map ──────────────────────────────────────────────────────────────
   Reference palette:
   · Apple Maps   — #007AFF, pure white sheets, dark frosted banner
   · Google Maps  — #1A73E8, #202124 dark banner, white sheets
   · Uber         — #1A1A1A near-black, bold white type, zero chrome
   · Waze         — #00D1FF cyan, #1A1A2E dark banner
   ─────────────────────────────────────────────────────────────────────────── */
@theme inline {
  --color-background:             var(--background);
  --color-foreground:             var(--foreground);
  --color-card:                   var(--card);
  --color-card-foreground:        var(--card-foreground);
  --color-popover:                var(--popover);
  --color-popover-foreground:     var(--popover-foreground);
  --color-primary:                var(--primary);
  --color-primary-foreground:     var(--primary-foreground);
  --color-secondary:              var(--secondary);
  --color-secondary-foreground:   var(--secondary-foreground);
  --color-muted:                  var(--muted);
  --color-muted-foreground:       var(--muted-foreground);
  --color-accent:                 var(--accent);
  --color-accent-foreground:      var(--accent-foreground);
  --color-destructive:            var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-success:                var(--success);
  --color-success-foreground:     var(--success-foreground);
  --color-warning:                var(--warning);
  --color-warning-foreground:     var(--warning-foreground);
  --color-info:                   var(--info);
  --color-info-foreground:        var(--info-foreground);
  --color-border:                 var(--border);
  --color-input:                  var(--input);
  --color-ring:                   var(--ring);

  /* Always-dark map overlay — banner, floating controls, badges over map tiles.
     Must stay dark in both light AND dark mode so it reads over any map background. */
  --color-overlay:                var(--overlay);
  --color-overlay-foreground:     var(--overlay-foreground);

  /* ── Radius system — Google/Apple navigation grammar ───────────────────────
     Inputs: 8px  ·  Cards: 12px  ·  Buttons: pill  ·  Banners: 16px
     Anti-slop rule #4: one system, not rounded-2xl on everything            */
  --radius:     0.75rem;    /* 12px – cards, sheets */
  --radius-sm:  0.375rem;   /*  6px – inputs, tight surfaces */
  --radius-md:  0.5rem;     /*  8px – mid surfaces */
  --radius-lg:  0.75rem;    /* 12px – cards */
  --radius-xl:  1rem;       /* 16px – banners, large cards */
  --radius-pill: 9999px;    /* buttons, badges */

  /* ── Typography ─────────────────────────────────────────────────────────── */
  --font-sans:  "Geist", "Inter", system-ui, sans-serif;
  --font-mono:  "Geist Mono", "JetBrains Mono", ui-monospace, monospace;

  /* ── Motion ─────────────────────────────────────────────────────────────── */
  --duration-fast:    100ms;
  --duration-normal:  200ms;
  --duration-slow:    300ms;
  --ease-out:         cubic-bezier(0.16, 1, 0.3, 1);
  --ease-snappy:      cubic-bezier(0.2, 0, 0, 1);
  --ease-spring:      cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ─── Light mode — Apple Maps / Google Maps white-sheet grammar ─────────── */
:root {
  --background:             hsl(0 0% 100%);         /* pure white — Apple/Google */
  --foreground:             hsl(222 12% 9%);         /* near-black, never pure #000 */

  --card:                   hsl(0 0% 100%);
  --card-foreground:        hsl(222 12% 9%);
  --popover:                hsl(0 0% 100%);
  --popover-foreground:     hsl(222 12% 9%);

  /* Navigation blue — midpoint between Apple #007AFF and Google #1A73E8 */
  --primary:                hsl(214 88% 52%);
  --primary-foreground:     hsl(0 0% 100%);

  --secondary:              hsl(214 20% 95%);
  --secondary-foreground:   hsl(214 40% 22%);

  --muted:                  hsl(220 14% 96%);
  --muted-foreground:       hsl(220 8% 46%);

  --accent:                 hsl(214 100% 95%);
  --accent-foreground:      hsl(214 80% 32%);

  --destructive:            hsl(4 82% 54%);
  --destructive-foreground: hsl(0 0% 100%);

  /* Google Maps route green */
  --success:                hsl(142 68% 40%);
  --success-foreground:     hsl(0 0% 100%);

  --warning:                hsl(38 95% 52%);
  --warning-foreground:     hsl(38 95% 10%);

  --info:                   hsl(200 88% 50%);
  --info-foreground:        hsl(0 0% 100%);

  --border:                 hsl(220 12% 91%);
  --input:                  hsl(220 12% 91%);
  --ring:                   hsl(214 88% 52%);

  /* Always-dark overlay — Google Maps banner is #202124, we use a near-match */
  --overlay:                hsl(220 14% 11%);
  --overlay-foreground:     hsl(0 0% 98%);
}

/* ─── Dark mode — Uber / Google dark map grammar ────────────────────────── */
@media (prefers-color-scheme: dark) {
  :root {
    --background:             hsl(222 18% 7%);        /* Uber-depth dark */
    --foreground:             hsl(0 0% 97%);

    --card:                   hsl(222 14% 12%);
    --card-foreground:        hsl(0 0% 97%);
    --popover:                hsl(222 14% 12%);
    --popover-foreground:     hsl(0 0% 97%);

    /* Lighter nav blue for dark surfaces */
    --primary:                hsl(214 90% 62%);
    --primary-foreground:     hsl(222 18% 7%);

    --secondary:              hsl(222 14% 18%);
    --secondary-foreground:   hsl(0 0% 97%);

    --muted:                  hsl(222 12% 16%);
    --muted-foreground:       hsl(220 8% 58%);

    --accent:                 hsl(214 40% 20%);
    --accent-foreground:      hsl(214 90% 80%);

    --destructive:            hsl(4 76% 58%);
    --destructive-foreground: hsl(0 0% 100%);

    --success:                hsl(142 60% 48%);
    --success-foreground:     hsl(142 70% 8%);

    --warning:                hsl(38 90% 58%);
    --warning-foreground:     hsl(38 90% 10%);

    --info:                   hsl(200 85% 60%);
    --info-foreground:        hsl(222 18% 7%);

    --border:                 hsl(222 12% 19%);
    --input:                  hsl(222 12% 21%);
    --ring:                   hsl(214 90% 62%);

    --overlay:                hsl(220 16% 8%);
    --overlay-foreground:     hsl(0 0% 98%);
  }
}
