import { formatDistance, formatDuration, formatEta } from "@/features/navigation/lib/format-route";
import type { RouteSummary } from "expo-here-maps";
import { Navigation, X } from "lucide-react-native";
import { ActivityIndicator, Pressable, Text, View } from "react-native";
import Animated, { FadeInUp } from "react-native-reanimated";

type RouteSummaryCardProps = {
	summary: RouteSummary;
	isStarting?: boolean;
	onStart: () => void;
	onClear: () => void;
};

/* Google Maps route card — duration as hero number, clean secondary meta */
export function RouteSummaryCard({
	summary,
	isStarting = false,
	onStart,
	onClear,
}: RouteSummaryCardProps) {
	return (
		<Animated.View entering={FadeInUp.duration(220)} className="gap-3">
			{/* Summary — Google Maps style: big duration, small meta, clear X */}
			<View className="flex-row items-center gap-4 rounded-2xl border border-border bg-card px-5 py-4">
				<View className="flex-1 gap-0.5">
					<Text className="text-[32px] font-bold leading-none tracking-tight text-foreground">
						{formatDuration(summary.durationSeconds)}
					</Text>
					<Text className="text-[14px] text-muted-foreground">
						{formatDistance(summary.distanceMeters)}
						{"  ·  Arrive "}
						{formatEta(summary.durationSeconds)}
					</Text>
				</View>

				<Pressable
					onPress={onClear}
					hitSlop={12}
					disabled={isStarting}
					className="active:opacity-50"
				>
					<View className="h-9 w-9 items-center justify-center rounded-full bg-muted">
						<X size={15} className="text-muted-foreground" strokeWidth={2.25} />
					</View>
				</Pressable>
			</View>

			{/* Start — Google Maps green / primary full-bleed pill */}
			<Pressable onPress={onStart} disabled={isStarting} className="active:opacity-90">
				<View className="min-h-[54px] flex-row items-center justify-center gap-2.5 rounded-2xl bg-primary py-4">
					{isStarting ? (
						<ActivityIndicator size="small" color="#fff" />
					) : (
						<Navigation size={19} color="#fff" fill="#fff" />
					)}
					<Text className="text-[16px] font-semibold text-primary-foreground">
						{isStarting ? "Starting…" : "Start navigation"}
					</Text>
				</View>
			</Pressable>
		</Animated.View>
	);
}
