import type React from "react";
import { createContext, useCallback, useContext, useMemo, useRef, useState } from "react";

export type NavPhase = "idle" | "navigating" | "arrived";

type RouteState = {
	phase: NavPhase;
	etaSeconds: number | null;
	remainingMeters: number | null;
	totalMeters: number | null;
	maneuverText: string | null;
	maneuverAction: string | null;
	maneuverDistanceMeters: number | null;
	set: (next: Partial<Omit<RouteState, "set" | "reset" | "stopNavigation" | "registerStopNavigation">>) => void;
	reset: () => void;
	stopNavigation: () => Promise<void>;
	registerStopNavigation: (fn: () => Promise<void>) => void;
};

const INITIAL = {
	phase: "idle" as NavPhase,
	etaSeconds: null as number | null,
	remainingMeters: null as number | null,
	totalMeters: null as number | null,
	maneuverText: null as string | null,
	maneuverAction: null as string | null,
	maneuverDistanceMeters: null as number | null,
};

const RouteContext = createContext<RouteState | null>(null);

export function useRouteState() {
	const ctx = useContext(RouteContext);
	if (!ctx) throw new Error("useRouteState must be used within <RouteStateProvider>");
	return ctx;
}

export function RouteStateProvider({ children }: { children: React.ReactNode }) {
	const [state, setState] = useState(INITIAL);
	const stopRef = useRef<(() => Promise<void>) | null>(null);

	const set = useCallback(
		(next: Partial<typeof INITIAL>) => setState((s) => ({ ...s, ...next })),
		[],
	);

	const reset = useCallback(() => setState(INITIAL), []);

	const registerStopNavigation = useCallback((fn: () => Promise<void>) => {
		stopRef.current = fn;
	}, []);

	const stopNavigation = useCallback(async () => {
		await stopRef.current?.();
	}, []);

	const value = useMemo(
		() => ({ ...state, set, reset, stopNavigation, registerStopNavigation }),
		[state, set, reset, stopNavigation, registerStopNavigation],
	);

	return <RouteContext.Provider value={value}>{children}</RouteContext.Provider>;
}
