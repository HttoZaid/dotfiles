// 500 yards in metres — threshold for showing the secondary turn.
const int _kSecondaryTurnThresholdMeters = 457;

/// Top-of-screen turn instruction banner rendered during [ActiveDrive].
///
/// Primary turn is always visible. Secondary turn appears only when the
/// next-next maneuver is ≤ 500 yards ahead. A translucent overlay announces
/// rerouting without removing the underlying instruction.
class DriveBanner extends ConsumerWidget {
  const DriveBanner({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final phase = ref.watch(navStateNotifierProvider);
    if (phase is! ActiveDrive) return const SizedBox.shrink();

    final progress = ref.watch(driveProgressProvider);

    // Flatten all maneuvers across sections into a single indexed list so we
    // can look up by ManeuverProgress.maneuverIndex (global route index).
    final allManeuvers =
        phase.route.sections.expand((s) => s.maneuvers).toList();

    final maneuverProgress = progress?.maneuverProgress ?? [];

    final primaryMp =
        maneuverProgress.isNotEmpty ? maneuverProgress[0] : null;
    final secondaryMp =
        maneuverProgress.length > 1 ? maneuverProgress[1] : null;

    final primaryManeuver = primaryMp != null
        ? allManeuvers.elementAtOrNull(primaryMp.maneuverIndex)
        : null;

    final showSecondary = secondaryMp != null &&
        secondaryMp.remainingDistanceInMeters <= _kSecondaryTurnThresholdMeters;
    final secondaryManeuver = showSecondary
        ? allManeuvers.elementAtOrNull(secondaryMp.maneuverIndex)
        : null;

    return Material(
      color: ThemeColors.surface,
      elevation: 3,
      shadowColor: const Color(0x28161A20),
      child: SafeArea(
        bottom: false,
        child: Stack(
          children: [
            Padding(
              padding: const EdgeInsets.fromLTRB(
                ThemeSpacing.sp4,
                ThemeSpacing.sp3,
                ThemeSpacing.sp4,
                ThemeSpacing.sp3,
              ),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  _TurnRow(
                    maneuver: primaryManeuver,
                    distanceMeters: primaryMp?.remainingDistanceInMeters,
                    large: true,
                  ),
                  if (showSecondary && secondaryManeuver != null) ...[
                    const SizedBox(height: ThemeSpacing.sp2),
                    _TurnRow(
                      maneuver: secondaryManeuver,
                      distanceMeters: secondaryMp.remainingDistanceInMeters,
                      large: false,
                    ),
                  ],
                ],
              ),
            ),

            // Rerouting overlay — sits over the instruction without
            // collapsing the banner height.
            if (phase.isRerouting)
              Positioned.fill(
                child: ColoredBox(
                  color: ThemeColors.surface.withValues(alpha: 0.92),
                  child: const Center(
                    child: Text(
                      NavStrings.reroutingBanner,
                      style: ThemeText.bodyMedium,
                    ),
                  ),
                ),
              ),
          ],
        ),
      ),
    );
  }
}

// ── Turn row ───────────────────────────────────────────────────────────────

class _TurnRow extends StatelessWidget {
  final Maneuver? maneuver;
  final int? distanceMeters;
  final bool large;

  const _TurnRow({
    required this.maneuver,
    required this.distanceMeters,
    required this.large,
  });

  @override
  Widget build(BuildContext context) {
    final m = maneuver;
    final iconSize = large ? 40.0 : 28.0;
    final labelStyle = large ? ThemeText.headlineMedium : ThemeText.bodyMedium;
    final distStyle = large
        ? ThemeText.titleMedium.copyWith(color: ThemeColors.accent)
        : ThemeText.callout.copyWith(color: ThemeColors.textSecondary);

    return Row(
      crossAxisAlignment: CrossAxisAlignment.center,
      children: [
        // Prefix label for secondary turn.
        if (!large) ...[
          Text(
            NavStrings.thenLabel,
            style: ThemeText.labelSmall.copyWith(
              color: ThemeColors.textTertiary,
            ),
          ),
          const SizedBox(width: ThemeSpacing.sp2),
        ],

        if (m != null)
          Image.asset(
            maneuverIconPath(m.action),
            width: iconSize,
            height: iconSize,
            color: large ? ThemeColors.textPrimary : ThemeColors.textSecondary,
          )
        else
          SizedBox(width: iconSize, height: iconSize),

        const SizedBox(width: ThemeSpacing.sp3),

        Expanded(
          child: Text(
            m?.text ?? '',
            style: labelStyle,
            maxLines: large ? 2 : 1,
            overflow: TextOverflow.ellipsis,
          ),
        ),

        if (distanceMeters != null) ...[
          const SizedBox(width: ThemeSpacing.sp2),
          Text(
            UkFormatter.formatDistance(distanceMeters!),
            style: distStyle,
          ),
        ],
      ],
    );
  }
}
