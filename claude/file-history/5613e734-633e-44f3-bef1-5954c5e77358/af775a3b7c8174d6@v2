class NavPeekContent extends ConsumerWidget {
  final VoidCallback onTap;

  const NavPeekContent({required this.onTap, super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final phase = ref.watch(navStateNotifierProvider);

    return switch (phase) {
      ActiveDrive() => _DrivePeekContent(phase: phase),
      TripOverview() => _TripReadyPeek(phase: phase, onTap: onTap),
      _ => _SearchPeek(onTap: onTap),
    };
  }
}

// ── Drive peek (active turn-by-turn) ───────────────────────────────────────

class _DrivePeekContent extends ConsumerWidget {
  final ActiveDrive phase;

  const _DrivePeekContent({required this.phase});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final progress = ref.watch(driveProgressProvider);
    final totalMeters = phase.route.lengthInMeters;

    // remaining distance / duration from the last section (accumulated total).
    final lastSection = progress?.sectionProgress.lastOrNull;
    final remainingMeters = lastSection?.remainingDistanceInMeters ?? totalMeters;
    final remainingDur    = lastSection?.remainingDuration ?? phase.route.duration;

    final traveledFraction = totalMeters > 0
        ? ((totalMeters - remainingMeters) / totalMeters).clamp(0.0, 1.0)
        : 0.0;

    final eta    = DateTime.now().add(remainingDur);
    final etaStr = TimeOfDay.fromDateTime(eta).format(context);

    final hours = remainingDur.inHours;
    final mins  = remainingDur.inMinutes.remainder(60);
    final durStr = hours > 0 ? '${hours}h ${mins}m' : '$mins min';

    final distStr = UkFormatter.formatDistance(remainingMeters);

    // Checkpoint dots along the progress bar.
    final routeCheckpoints =
        ref.watch(routeCheckpointsProvider).value ?? [];
    final allCheckpoints =
        ref.watch(checkpointNotifierProvider).value?.checkpoints ?? [];

    final checkpointById = {
      for (final c in allCheckpoints) c.id: c,
    };

    final dots = routeCheckpoints
        .where((r) {
          final c = checkpointById[r.checkpointId];
          if (c == null || c.contributions.isEmpty) return false;
          return c.contributions.first.status != ContributionStatusEnum.UNKNOWN;
        })
        .map((r) {
          final c = checkpointById[r.checkpointId]!;
          final status = c.contributions.first.status;
          final fraction = totalMeters > 0
              ? (r.distanceAlongRouteMeters / totalMeters).clamp(0.0, 1.0)
              : 0.0;
          final passed = traveledFraction >= fraction;
          return _CheckpointDot(
            fraction: fraction,
            color: _dotColor(status),
            passed: passed,
          );
        })
        .toList();

    return Padding(
      padding: const EdgeInsets.fromLTRB(
        ThemeSpacing.sp4,
        ThemeSpacing.sp2,
        ThemeSpacing.sp4,
        ThemeSpacing.sp4,
      ),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          // Progress bar with checkpoint dots.
          SizedBox(
            height: 6,
            child: CustomPaint(
              painter: _ProgressBarPainter(
                progress: traveledFraction,
                dots: dots,
              ),
            ),
          ),

          const SizedBox(height: ThemeSpacing.sp2),

          // Info chips + controls in one row.
          Row(
            children: [
              _InfoChip(label: NavStrings.etaLabel,       value: etaStr),
              _InfoChip(label: NavStrings.durationLabel,  value: durStr),
              _InfoChip(label: NavStrings.distanceLabel,  value: distStr),

              const SizedBox(width: ThemeSpacing.sp2),

              // Recenter — only visible when camera is detached.
              if (phase.camera == CameraOwnership.free)
                _IconCta(
                  icon: Icons.my_location,
                  label: NavStrings.recenterCta,
                  color: ThemeColors.accent,
                  onTap: () =>
                      ref.read(navStateNotifierProvider.notifier).recenter(),
                ),

              const SizedBox(width: ThemeSpacing.sp2),

              // End trip.
              _IconCta(
                icon: Icons.close,
                label: NavStrings.endTripCta,
                color: ThemeColors.danger,
                onTap: () =>
                    ref.read(navStateNotifierProvider.notifier).stopDrive(),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Color _dotColor(ContributionStatusEnum status) {
    if (status == ContributionStatusEnum.ACTIVE) return ThemeColors.danger;
    if (status == ContributionStatusEnum.POLICE_ALERT) return ThemeColors.warning;
    return ThemeColors.textDisabled;
  }
}

// ── Search pill (Idle / Searching) ─────────────────────────────────────────

class _SearchPeek extends ConsumerWidget {
  final VoidCallback onTap;

  const _SearchPeek({required this.onTap});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final dest = ref.watch(navSearchNotifierProvider).selectedDest;

    return Padding(
      padding: const EdgeInsets.fromLTRB(
        ThemeSpacing.sp4,
        ThemeSpacing.sp2,
        ThemeSpacing.sp4,
        ThemeSpacing.sp4,
      ),
      child: GestureDetector(
        onTap: onTap,
        child: Container(
          height: 52,
          decoration: BoxDecoration(
            color: ThemeColors.surfaceContainer,
            borderRadius: ThemeRadius.brFull,
          ),
          padding: const EdgeInsets.symmetric(horizontal: ThemeSpacing.sp4),
          child: Row(
            children: [
              const Icon(Icons.search, size: 20, color: ThemeColors.accent),
              const SizedBox(width: ThemeSpacing.sp3),
              Expanded(
                child: Text(
                  dest?.title ?? NavStrings.whereToHint,
                  style: ThemeText.bodyMedium.copyWith(
                    color: dest != null
                        ? ThemeColors.textPrimary
                        : ThemeColors.textTertiary,
                  ),
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                ),
              ),
              if (dest != null)
                const Icon(
                  Icons.chevron_right,
                  size: 18,
                  color: ThemeColors.textTertiary,
                ),
            ],
          ),
        ),
      ),
    );
  }
}

// ── Route-ready banner (TripOverview, drive not yet started) ───────────────

class _TripReadyPeek extends ConsumerWidget {
  final TripOverview phase;
  final VoidCallback onTap;

  const _TripReadyPeek({required this.phase, required this.onTap});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final dest = ref.watch(navSearchNotifierProvider).selectedDest;
    final navNotifier = ref.read(navStateNotifierProvider.notifier);

    return GestureDetector(
      onTap: onTap,
      behavior: HitTestBehavior.translucent,
      child: Padding(
        padding: const EdgeInsets.fromLTRB(
          ThemeSpacing.sp4,
          ThemeSpacing.sp3,
          ThemeSpacing.sp4,
          ThemeSpacing.sp4,
        ),
        child: Row(
          children: [
            const Icon(Icons.route, size: 20, color: ThemeColors.accent),
            const SizedBox(width: ThemeSpacing.sp3),
            Expanded(
              child: Text(
                dest?.title ?? NavStrings.goingToHint,
                style: ThemeText.bodyMedium,
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
              ),
            ),
            const SizedBox(width: ThemeSpacing.sp2),
            OutlinedButton(
              style: OutlinedButton.styleFrom(
                minimumSize: const Size(0, 40),
                padding: const EdgeInsets.symmetric(
                    horizontal: ThemeSpacing.sp3),
              ),
              onPressed: () => navNotifier.closeTrip(),
              child: const Text(NavStrings.closeCta),
            ),
            const SizedBox(width: ThemeSpacing.sp2),
            FilledButton(
              style: FilledButton.styleFrom(
                minimumSize: const Size(0, 40),
                padding: const EdgeInsets.symmetric(
                    horizontal: ThemeSpacing.sp3),
              ),
              onPressed: () => navNotifier.startDrive(phase.route),
              child: const Text(NavStrings.startDriveCta),
            ),
          ],
        ),
      ),
    );
  }
}

