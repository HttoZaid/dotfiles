// ── Progress bar painter ───────────────────────────────────────────────────

class _CheckpointDot {
  final double fraction;
  final Color color;
  final bool passed;

  const _CheckpointDot({
    required this.fraction,
    required this.color,
    required this.passed,
  });
}

class _ProgressBarPainter extends CustomPainter {
  final double progress;
  final List<_CheckpointDot> dots;

  const _ProgressBarPainter({required this.progress, required this.dots});

  @override
  void paint(ui.Canvas canvas, ui.Size size) {
    final rr = RRect.fromRectAndRadius(
      Rect.fromLTWH(0, 0, size.width, size.height),
      const Radius.circular(3),
    );

    // Track.
    canvas.drawRRect(
      rr,
      Paint()..color = ThemeColors.surfaceContainer,
    );

    // Fill.
    if (progress > 0) {
      canvas.drawRRect(
        RRect.fromRectAndRadius(
          Rect.fromLTWH(0, 0, size.width * progress, size.height),
          const Radius.circular(3),
        ),
        Paint()..color = ThemeColors.accent,
      );
    }

    // Checkpoint dots — drawn on top of the track/fill.
    for (final dot in dots) {
      final cx = size.width * dot.fraction;
      final cy = size.height / 2;
      // Passed checkpoints: smaller and muted; upcoming: full size + color.
      final radius = dot.passed ? 2.5 : 4.0;
      final color = dot.passed
          ? ThemeColors.borderStrong
          : dot.color;
      canvas.drawCircle(
        Offset(cx, cy),
        radius,
        Paint()
          ..color = color
          ..style = ui.PaintingStyle.fill,
      );
      // White ring around upcoming dots so they read over the fill/track.
      if (!dot.passed) {
        canvas.drawCircle(
          Offset(cx, cy),
          radius + 1.5,
          Paint()
            ..color = ThemeColors.surface
            ..style = ui.PaintingStyle.stroke
            ..strokeWidth = 1.5,
        );
      }
    }
  }

  @override
  bool shouldRepaint(_ProgressBarPainter old) =>
      old.progress != progress || old.dots != dots;
}
