std::vector<uint8_t> serialize_client_hello(const std::array<uint8_t, 32>& ephermeral_key) {
	WAWebProto::HandshakeMessage handshake_msg;
	WAWebProto::HandshakeMessage::ClientHello client_hello_payload;
	client_hello_payload.set_ephemeral(ephermeral_key.data(), ephermeral_key.size());

	*handshake_msg.mutable_clienthello() = client_hello_payload;
	size_t client_hello_length = handshake_msg.ByteSizeLong();

	std::vector<uint8_t> serialized_payload(client_hello_length);

	if (!handshake_msg.SerializeToArray(serialized_payload.data(), client_hello_length)) {
		throw std::runtime_error("Handshake::serialize_client_hello failed to serialize.");
	}

	return serialized_payload;
}

WAWebProto::HandshakeMessage::ServerHello parse_server_hello(const std::vector<uint8_t>& server_hello_bytes) {
	WAWebProto::HandshakeMessage handshake_msg;
	if (!handshake_msg.ParseFromArray(server_hello_bytes.data(), server_hello_bytes.size())) {
		throw std::runtime_error("Handshake::parse_server_hello failed to parse server hello.");
	}
	return handshake_msg.serverhello();
}

// WhatsApp expects IDs as Big-Endian byte arrays.
std::vector<uint8_t> int_to_bytes(uint32_t val, size_t len) {
	std::vector<uint8_t> res(len);
	for (size_t i = 0; i < len; ++i) {
		res[len - 1 - i] = (val >> (i * 8)) & 0xFF;
	}
	return res;
}

// OpenSSL 3.0 safe MD5 implementation using EVP
std::vector<uint8_t> get_wa_version_hash(const std::string& version_string) {
	std::vector<uint8_t> hash(16); // MD5 digest length
	EVP_MD_CTX* ctx = EVP_MD_CTX_new();
	if (!ctx)
		throw std::runtime_error("Failed to create EVP_MD_CTX");

	if (EVP_DigestInit_ex(ctx, EVP_md5(), nullptr) != 1 || EVP_DigestUpdate(ctx, version_string.data(), version_string.size()) != 1 || EVP_DigestFinal_ex(ctx, hash.data(), nullptr) != 1) {
		EVP_MD_CTX_free(ctx);
		throw std::runtime_error("Failed to compute MD5 hash via EVP API");
	}

	EVP_MD_CTX_free(ctx);
	return hash;
}

std::vector<uint8_t> build_registration_payload_bytes(std::shared_ptr<Store::SessionStore>& store) {
	auto reg_id_opt = store->get_registration_id();
	auto ident_opt = store->get_identity_key_pair();
	auto spk_opt = store->get_signed_pre_key();

	if (!reg_id_opt || !ident_opt || !spk_opt) {
		throw std::runtime_error("Cannot serialize payload: Store is missing crypto material.");
	}

	const std::string wa_version_str = "2.3000.1041443661";
	const uint32_t v_primary = 2;
	const uint32_t v_secondary = 3000;
	const uint32_t v_tertiary = 1041443661;

	WAWebProto::ClientPayload client_payload;
	client_payload.set_passive(false);
	client_payload.set_pull(false);
	client_payload.set_connecttype(WAWebProto::ClientPayload_ConnectType_WIFI_UNKNOWN);
	client_payload.set_connectreason(WAWebProto::ClientPayload_ConnectReason_USER_ACTIVATED);

	auto* user_agent = client_payload.mutable_useragent();
	user_agent->set_platform(WAWebProto::ClientPayload_UserAgent_Platform_WEB);
	user_agent->set_releasechannel(WAWebProto::ClientPayload_UserAgent_ReleaseChannel_RELEASE);
	user_agent->set_mcc("000");
	user_agent->set_mnc("000");
	user_agent->set_osversion("0.1");
	user_agent->set_manufacturer("");
	user_agent->set_device("Desktop");
	user_agent->set_osbuildnumber("0.1");
	user_agent->set_localelanguageiso6391("en");
	user_agent->set_localecountryiso31661alpha2("GB");

	auto* app_version = user_agent->mutable_appversion();
	app_version->set_primary(v_primary);
	app_version->set_secondary(v_secondary);
	app_version->set_tertiary(v_tertiary);

	auto* web_info = client_payload.mutable_webinfo();
	web_info->set_websubplatform(WAWebProto::ClientPayload_WebInfo_WebSubPlatform_WEB_BROWSER);

	auto* pairing_data = client_payload.mutable_devicepairingdata();

	std::vector<uint8_t> reg_id_bytes = int_to_bytes(reg_id_opt.value(), 4);
	pairing_data->set_eregid(reg_id_bytes.data(), reg_id_bytes.size());

	std::vector<uint8_t> key_type = int_to_bytes(5, 1);
	pairing_data->set_ekeytype(key_type.data(), key_type.size());

	pairing_data->set_eident(ident_opt.value().pub_key.data(), ident_opt.value().pub_key.size());

	std::vector<uint8_t> spk_id_bytes = int_to_bytes(spk_opt.value().id, 3);
	pairing_data->set_eskeyid(spk_id_bytes.data(), spk_id_bytes.size());

	pairing_data->set_eskeyval(spk_opt.value().key_pair.pub_key.data(), spk_opt.value().key_pair.pub_key.size());
	pairing_data->set_eskeysig(spk_opt.value().signature.data(), spk_opt.value().signature.size());

	WAWebProto::DeviceProps device_props;
	device_props.set_os("Linux");
	device_props.set_platformtype(WAWebProto::DeviceProps_PlatformType_CHROME);
	device_props.set_requirefullsync(false);

	auto* sync_config = device_props.mutable_historysyncconfig();
	sync_config->set_inlineinitialpayloadine2eemsg(true);
	sync_config->set_supportbotuseragentchathistory(true);
	sync_config->set_supportcagreactionsandpolls(true);
	sync_config->set_supportrecentsyncchunkmessagecounttuning(true);
	sync_config->set_supporthostedgroupmsg(true);
	sync_config->set_supportbizhostedmsg(true);
	sync_config->set_supportfbidbotchathistory(true);
	sync_config->set_supportmessageassociation(true);
	sync_config->set_supportcallloghistory(false);
	sync_config->set_supportgrouphistory(true);
	sync_config->set_thumbnailsyncdayslimit(60);
	sync_config->set_supportmanushistory(true);
	sync_config->set_supporthatchhistory(true);
	sync_config->set_storagequotamb(6149);

	std::string device_props_bytes;
	if (!device_props.SerializeToString(&device_props_bytes)) {
		throw std::runtime_error("Failed to serialize DeviceProps");
	}
	pairing_data->set_deviceprops(device_props_bytes);

	std::vector<uint8_t> md5_hash = get_wa_version_hash(wa_version_str);
	pairing_data->set_buildhash(md5_hash.data(), md5_hash.size());

	std::string payload_bytes;
	if (!client_payload.SerializeToString(&payload_bytes)) {
		throw std::runtime_error("Failed to serialize ClientPayload");
	}

	return std::vector<uint8_t>(payload_bytes.begin(), payload_bytes.end());
}

int make_registration_id() {
	int x = 16380u;
	std::srand(std::time(nullptr));
	return std::rand() % x;
}

