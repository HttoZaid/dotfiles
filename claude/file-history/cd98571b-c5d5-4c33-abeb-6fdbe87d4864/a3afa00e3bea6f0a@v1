Handshake::Handshake(Network::Socket& socket, std::shared_ptr<Store::SessionStore>& store)
    : m_socket(socket)
    , m_store(store) { }

SessionKeys Handshake::start() {
	// 1. Pull the master Identity Key.
	auto ident_opt = m_store->get_identity_key_pair();
	if (!ident_opt.has_value()) {
		throw std::runtime_error("Cannot start handshake: Identity Key missing from store.");
	}

	// 2. The Identity Key IS the Noise Static Key. Map it over.
	crypto::KeyPair static_key_pair;
	static_key_pair.pub_key = ident_opt.value().pub_key;
	static_key_pair.priv_key = ident_opt.value().priv_key;

	// 3. Start Noise
	m_noise_state.start(m_noise_xx, m_prologue);

	crypto::KeyPair key_pair = crypto::generate_key_pair();

	std::vector<uint8_t> pub_key_vec { key_pair.pub_key.begin(), key_pair.pub_key.end() };
	m_noise_state.authenticate(pub_key_vec);

	std::vector<uint8_t> client_hello = Payload::Handshake::serialize_client_hello(key_pair.pub_key);
	frame_and_send(client_hello);

	std::vector<uint8_t> server_hello_buff = read_frame();
	auto server_hello = Payload::Handshake::parse_server_hello(server_hello_buff);

	std::vector<uint8_t> server_ephemeral { server_hello.ephemeral().begin(), server_hello.ephemeral().end() };
	m_noise_state.authenticate(server_ephemeral);

	std::vector<uint8_t> priv_key_vec { key_pair.priv_key.begin(), key_pair.priv_key.end() };
	std::vector<uint8_t> shared_secret = Crypto::ecdh(server_ephemeral, priv_key_vec);
	m_noise_state.mix_into_key(shared_secret);

	std::vector<uint8_t> server_static_bytes { server_hello.static_().begin(), server_hello.static_().end() };
	std::vector<uint8_t> server_static_key = m_noise_state.decrypt(server_static_bytes);
	std::vector<uint8_t> second_shared_secret = Crypto::ecdh(server_static_key, priv_key_vec);
	m_noise_state.mix_into_key(second_shared_secret);

	std::vector<uint8_t> encrypted_payload { server_hello.payload().begin(), server_hello.payload().end() };
	std::vector<uint8_t> decrypted_payload = m_noise_state.decrypt(encrypted_payload);

	// Fixed the pointer/dot notation here
	std::vector<uint8_t> static_pub_key { static_key_pair.pub_key.begin(), static_key_pair.pub_key.end() };
	std::vector<uint8_t> static_priv_key { static_key_pair.priv_key.begin(), static_key_pair.priv_key.end() };

	auto static_key = m_noise_state.encrypt(static_pub_key);
	std::vector<uint8_t> third_shared_secret = Crypto::ecdh(server_ephemeral, static_priv_key);
	m_noise_state.mix_into_key(third_shared_secret);

	std::vector<uint8_t> raw_client_payload = Payload::Handshake::build_registration_payload_bytes(m_store);
	std::vector<uint8_t> encrypted_client_payload = m_noise_state.encrypt(raw_client_payload);

	// Wrap both ciphertexts into the HandshakeMessage::ClientFinish protobuf
	WAWebProto::HandshakeMessage handshake_msg;
	WAWebProto::HandshakeMessage::ClientFinish* client_finish = handshake_msg.mutable_clientfinish();

	client_finish->set_static_(static_key.data(), static_key.size());
	client_finish->set_payload(encrypted_client_payload.data(), encrypted_client_payload.size());

	std::string final_bytes;
	if (!handshake_msg.SerializeToString(&final_bytes)) {
		throw std::runtime_error("Failed to serialize final HandshakeMessage");
	}

	std::vector<uint8_t> client_finish_bytes(final_bytes.begin(), final_bytes.end());
	frame_and_send(client_finish_bytes);

	std::vector<uint8_t> finish_payload = read_frame();
	std::cout << "This is the result ? : " << finish_payload.size() << "\n";

	// Return your session keys (assuming you extract them from Noise state here later)
	return { };
}

void Handshake::frame_and_send(const std::vector<uint8_t>& payload) {
	auto wire_frame = Network::Framing::encode(payload);

	if (m_is_start) {
		wire_frame.insert(wire_frame.begin(), m_prologue.begin(), m_prologue.end());
		m_is_start = false;
	}

	m_socket.write(wire_frame);
	std::cout << "Writing " << wire_frame.size() << " bytes to socket. \n";
}

std::vector<uint8_t> Handshake::read_frame() {
	std::vector<uint8_t> header = m_socket.read_exact(3);
	size_t length_read = (header[0] << 16) | (header[1] << 8) | header[2];

	std::vector<uint8_t> buffer = m_socket.read_exact(length_read);
	return buffer;
}

