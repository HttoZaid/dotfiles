static void verify_server_cert(
    const std::vector<uint8_t>& cert_plaintext,
    const std::vector<uint8_t>& server_static_key) {

	static const std::array<uint8_t, 32> WA_CERT_PUB_KEY = {
		0x14, 0x23, 0x75, 0x57, 0x4d, 0x0a, 0x58, 0x71,
		0x66, 0xaa, 0xe7, 0x1e, 0xbe, 0x51, 0x64, 0x37,
		0xc4, 0xa2, 0x8b, 0x73, 0xe3, 0x69, 0x5c, 0x6c,
		0xe1, 0xf7, 0xf9, 0x54, 0x5d, 0xa8, 0xee, 0x6b
	};

	WAWebProto::CertChain cert_chain;
	if (!cert_chain.ParseFromArray(cert_plaintext.data(), static_cast<int>(cert_plaintext.size())))
		throw std::runtime_error("Failed to parse server CertChain");

	const auto& inter = cert_chain.intermediate();
	const auto& leaf  = cert_chain.leaf();

	if (!inter.has_details() || !inter.has_signature() || !leaf.has_details() || !leaf.has_signature())
		throw std::runtime_error("Missing parts of noise certificate");

	const std::string& inter_det_raw = inter.details();
	const std::string& inter_sig_raw = inter.signature();
	const std::string& leaf_det_raw  = leaf.details();
	const std::string& leaf_sig_raw  = leaf.signature();

	if (inter_sig_raw.size() != 64 || leaf_sig_raw.size() != 64)
		throw std::runtime_error("Bad cert signature length");

	if (!crypto::xeddsa_verify(
	        WA_CERT_PUB_KEY,
	        reinterpret_cast<const uint8_t*>(inter_det_raw.data()), inter_det_raw.size(),
	        reinterpret_cast<const uint8_t*>(inter_sig_raw.data())))
		throw std::runtime_error("Intermediate cert signature invalid");

	WAWebProto::CertChain_NoiseCertificate_Details inter_det;
	if (!inter_det.ParseFromString(inter_det_raw))
		throw std::runtime_error("Failed to parse intermediate cert details");

	if (inter_det.key().size() != 32)
		throw std::runtime_error("Intermediate cert key wrong length");

	std::array<uint8_t, 32> inter_key;
	std::copy(inter_det.key().begin(), inter_det.key().end(), inter_key.begin());

	if (!crypto::xeddsa_verify(
	        inter_key,
	        reinterpret_cast<const uint8_t*>(leaf_det_raw.data()), leaf_det_raw.size(),
	        reinterpret_cast<const uint8_t*>(leaf_sig_raw.data())))
		throw std::runtime_error("Leaf cert signature invalid");

	WAWebProto::CertChain_NoiseCertificate_Details leaf_det;
	if (!leaf_det.ParseFromString(leaf_det_raw))
		throw std::runtime_error("Failed to parse leaf cert details");

	if (leaf_det.issuerserial() != inter_det.serial())
		throw std::runtime_error("Leaf issuer serial mismatch");

	std::vector<uint8_t> leaf_key(leaf_det.key().begin(), leaf_det.key().end());
	if (leaf_key != server_static_key)
		throw std::runtime_error("Leaf cert key doesn't match server static key");
}

Handshake::Handshake(Network::Socket& socket, std::shared_ptr<Store::SessionStore>& store)
    : m_socket(socket)
    , m_store(store) { }

SessionKeys Handshake::start() {
	auto noise_opt = m_store->get_noise_key_pair();
	if (!noise_opt.has_value())
		throw std::runtime_error("Cannot start handshake: Noise key missing from store.");

	std::vector<uint8_t> noise_pub  { noise_opt->pub_key.begin(),  noise_opt->pub_key.end()  };
	std::vector<uint8_t> noise_priv { noise_opt->priv_key.begin(), noise_opt->priv_key.end() };

	m_noise_state.start(m_noise_xx, m_prologue);

	crypto::KeyPair ephemeral = crypto::generate_key_pair();
	std::vector<uint8_t> eph_pub  { ephemeral.pub_key.begin(),  ephemeral.pub_key.end()  };
	std::vector<uint8_t> eph_priv { ephemeral.priv_key.begin(), ephemeral.priv_key.end() };

	m_noise_state.authenticate(eph_pub);

	std::vector<uint8_t> client_hello = Payload::Handshake::serialize_client_hello(ephemeral.pub_key);
	frame_and_send(client_hello);

	std::vector<uint8_t> server_hello_buff = read_frame();
	auto server_hello = Payload::Handshake::parse_server_hello(server_hello_buff);

	std::vector<uint8_t> server_ephemeral { server_hello.ephemeral().begin(), server_hello.ephemeral().end() };
	m_noise_state.authenticate(server_ephemeral);

	// ECDH 1: client ephemeral × server ephemeral
	std::vector<uint8_t> shared1 = Crypto::ecdh(server_ephemeral, eph_priv);
	m_noise_state.mix_into_key(shared1);

	// Decrypt server static key
	std::vector<uint8_t> server_static_enc { server_hello.static_().begin(), server_hello.static_().end() };
	std::vector<uint8_t> server_static_key = m_noise_state.decrypt(server_static_enc);

	// ECDH 2: client ephemeral × server static
	std::vector<uint8_t> shared2 = Crypto::ecdh(server_static_key, eph_priv);
	m_noise_state.mix_into_key(shared2);

	// Decrypt and verify the server certificate payload
	std::vector<uint8_t> cert_enc { server_hello.payload().begin(), server_hello.payload().end() };
	std::vector<uint8_t> cert_plain = m_noise_state.decrypt(cert_enc);
	verify_server_cert(cert_plain, server_static_key);

	// Encrypt our Noise static (noise) public key
	auto encrypted_noise_pub = m_noise_state.encrypt(noise_pub);

	// ECDH 3: noise static × server ephemeral
	std::vector<uint8_t> shared3 = Crypto::ecdh(server_ephemeral, noise_priv);
	m_noise_state.mix_into_key(shared3);

	std::vector<uint8_t> raw_payload = Payload::Handshake::build_registration_payload_bytes(m_store);
	std::vector<uint8_t> enc_payload = m_noise_state.encrypt(raw_payload);

	WAWebProto::HandshakeMessage handshake_msg;
	auto* client_finish = handshake_msg.mutable_clientfinish();
	client_finish->set_static_(encrypted_noise_pub.data(), encrypted_noise_pub.size());
	client_finish->set_payload(enc_payload.data(), enc_payload.size());

	std::string final_bytes;
	if (!handshake_msg.SerializeToString(&final_bytes))
		throw std::runtime_error("Failed to serialize ClientFinish");

	std::vector<uint8_t> client_finish_bytes(final_bytes.begin(), final_bytes.end());
	frame_and_send(client_finish_bytes);

	std::vector<uint8_t> finish_payload = read_frame();
	std::cout << "Server finish response: " << finish_payload.size() << " bytes\n";

	return { };
}

void Handshake::frame_and_send(const std::vector<uint8_t>& payload) {
	auto wire_frame = Network::Framing::encode(payload);

	if (m_is_start) {
		wire_frame.insert(wire_frame.begin(), m_prologue.begin(), m_prologue.end());
		m_is_start = false;
	}

	m_socket.write(wire_frame);
	std::cout << "Writing " << wire_frame.size() << " bytes to socket. \n";
}

std::vector<uint8_t> Handshake::read_frame() {
	std::vector<uint8_t> header = m_socket.read_exact(3);
	size_t length_read = (header[0] << 16) | (header[1] << 8) | header[2];

	std::vector<uint8_t> buffer = m_socket.read_exact(length_read);
	return buffer;
}

