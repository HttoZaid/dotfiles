#pragma once

#include "../crypto/crypto.hpp"
#include <cstdint>
#include <optional>

namespace WAWP::Store {

class SessionStore {
public:
	virtual ~SessionStore() = default;

	virtual std::optional<Crypto::KeyPair> get_noise_key_pair() = 0;
	virtual void set_noise_key_pair(const Crypto::KeyPair& key_pair) = 0;
	// 1. The Registration ID (Random 31-bit int)
	virtual std::optional<uint32_t> get_registration_id() = 0;
	virtual void set_registration_id(uint32_t reg_id) = 0;

	// 2. The Master Identity (Holds the DH keys + the 64-byte sign key for libsodium)
	virtual std::optional<Crypto::IdentityKeyPair> get_identity_key_pair() = 0;
	virtual void set_identity_key_pair(const Crypto::IdentityKeyPair& identity) = 0;

	// 3. The Signed PreKey (Rotated periodically)
	virtual std::optional<Crypto::SignedPreKey> get_signed_pre_key() = 0;
	virtual void set_signed_pre_key(const Crypto::SignedPreKey& spk) = 0;

	// Note: Later, you'll need to store arrays of One-Time PreKeys.
	// Those are standard DH keys, so they'll just use Crypto::KeyPair.
};

} // namespace WAWP::Store
