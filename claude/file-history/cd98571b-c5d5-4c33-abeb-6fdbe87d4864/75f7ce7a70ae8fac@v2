#include "noise_state.hpp"
#include "../crypto/crypto.hpp"
#include <algorithm>
#include <array>
#include <vector>

namespace WAWP::Protocol {

NoiseState::NoiseState() {
}

void NoiseState::start(const std::array<uint8_t, 32>& noise_pattern, const std::array<uint8_t, 4>& prologue) {
	std::vector<uint8_t> hash { noise_pattern.begin(), noise_pattern.end() };

	m_hash = hash;
	m_chaining_key = hash;

	std::vector<uint8_t> prologue_vec { prologue.begin(), prologue.end() };
	authenticate(prologue_vec);
}

void NoiseState::authenticate(const std::vector<uint8_t>& payload) {
	std::vector<uint8_t> joined_array { m_hash.begin(), m_hash.end() };
	joined_array.insert(joined_array.end(), payload.begin(), payload.end());

	std::array<uint8_t, 32> hash = Crypto::hash_sha256(joined_array);

	std::copy(hash.begin(), hash.end(), m_hash.begin());
}

void NoiseState::mix_into_key(const std::vector<uint8_t>& secret) {
	m_nonce = 0;

	auto [new_chaining_key, new_message_key] = Crypto::hkdf_sha256(m_chaining_key, secret, "");

	m_chaining_key = new_chaining_key;
	m_message_key = new_message_key;
}

std::vector<uint8_t> NoiseState::decrypt(const std::vector<uint8_t>& ciphertext) {
	std::array<uint8_t, 12> iv = { 0 };
	for (int i = 0; i < 8; ++i) {
		iv[11 - i] = (m_nonce >> (8 * i)) & 0xFF;
	}
	m_nonce++;

	std::vector<uint8_t> plaintext = Crypto::aes_256_gcm_decrypt(
	    m_message_key,
	    iv,
	    ciphertext,
	    m_hash);

	authenticate(ciphertext);

	return plaintext;
}

std::vector<uint8_t> NoiseState::encrypt(const std::vector<uint8_t>& plaintext) {
	std::array<uint8_t, 12> iv = { 0 };
	for (int i = 0; i < 8; ++i) {
		iv[11 - i] = (m_nonce >> (8 * i)) & 0xFF;
	}
	m_nonce++;

	std::vector<uint8_t> ciphertext = Crypto::aes_256_gcm_encrypt(
	    m_message_key,
	    iv,
	    plaintext,
	    m_hash);

	authenticate(ciphertext);

	return ciphertext;
}

SessionKeys NoiseState::finish() {
	std::vector<uint8_t> empty_ikm = { };

	auto [first_half, second_half] = Crypto::hkdf_sha256(m_chaining_key, empty_ikm, "");

	SessionKeys keys;
	keys.write_key = first_half;
	keys.read_key = second_half;

	return keys;
}

}
