KeyPair generate_key_pair() {
	if (sodium_init() < 0) {
		throw std::runtime_error("Crypto::generate_key_pair failed: Sodium init failed.");
	}

	KeyPair key_pair;

	crypto_box_keypair(key_pair.pub_key.data(), key_pair.priv_key.data());
	return key_pair;
};

std::array<uint8_t, 32> hash_sha256(const std::vector<uint8_t>& payload) {
	if (sodium_init() < 0) {
		throw std::runtime_error("Crypto::hash_sha256 failed: Sodium init failed.");
	}

	std::array<uint8_t, 32> hash;

	if (crypto_hash_sha256(hash.data(), payload.data(), payload.size()) < 0) {
		throw std::runtime_error("Crypto::hash_sha256 failed to hash payload.");
	}

	return hash;
};

std::vector<uint8_t> ecdh(
    const std::vector<uint8_t>& server_pub_key,
    const std::vector<uint8_t>& our_priv_key) {
	if (sodium_init() < 0) {
		throw std::runtime_error("Crypto::ecdh failed: Sodium init failed.");
	}

	std::vector<uint8_t> shared_secret(crypto_scalarmult_BYTES);

	if (crypto_scalarmult(shared_secret.data(), our_priv_key.data(), server_pub_key.data()) != 0) {
		throw std::runtime_error("Curve25519: Invalid public key (weak key rejected)");
	}

	return shared_secret;
};

std::pair<std::vector<uint8_t>, std::vector<uint8_t>> hkdf_sha256(
    const std::vector<uint8_t>& salt,
    const std::vector<uint8_t>& ikm,
    const std::string& info) {

	EVP_KDF* kdf = EVP_KDF_fetch(nullptr, "HKDF", nullptr);
	if (!kdf)
		throw std::runtime_error("Failed to fetch HKDF");

	EVP_KDF_CTX* kctx = EVP_KDF_CTX_new(kdf);
	EVP_KDF_free(kdf);
	if (!kctx)
		throw std::runtime_error("Failed to create context");

	OSSL_PARAM params[5];
	params[0] = OSSL_PARAM_construct_utf8_string(OSSL_KDF_PARAM_DIGEST, (char*)"SHA256", 0);

	const uint8_t dummy = 0;
	const uint8_t* salt_ptr = salt.empty() ? &dummy : salt.data();
	const uint8_t* info_ptr = info.empty() ? &dummy : reinterpret_cast<const uint8_t*>(info.data());

	params[1] = OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_SALT, (void*)salt_ptr, salt.size());
	params[2] = OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_KEY, (void*)ikm.data(), ikm.size());
	params[3] = OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_INFO, (void*)info_ptr, info.size());
	params[4] = OSSL_PARAM_construct_end();

	std::vector<uint8_t> out(64);
	if (EVP_KDF_derive(kctx, out.data(), out.size(), params) <= 0) {
		EVP_KDF_CTX_free(kctx);
		throw std::runtime_error("HKDF derivation failed");
	}

	EVP_KDF_CTX_free(kctx);

	std::vector<uint8_t> part1(out.begin(), out.begin() + 32);
	std::vector<uint8_t> part2(out.begin() + 32, out.end());

	return { part1, part2 };
}

std::vector<uint8_t> aes_256_gcm_decrypt(
    const std::vector<uint8_t>& key,
    const std::array<uint8_t, 12>& iv,
    const std::vector<uint8_t>& ciphertext,
    const std::vector<uint8_t>& aad) {
	if (ciphertext.size() < 16) {
		throw std::runtime_error("Ciphertext too small for AES-GCM tag");
	}
	size_t encrypted_len = ciphertext.size() - 16;

	EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
	if (!ctx)
		throw std::runtime_error("Failed to create EVP_CIPHER_CTX");

	EVP_DecryptInit_ex(ctx, EVP_aes_256_gcm(), nullptr, nullptr, nullptr);
	EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, 12, nullptr);
	EVP_DecryptInit_ex(ctx, nullptr, nullptr, key.data(), iv.data());

	int len;
	EVP_DecryptUpdate(ctx, nullptr, &len, aad.data(), aad.size());

	std::vector<uint8_t> plaintext(encrypted_len);
	EVP_DecryptUpdate(ctx, plaintext.data(), &len, ciphertext.data(), encrypted_len);

	EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_TAG, 16, (void*)(ciphertext.data() + encrypted_len));
	int ret = EVP_DecryptFinal_ex(ctx, plaintext.data() + len, &len);
	EVP_CIPHER_CTX_free(ctx);

	if (ret <= 0) {
		throw std::runtime_error("AES-GCM Decryption failed (Bad Tag or Wrong Key)");
	}

	return plaintext;
}

std::vector<uint8_t> aes_256_gcm_encrypt(
    const std::vector<uint8_t>& key,
    const std::array<uint8_t, 12>& iv,
    const std::vector<uint8_t>& plaintext,
    const std::vector<uint8_t>& aad) {
	EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
	if (!ctx)
		throw std::runtime_error("Failed to create EVP_CIPHER_CTX");

	EVP_EncryptInit_ex(ctx, EVP_aes_256_gcm(), nullptr, nullptr, nullptr);
	EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, 12, nullptr);
	EVP_EncryptInit_ex(ctx, nullptr, nullptr, key.data(), iv.data());

	int len;
	EVP_EncryptUpdate(ctx, nullptr, &len, aad.data(), aad.size());

	std::vector<uint8_t> ciphertext(plaintext.size() + 16);

	EVP_EncryptUpdate(ctx, ciphertext.data(), &len, plaintext.data(), plaintext.size());
	int ciphertext_len = len;

	EVP_EncryptFinal_ex(ctx, ciphertext.data() + len, &len);
	ciphertext_len += len;

	EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_GET_TAG, 16, ciphertext.data() + ciphertext_len);

	EVP_CIPHER_CTX_free(ctx);
	return ciphertext;
}

IdentityKeyPair generate_identity_key_pair() {
	IdentityKeyPair kp;
	std::array<uint8_t, 32> ed_pub;

	// 1. Generate the underlying Ed25519 signing pair
	crypto_sign_keypair(ed_pub.data(), kp.sign_key.data());

	// 2. Convert to Curve25519 for standard Diffie-Hellman operations
	crypto_sign_ed25519_pk_to_curve25519(kp.pub_key.data(), ed_pub.data());
	crypto_sign_ed25519_sk_to_curve25519(kp.priv_key.data(), kp.sign_key.data());

	return kp;
}

SignedPreKey generate_signed_pre_key(const IdentityKeyPair& identity, uint32_t pre_key_id) {
	SignedPreKey spk;
	spk.id = pre_key_id;

	// 1. Generate the fresh Curve25519 PreKey
	spk.key_pair = generate_key_pair();

	// 2. Sign the PreKey's PUBLIC key using the Identity's Ed25519 SECRET key
	unsigned long long sig_len;
	crypto_sign_detached(
	    spk.signature.data(),
	    &sig_len,
	    spk.key_pair.pub_key.data(),
	    spk.key_pair.pub_key.size(),
	    identity.sign_key.data());

	return spk;
}

