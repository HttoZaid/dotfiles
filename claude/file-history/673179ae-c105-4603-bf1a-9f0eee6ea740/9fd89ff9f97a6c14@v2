package com.example.ukcheckpoints_app

import android.Manifest
import android.content.Context
import android.content.pm.PackageManager
import android.location.Location
import android.location.LocationListener
import android.location.LocationManager
import android.os.Build
import android.os.Looper
import androidx.annotation.MainThread
import androidx.core.content.ContextCompat
import io.flutter.plugin.common.EventChannel

/**
 * Streams raw GPS fixes directly from [LocationManager.GPS_PROVIDER].
 *
 * Why not FusedLocationProviderClient or forceLocationManager?
 * On Android 12+ the LocationManagerClient in geolocator_android always
 * selects LocationManager.FUSED_PROVIDER first, which has the same 5 s
 * batching floor as FLPC.  Requesting GPS_PROVIDER here bypasses every
 * fused layer and lets the hardware (e.g. Snapdragon 8 Gen 2) deliver
 * fixes at the rate it actually supports — typically 1–5 Hz.
 *
 * TODO: replace "com.example" with your real reverse domain before
 *       publishing to Play Store.
 */
class GpsChannel(private val context: Context) : EventChannel.StreamHandler {

    companion object {
        // Keep in sync with gps_channel.dart
        const val CHANNEL_NAME = "com.example.ukcheckpoints_app/gps"
        private const val DEFAULT_INTERVAL_MS = 200L
    }

    private var locationManager: LocationManager? = null
    private var listener: LocationListener? = null

    @MainThread
    override fun onListen(arguments: Any?, events: EventChannel.EventSink) {
        if (!hasPermission()) {
            events.error("PERMISSION_DENIED", "ACCESS_FINE_LOCATION not granted", null)
            return
        }

        val lm = context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
        locationManager = lm

        if (!lm.isProviderEnabled(LocationManager.GPS_PROVIDER)) {
            events.error("GPS_UNAVAILABLE", "GPS is disabled on the device", null)
            return
        }

        val intervalMs = (arguments as? Map<*, *>)
            ?.get("intervalMs") as? Long
            ?: DEFAULT_INTERVAL_MS

        val locationListener = object : LocationListener {
            override fun onLocationChanged(loc: Location) {
                events.success(loc.toMap())
            }

            override fun onProviderDisabled(provider: String) {
                events.error("GPS_DISABLED", "GPS provider was turned off", null)
            }

            // onProviderEnabled: no-op — fixes resume automatically
            // onStatusChanged: removed in API 29, safe to omit
        }
        listener = locationListener

        @Suppress("MissingPermission")
        lm.requestLocationUpdates(
            LocationManager.GPS_PROVIDER,
            intervalMs,
            0f,
            locationListener,
            Looper.getMainLooper(),
        )
    }

    @MainThread
    override fun onCancel(arguments: Any?) {
        listener?.let { locationManager?.removeUpdates(it) }
        listener = null
        locationManager = null
    }

    private fun hasPermission() =
        ContextCompat.checkSelfPermission(
            context,
            Manifest.permission.ACCESS_FINE_LOCATION,
        ) == PackageManager.PERMISSION_GRANTED

    @Suppress("DEPRECATION")
    private fun Location.toMap(): Map<String, Any> = mapOf(
        "latitude"  to latitude,
        "longitude" to longitude,
        "accuracy"  to accuracy.toDouble(),
        "altitude"  to altitude,
        "speed"     to if (hasSpeed()) speed.toDouble() else -1.0,
        "heading"   to if (hasBearing()) bearing.toDouble() else -1.0,
        "time"      to time.toDouble(),
        // isMock replaces isFromMockProvider on API 31+
        "isMocked"  to if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S)
                            isMock
                        else
                            isFromMockProvider,
    )
}
