  // ── Route preview ──────────────────────────────────────────────────────────

  Future<void> showRoute(Route route) async {
    final controller = state;
    if (controller == null) return;

    clearRoute();

    // Polyline: 24px blue with 6px white outline (physical pixels;
    // ~8dp on a 3× screen — same weight as Google Maps route line).
    final lineWidth = MapMeasureDependentRenderSize.withSingleSize(
      RenderSizeUnit.pixels,
      24,
    );
    final outlineWidth = MapMeasureDependentRenderSize.withSingleSize(
      RenderSizeUnit.pixels,
      6,
    );
    final rep = MapPolylineSolidRepresentation.withOutline(
      lineWidth,
      const ui.Color(0xFF3E5BFF),
      outlineWidth,
      Colors.white,
      LineCap.round,
    );
    final polyline = MapPolyline.withRepresentation(route.geometry, rep);
    controller.mapScene.addMapPolyline(polyline);
    _routePolyline = polyline;

    // Origin (blue) + dest (red) circle markers.
    final verts = route.geometry.vertices;
    if (verts.isNotEmpty) {
      final originImg = await _circlePng(const ui.Color(0xFF3E5BFF), 20);
      final destImg   = await _circlePng(const ui.Color(0xFFE63946), 24);

      // State may have been cleared while we awaited the PNG renders.
      if (state == null) return;

      final originMarker = MapMarker(verts.first, originImg);
      final destMarker   = MapMarker(verts.last,  destImg);
      controller.mapScene.addMapMarker(originMarker);
      controller.mapScene.addMapMarker(destMarker);
      _routeOriginMarker = originMarker;
      _routeDestMarker   = destMarker;
    }

    // Fit camera to the route bounding box (north-up, no tilt).
    controller.camera.applyUpdate(
      MapCameraUpdateFactory.lookAtArea(route.boundingBox),
    );
  }

  void clearRoute() {
    final controller = state;
    if (controller == null) return;

    if (_routePolyline != null) {
      controller.mapScene.removeMapPolyline(_routePolyline!);
      _routePolyline = null;
    }
    if (_routeOriginMarker != null) {
      controller.mapScene.removeMapMarker(_routeOriginMarker!);
      _routeOriginMarker = null;
    }
    if (_routeDestMarker != null) {
      controller.mapScene.removeMapMarker(_routeDestMarker!);
      _routeDestMarker = null;
    }
  }

  // Renders a filled circle with a white halo as a PNG MapImage.
  Future<MapImage> _circlePng(ui.Color color, double size) async {
    final recorder = ui.PictureRecorder();
    final canvas   = ui.Canvas(recorder);
    final half     = size / 2;
    canvas
      ..drawCircle(
        ui.Offset(half, half),
        half,
        ui.Paint()..color = const ui.Color(0xFFFFFFFF),
      )
      ..drawCircle(
        ui.Offset(half, half),
        half - 2,
        ui.Paint()..color = color,
      );
    final picture = recorder.endRecording();
    final img     = await picture.toImage(size.toInt(), size.toInt());
    final bd      = await img.toByteData(format: ui.ImageByteFormat.png);
    return MapImage.withPixelDataAndImageFormat(
      bd!.buffer.asUint8List(),
      ImageFormat.png,
    );
  }

  // ── Route checkpoint markers ───────────────────────────────────────────────

  // Replaces any existing route checkpoint markers with markers for the given
  // checkpoints. Called when routeCheckpointsProvider resolves.
  void showRouteCheckpoints(
    List<Checkpoint> checkpoints,
    Map<ContributionStatusEnum, MapImage> icons,
  ) {
    final controller = state;
    if (controller == null) return;

    clearRouteCheckpoints();

    final toAdd = <MapMarker>[];
    for (final checkpoint in checkpoints) {
      final marker = _buildMarker(checkpoint, icons);
      toAdd.add(marker);
      _routeCheckpointMarkers[checkpoint.id] = marker;
    }
    if (toAdd.isNotEmpty) {
      controller.mapScene.addMapMarkers(toAdd);
    }
  }

  void clearRouteCheckpoints() {
    final controller = state;
    if (_routeCheckpointMarkers.isEmpty) return;
    controller?.mapScene.removeMapMarkers(
      _routeCheckpointMarkers.values.toList(),
    );
    _routeCheckpointMarkers.clear();
  }

  void focusOnCheckpoint(Checkpoint checkpoint) {
    final controller = state;
    if (controller == null) return;

    final animation = MapCameraAnimationFactory.flyToWithZoom(
      GeoCoordinatesUpdate(
        checkpoint.latitude.toDouble(),
        checkpoint.longitude.toDouble(),
      ),
      MapMeasure(MapMeasureKind.distanceInMeters, 500),
      0,
      const Duration(milliseconds: 800),
    );
    controller.camera.startAnimation(animation);
  }

