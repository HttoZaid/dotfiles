        ThemeSpacing.sp4,
        ThemeSpacing.sp4,
        ThemeSpacing.sp4,
        ThemeSpacing.sp4,
      ),
      child: Row(
        children: [
          Container(
            width: 44,
            height: 44,
            decoration: BoxDecoration(
              color: ThemeColors.accentSubtle,
              borderRadius: BorderRadius.circular(ThemeRadius.medium),
            ),
            child: const Icon(
              Icons.check_rounded,
              size: 24,
              color: ThemeColors.accent,
            ),
          ),

          const SizedBox(width: ThemeSpacing.sp3),

          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              mainAxisSize: MainAxisSize.min,
              children: [
                const Text(
                  NavStrings.arrivedTitle,
                  style: ThemeText.titleLarge,
                ),
                if (destName.isNotEmpty) ...[
                  const SizedBox(height: 2),
                  Text(
                    destName,
                    style: ThemeText.bodySmall,
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                  ),
                ],
              ],
            ),
          ),
        ],
      ),
    );
  }
}
