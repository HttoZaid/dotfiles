import 'dart:async';

import 'package:flutter/foundation.dart' show kReleaseMode;
import 'package:geolocator/geolocator.dart';
import 'package:here_sdk/core.dart';
import 'package:here_sdk/gestures.dart';
import 'package:here_sdk/navigation.dart';
import 'package:here_sdk/routing.dart';
import 'package:riverpod_annotation/riverpod_annotation.dart';

import 'package:ukcheckpoints_app/features/map/controllers/map_controller.dart';
import '../models/navigation_phase.dart';
import '../routing/uk_route_options.dart';
import '../search/nav_search_notifier.dart';
import '../utils/strings.dart';
import 'drive_progress_provider.dart';
import 'sheet_state_provider.dart';

part 'nav_state_provider.g.dart';

@Riverpod(keepAlive: true)
class NavStateNotifier extends _$NavStateNotifier {
  VisualNavigator? _navigator;
  RoutingEngine? _routingEngine;
  Timer? _recenterTimer;
  StreamSubscription<Position>? _locationSub;
  LocationSimulator? _simulator;

  @override
  NavigationPhase build() {
    _routingEngine = RoutingEngine();
    ref.onDispose(_teardown);
    return const Idle();
  }

  // ── Route calculation ─────────────────────────────────────────────────────

  void calculateRoute({
    required GeoCoordinates origin,
    required GeoCoordinates dest,
  }) {
    final engine = _routingEngine;
    if (engine == null) return;

    final waypoints = [Waypoint(origin), Waypoint(dest)];
    final options = buildUkCarOptions();

    engine.calculateRouteWithRoutingOptions(
      waypoints,
      options,
      (RoutingError? err, List<Route>? routes) {
        ref.read(navSearchNotifierProvider.notifier).unlockRouting();
        if (err != null || routes == null || routes.isEmpty) {
          ref
              .read(navSearchNotifierProvider.notifier)
              .setError(NavStrings.routeError);
          return;
        }
        final route = routes.first;
        state = TripOverview(route: route);
        ref.read(sheetStateNotifierProvider.notifier).showTripOverview();
        // Hide all global checkpoint markers — only route checkpoints shown
        // from here until trip is closed or drive ends.
        ref.read(mapControllerProvider.notifier).hideCheckpoints();
        unawaited(ref.read(mapControllerProvider.notifier).showRoute(route));
      },
    );
  }

  // ── Drive lifecycle ───────────────────────────────────────────────────────

  void startDrive(Route route) {
    final mapController = ref.read(mapControllerProvider);
    if (mapController == null) return;

    _teardown();

    final nav = VisualNavigator();
    _navigator = nav;

    nav.startRendering(mapController);
    applyUkUnitsToNavigator(nav);

    nav.routeDeviationListener = _DeviationAdapter(onDeviation);
    nav.destinationReachedListener = _ArrivalAdapter(onArrival);
    nav.routeProgressListener = _ProgressAdapter(onProgress);

    nav.route = route;
    nav.cameraBehavior = DynamicCameraBehavior();

    // Listen for the user grabbing the map so we can release camera ownership.
    // We use GestureState.begin — fires once per touch, not every frame.
    mapController.gestures.panListener = PanListener(
      (gestureState, origin, translation, velocity) {
        if (gestureState == GestureState.begin) {
          // Defer until the native gesture dispatcher has finished its current
          // frame — mutating cameraBehavior from inside the C++ callback causes
          // a null-pointer crash in the rendering engine.
          Future.microtask(onPan);
        }
      },
    );

    if (kReleaseMode) {
      // Physical device: feed real GPS ticks to the navigator.
      _locationSub = Geolocator.getPositionStream(
        locationSettings: const LocationSettings(
          accuracy: LocationAccuracy.high,
          distanceFilter: 0,
        ),
      ).listen(_forwardLocation);
    } else {
      // Emulator / dev: use the SDK simulator so the navigator receives
      // complete location objects (coords + bearing + speed) and turn-by-turn
      // actually progresses along the route.
      _simulator = LocationSimulator.withRoute(route, LocationSimulatorOptions());
      _simulator!.listener = nav;
      _simulator!.start();
    }

    // Hide global checkpoint markers — only route checkpoints shown during drive.
    ref.read(mapControllerProvider.notifier).hideCheckpoints();

    // Reset progress so stale data never shows for a new drive.
    ref.read(driveProgressProvider.notifier).state = null;

    // Clear the polyline and origin marker — the dest marker stays so the
    // driver can see their target on the map during the drive.
    ref.read(mapControllerProvider.notifier).clearRoutePolylineAndOrigin();
    ref.read(sheetStateNotifierProvider.notifier).peek();

    state = ActiveDrive(route: route);
  }

  void closeTrip() {
    ref.read(mapControllerProvider.notifier)
      ..clearRoute()
      ..clearRouteCheckpoints()
      ..showCheckpoints();
    ref.read(navSearchNotifierProvider.notifier).reset();
    ref.read(sheetStateNotifierProvider.notifier).peek();
    state = const Idle();
  }

  void stopDrive() {
    _teardown();
    ref.read(driveProgressProvider.notifier).state = null;
    ref.read(mapControllerProvider.notifier)
      ..clearRouteCheckpoints()
      ..showCheckpoints()
      ..clearRoute();
    ref.read(sheetStateNotifierProvider.notifier).peek();
    state = const Idle();
  }

  // ── Camera ownership ──────────────────────────────────────────────────────

  void recenter() {
    final nav = _navigator;
    final current = state;
    if (nav == null || current is! ActiveDrive) return;
    _recenterTimer?.cancel();
    _recenterTimer = null;
    nav.cameraBehavior = DynamicCameraBehavior();
    state = current.copyWith(camera: CameraOwnership.following);
  }

  void onPan() {
    final nav = _navigator;
    final current = state;
    if (nav == null || current is! ActiveDrive) return;

    if (current.camera == CameraOwnership.free) {
      // Already free — just reset the idle timer so the user gets a fresh 10s.
      _resetRecenterTimer();
      return;
    }

    nav.cameraBehavior = null;
    state = current.copyWith(camera: CameraOwnership.free);
    _resetRecenterTimer();
  }

  void _resetRecenterTimer() {
    _recenterTimer?.cancel();
    _recenterTimer = Timer(const Duration(seconds: 10), recenter);
  }

  // ── Navigator event handlers ──────────────────────────────────────────────

  void onDeviation() {
    final current = state;
    if (current is! ActiveDrive) return;
    state = current.copyWith(isRerouting: true);
    // Silent reroute wired in the reroute edge-case task.
  }

  void onArrival() {
    _teardown();
    ref.read(driveProgressProvider.notifier).state = null;
    ref.read(mapControllerProvider.notifier)
      ..clearRouteCheckpoints()
      ..showCheckpoints()
      ..clearRoute();
    ref.read(sheetStateNotifierProvider.notifier).peek();
    state = const Idle();
  }

  void onProgress(RouteProgress progress) {
    ref.read(driveProgressProvider.notifier).state = progress;
  }

  // ── Private ───────────────────────────────────────────────────────────────

  void _forwardLocation(Position pos) {
    final nav = _navigator;
    if (nav == null) return;
    final loc = Location.withCoordinates(
      GeoCoordinates(pos.latitude, pos.longitude),
    );
    // time is REQUIRED — map-matcher ignores locations without it.
    loc.time = pos.timestamp;
    // Geolocator returns negative values when sensor data is unavailable;
    // HERE SDK expects null in those cases.
    if (pos.heading >= 0) loc.bearingInDegrees = pos.heading;
    if (pos.speed >= 0) loc.speedInMetersPerSecond = pos.speed;
    loc.horizontalAccuracyInMeters = pos.accuracy;
    nav.onLocationUpdated(loc);
  }

  /// Delegates to the live VisualNavigator so callers get map-matched,
  /// route-synced maneuver data instead of stale Route object data.
  Maneuver? getManeuver(int index) => _navigator?.getManeuver(index);

  void _teardown() {
    _recenterTimer?.cancel();
    _recenterTimer = null;

    _locationSub?.cancel();
    _locationSub = null;

    _simulator?.stop();
    _simulator = null;

    // Release pan listener so checkpoint-tap and normal map gestures resume.
    ref.read(mapControllerProvider)?.gestures.panListener = null;

    final nav = _navigator;
    if (nav == null) return;
    nav.routeDeviationListener = null;
    nav.destinationReachedListener = null;
    nav.routeProgressListener = null;
    nav.cameraBehavior = null;
    nav.route = null;
    nav.stopRendering();
    _navigator = null;
  }
}

// ── Private listener adapters ──────────────────────────────────────────────

class _DeviationAdapter implements RouteDeviationListener {
  final void Function() _callback;
  const _DeviationAdapter(this._callback);

  @override
  void onRouteDeviation(RouteDeviation _) => _callback();
}

class _ArrivalAdapter implements DestinationReachedListener {
  final void Function() _callback;
  const _ArrivalAdapter(this._callback);

  @override
  void onDestinationReached() => _callback();
}

class _ProgressAdapter implements RouteProgressListener {
  final void Function(RouteProgress) _callback;
  const _ProgressAdapter(this._callback);

  @override
  void onRouteProgressUpdated(RouteProgress progress) => _callback(progress);
}
