import 'package:flutter/material.dart';
import 'package:ukcheckpoints_app/features/map/widgets/map_focus_button.dart';
import 'package:ukcheckpoints_app/features/map/widgets/map_orientation_button.dart';
import 'package:ukcheckpoints_app/features/map/widgets/map_view_switcher_button.dart';

class MapOverlayButtons extends StatelessWidget {
  final bool isDriving;

  const MapOverlayButtons({super.key, this.isDriving = false});

  @override
  Widget build(BuildContext context) {
    return Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        const MapViewSwitcherButton(),
        if (!isDriving) ...[
          const SizedBox(height: 8),
          const MapOrientationButton(),
          const SizedBox(height: 8),
          const MapFocusButton(),
        ],
      ],
    );
  }
}
