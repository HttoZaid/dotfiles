import type React from "react";
import { createContext, useContext, useMemo, useState } from "react";

type RouteState = {
	isNavigating: boolean;
	etaSeconds: number | null;
	remainingMeters: number | null;
	maneuver: string | null;
	set: (next: Partial<Omit<RouteState, "set">>) => void;
};

const RouteContext = createContext<RouteState | null>(null);

export function useRouteState() {
	const ctx = useContext(RouteContext);
	if (!ctx)
		throw new Error("useRouteState must be used within <RouteStateProvider>");
	return ctx;
}

export function RouteStateProvider({
	children,
}: {
	children: React.ReactNode;
}) {
	const [state, setState] = useState({
		isNavigating: false,
		etaSeconds: null as number | null,
		remainingMeters: null as number | null,
		maneuver: null as string | null,
	});

	const value = useMemo(
		() => ({
			...state,
			set: (next: Partial<typeof state>) =>
				setState((s) => ({ ...s, ...next })),
		}),
		[state],
	);

	return (
		<RouteContext.Provider value={value}>{children}</RouteContext.Provider>
	);
}
