						<X size={18} className="text-muted-foreground" strokeWidth={2.5} />
					</View>
				</Pressable>
			</View>

			<Pressable onPress={onStart} className="active:opacity-90">
				<View className="flex-row items-center justify-center gap-2 rounded-2xl bg-primary py-4">
					<Navigation
						size={20}
						className="text-primary-foreground"
						fill="currentColor"
					/>
					<Text className="text-base font-semibold text-primary-foreground">
						Start
					</Text>
				</View>
			</Pressable>
		</Animated.View>
