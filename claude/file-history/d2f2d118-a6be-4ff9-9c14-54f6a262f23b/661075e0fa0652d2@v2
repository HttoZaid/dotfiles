import { useRouteState } from "@/features/navigation/route-context";
import { formatManeuverDistance } from "@/features/navigation/lib/format-route";
import {
	ArrowLeft,
	ArrowRight,
	ArrowUp,
	ArrowUpLeft,
	ArrowUpRight,
	CornerDownLeft,
	CornerDownRight,
	MapPin,
	Navigation,
	RotateCcw,
	RotateCw,
} from "lucide-react-native";
import type React from "react";
import { Text, View } from "react-native";
import Animated, { FadeInDown, FadeOutUp, LinearTransition } from "react-native-reanimated";
import { useSafeAreaInsets } from "react-native-safe-area-context";

function ManeuverIcon({ action }: { action: string }): React.ReactNode {
	const props = { size: 28, strokeWidth: 2.5, className: "text-primary-foreground" } as const;

	switch (action) {
		case "TURN_LEFT":
		case "SHARPLY_LEFT":
		case "LEFT_FORK":
		case "LEFT_RAMP":
		case "LEFT_EXIT":
		case "MOTORWAY_CHANGE_LEFT":
			return <ArrowLeft {...props} />;
		case "TURN_RIGHT":
		case "SHARPLY_RIGHT":
		case "RIGHT_FORK":
		case "RIGHT_RAMP":
		case "RIGHT_EXIT":
		case "MOTORWAY_CHANGE_RIGHT":
			return <ArrowRight {...props} />;
		case "SLIGHT_LEFT":
		case "KEEP_LEFT":
			return <ArrowUpLeft {...props} />;
		case "SLIGHT_RIGHT":
		case "KEEP_RIGHT":
			return <ArrowUpRight {...props} />;
		case "U_TURN_LEFT":
			return <RotateCcw {...props} />;
		case "U_TURN_RIGHT":
			return <RotateCw {...props} />;
		case "ROUNDABOUT_ENTER":
		case "ROUNDABOUT_EXIT":
		case "ROUNDABOUT_PASS":
			return <CornerDownRight {...props} />;
		case "ENTER_HIGHWAY":
			return <CornerDownLeft {...props} />;
		case "EXIT_HIGHWAY":
			return <CornerDownRight {...props} />;
		case "ARRIVE":
			return <MapPin {...props} />;
		case "DEPART":
			return <Navigation {...props} />;
		default:
			return <ArrowUp {...props} />;
	}
}

export function ManeuverBanner() {
	const { phase, maneuverText, maneuverAction, maneuverDistanceMeters } = useRouteState();
	const insets = useSafeAreaInsets();

	if (phase !== "navigating" || !maneuverText) return null;

	const distanceLabel =
		maneuverDistanceMeters != null ? formatManeuverDistance(maneuverDistanceMeters) : null;

	return (
		<Animated.View
			entering={FadeInDown.duration(300).springify()}
			exiting={FadeOutUp.duration(200)}
			layout={LinearTransition.springify()}
			style={{ top: insets.top + 12 }}
			className="absolute inset-x-4 z-50 overflow-hidden rounded-3xl bg-primary shadow-2xl"
		>
			<View className="flex-row items-center gap-4 px-5 py-4">
				<View className="h-14 w-14 items-center justify-center rounded-2xl bg-white/15">
					<ManeuverIcon action={maneuverAction ?? "CONTINUE"} />
				</View>

				<View className="flex-1 gap-0.5">
					{distanceLabel ? (
						<Text className="text-[13px] font-semibold uppercase tracking-wider text-primary-foreground/70">
							In {distanceLabel}
						</Text>
					) : null}
					<Text
						className="text-[17px] font-bold leading-snug text-primary-foreground"
						numberOfLines={2}
					>
						{maneuverText}
					</Text>
				</View>
			</View>
		</Animated.View>
	);
}
