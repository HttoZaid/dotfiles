import { useRouteState } from "@/features/navigation/route-context";
import { MapPin } from "lucide-react-native";
import { useEffect } from "react";
import { Text, View } from "react-native";
import Animated, { FadeIn, FadeOut } from "react-native-reanimated";
import { useSafeAreaInsets } from "react-native-safe-area-context";

const DISMISS_MS = 3200;

export function ArrivalScreen() {
	const { phase, stopNavigation } = useRouteState();
	const insets = useSafeAreaInsets();

	useEffect(() => {
		if (phase !== "arrived") return;
		const t = setTimeout(() => stopNavigation(), DISMISS_MS);
		return () => clearTimeout(t);
	}, [phase, stopNavigation]);

	if (phase !== "arrived") return null;

	return (
		<Animated.View
			entering={FadeIn.duration(300)}
			exiting={FadeOut.duration(400)}
			className="absolute inset-0 items-center justify-center bg-background/90"
			style={{ paddingBottom: insets.bottom + 32 }}
		>
			<Animated.View
				entering={FadeIn.duration(400).delay(80)}
				className="items-center gap-5"
			>
				<View className="h-24 w-24 items-center justify-center rounded-full bg-primary/10">
					<MapPin size={46} className="text-primary" strokeWidth={1.75} />
				</View>
				<View className="items-center gap-2">
					<Text className="text-[30px] font-bold tracking-tight text-foreground">
						You've arrived
					</Text>
					<Text className="text-[16px] text-muted-foreground">
						You've reached your destination
					</Text>
				</View>
			</Animated.View>
		</Animated.View>
	);
}
