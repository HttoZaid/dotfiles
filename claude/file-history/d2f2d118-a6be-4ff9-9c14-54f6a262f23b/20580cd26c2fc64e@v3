import type { StyleProp, ViewStyle } from 'react-native';
import type { TransportMode } from './HereMapsConstants';

export type { TransportMode } from './HereMapsConstants';

// --- Core geometry types ---

export type LatLng = {
  lat: number;
  lng: number;
};

export type MapCenter = LatLng & {
  animated?: boolean;
};

export type CameraPosition = LatLng & {
  animated?: boolean;
  bearing?: number;
  tilt?: number;
  distanceMeters?: number;
};

// --- Search ---

export type GeoJsonFeature = {
  type: 'Feature';
  geometry: { type: 'Point'; coordinates: [number, number] } | null;
  properties: {
    title: string;
    subtitle: string;
    placeId: string;
    resolved: boolean;
  };
};

export type GeoJsonFeatureCollection = {
  type: 'FeatureCollection';
  features: GeoJsonFeature[];
};

// --- Routing ---

export type RouteSummary = {
  distanceMeters: number;
  durationSeconds: number;
};

export type CompareRouteResult = RouteSummary & {
  mode: TransportMode;
};

// --- Events ---

export type MapErrorEvent = {
  code: string;
  message: string;
};

export type GuidanceProgressEvent = {
  remainingMeters: number;
  etaSeconds: number;
};

export type ManeuverEvent = {
  text: string;
  action: string;
  distanceMeters: number;
};

export type OffRouteEvent = {
  distanceFromRoute: number;
};

export type ArrivedEvent = Record<string, never>;

export type NavigableLocationEvent = {
  streetName?: string;
  speedLimit?: number;
};

// --- View props ---

export type HereMapsViewProps = {
  center?: MapCenter;
  bearing?: number;
  tilt?: number;
  style?: StyleProp<ViewStyle>;

  // Error
  onMapError?: (event: { nativeEvent: MapErrorEvent }) => void;

  // Guidance events
  onGuidanceProgress?: (event: { nativeEvent: GuidanceProgressEvent }) => void;
  onManeuver?: (event: { nativeEvent: ManeuverEvent }) => void;
  onOffRoute?: (event: { nativeEvent: OffRouteEvent }) => void;
  onArrived?: (event: { nativeEvent: ArrivedEvent }) => void;
  onNavigableLocation?: (event: { nativeEvent: NavigableLocationEvent }) => void;
};

// --- Imperative ref ---

export type HereMapsViewRef = {
  // Map controls
  setMapScheme(scheme: string): Promise<void>;
  enableFeatures(features: string[]): Promise<void>;
  disableFeatures(features: string[]): Promise<void>;
  setCameraPosition(position: CameraPosition): Promise<void>;

  // Search
  suggestPlaces(query: string, near: LatLng): Promise<GeoJsonFeatureCollection>;
  resolvePlace(placeId: string): Promise<LatLng>;

  // Route (visual only, no guidance)
  showRoute(from: LatLng, to: LatLng, mode?: TransportMode): Promise<RouteSummary>;
  clearRoute(): void;

  // Multi-modal comparison (no drawing)
  compareRoutes(from: LatLng, to: LatLng, modes: TransportMode[]): Promise<CompareRouteResult[]>;

  // Turn-by-turn guidance
  startGuidance(from: LatLng, to: LatLng, mode?: TransportMode): Promise<RouteSummary>;
  stopGuidance(): void;

  // User location
  updateUserLocation(lat: number, lng: number, bearing?: number | null): void;
};
