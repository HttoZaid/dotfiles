// ─── Referral section ─────────────────────────────────────────

class _ReferralSection extends ConsumerWidget {
  const _ReferralSection();

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final state = ref.watch(profileControllerProvider);

    return state.when(
      loading: () => const SizedBox(
        height: 60,
        child: Center(
          child: SizedBox(
            width: 18,
            height: 18,
            child: CircularProgressIndicator(
              strokeWidth: 2,
              color: ThemeColors.accent,
            ),
          ),
        ),
      ),
      error: (err, _) => const Padding(
        padding: EdgeInsets.only(bottom: ThemeSpacing.sp3),
        child: Text(
          'Could not load referral codes.',
          style: TextStyle(
            fontFamily: ThemeFonts.ui,
            fontSize: 13,
            color: ThemeColors.danger,
          ),
        ),
      ),
      data: (codes) {
        if (codes.isEmpty) {
          return Padding(
            padding: const EdgeInsets.only(bottom: ThemeSpacing.sp3),
            child: _CreateReferralRow(
              onTap: () => ref
                  .read(profileControllerProvider.notifier)
                  .createReferralCode(),
            ),
          );
        }
        return Column(
          children: [
            for (final c in codes) ...[
              ReferralCodeItem(code: c.code),
              const SizedBox(height: ThemeSpacing.sp2),
            ],
            const SizedBox(height: ThemeSpacing.sp3),
          ],
        );
      },
    );
  }
}

class _CreateReferralRow extends StatelessWidget {
  final VoidCallback onTap;
  const _CreateReferralRow({required this.onTap});

  @override
  Widget build(BuildContext context) {
    return Material(
      color: ThemeColors.bgRaised,
      borderRadius: ThemeRadius.brLg,
      child: InkWell(
        onTap: onTap,
        borderRadius: ThemeRadius.brLg,
        child: Container(
          padding: const EdgeInsets.symmetric(
            horizontal: ThemeSpacing.sp4,
            vertical: ThemeSpacing.sp4,
          ),
          decoration: BoxDecoration(
            borderRadius: ThemeRadius.brLg,
            border: Border.all(color: ThemeColors.border),
          ),
          child: Row(
            children: [
              Container(
                width: 36,
                height: 36,
                decoration: BoxDecoration(
                  color: ThemeColors.accentSubtle,
                  borderRadius: ThemeRadius.brMd,
                ),
                child: const Icon(
                  Icons.add_rounded,
                  size: 19,
                  color: ThemeColors.accent,
                ),
              ),
              const SizedBox(width: ThemeSpacing.sp3),
              const Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      'Create a referral code',
                      style: TextStyle(
                        fontFamily: ThemeFonts.ui,
                        fontSize: 14,
                        fontWeight: FontWeight.w600,
                        color: ThemeColors.textPrimary,
                      ),
                    ),
                    Text(
                      'Invite friends to join the network',
                      style: TextStyle(
                        fontFamily: ThemeFonts.ui,
                        fontSize: 12,
                        color: ThemeColors.textTertiary,
                      ),
                    ),
                  ],
                ),
              ),
              const Icon(
                Icons.arrow_forward_ios_rounded,
                size: 12,
                color: ThemeColors.stone300,
              ),
            ],
          ),
        ),
      ),
    );
  }
}
