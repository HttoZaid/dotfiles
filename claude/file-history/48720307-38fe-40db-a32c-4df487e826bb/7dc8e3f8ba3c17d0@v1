import 'dart:async';

import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';

class ReferralCodeItem extends StatelessWidget {
  final String code;

  const ReferralCodeItem({required this.code, super.key});

  @override
  Widget build(BuildContext context) {
    return Container(
      margin: const EdgeInsets.only(bottom: ThemeSpacing.sp3),
      padding: const EdgeInsets.symmetric(
        horizontal: ThemeSpacing.sp5,
        vertical: ThemeSpacing.sp4,
      ),
      decoration: BoxDecoration(
        color: ThemeColors.stone100,
        borderRadius: ThemeRadius.brMd,
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text(
                  'referral code',
                  style: TextStyle(
                    fontSize: 11,
                    fontWeight: FontWeight.w600,
                    color: ThemeColors.textTertiary,
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  code,
                  style: const TextStyle(
                    fontFamily: 'Monospace',
                    fontSize: 18,
                    fontWeight: FontWeight.w800,
                    color: ThemeColors.textPrimary,
                    letterSpacing: 1.5,
                  ),
                ),
              ],
            ),
          ),
          CupertinoButton(
            padding: EdgeInsets.zero,
            onPressed: () => _copyToClipboard(context),
            child: Container(
              padding: const EdgeInsets.all(8),
              decoration: BoxDecoration(
                color: ThemeColors.bgRaised,
                borderRadius: ThemeRadius.brSm,
                border: Border.all(color: ThemeColors.border),
              ),
              child: const Icon(
                CupertinoIcons.doc_on_doc,
                size: 18,
                color: ThemeColors.accent,
              ),
            ),
          ),
        ],
      ),
    );
  }

  void _copyToClipboard(BuildContext context) {
    unawaited(Clipboard.setData(ClipboardData(text: code)));

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: const Text('code copied to clipboard'),
        duration: const Duration(seconds: 2),
        backgroundColor: ThemeColors.stone900,
        behavior: SnackBarBehavior.floating,
        margin: const EdgeInsets.all(ThemeSpacing.sp4),
        shape: RoundedRectangleBorder(borderRadius: ThemeRadius.brMd),
      ),
    );
  }
}
