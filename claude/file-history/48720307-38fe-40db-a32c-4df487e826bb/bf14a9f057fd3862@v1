import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';

class MapSpeedOverlay extends ConsumerWidget {
  const MapSpeedOverlay({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final location = ref.watch(userLocationStreamProvider).value;

    if (location == null) return const SizedBox.shrink();

    final speedMs = location.speed;
    final speedMph = speedMs * 2.23694;

    if (speedMph < 3.0) return const SizedBox.shrink();

    return Container(
      decoration: BoxDecoration(
        color: ThemeColors.bgRaised,
        borderRadius: ThemeRadius.brFull,
        boxShadow: ThemeShadows.md,
        border: Border.all(color: ThemeColors.border),
      ),
      child: Padding(
        padding: const EdgeInsets.symmetric(
          horizontal: 16,
          vertical: 10,
        ),
        child: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            Text(
              speedMph.toStringAsFixed(0),
              style: const TextStyle(
                fontFamily: ThemeFonts.ui,
                fontSize: 22,
                fontWeight: FontWeight.w600,
                height: 1,
                color: ThemeColors.accent,
              ),
            ),
            const SizedBox(width: 4),
            const Text(
              'mph',
              style: TextStyle(
                fontFamily: ThemeFonts.ui,
                fontSize: 11,
                fontWeight: FontWeight.w500,
                height: 1,
                color: ThemeColors.textSecondary,
              ),
            ),
          ],
        ),
      ),
    );
  }
}
