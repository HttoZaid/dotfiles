import 'dart:async';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';

class ReferralCodeItem extends StatelessWidget {
  final String code;

  const ReferralCodeItem({required this.code, super.key});

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(
        horizontal: ThemeSpacing.sp4,
        vertical: ThemeSpacing.sp4,
      ),
      decoration: BoxDecoration(
        color: ThemeColors.stone100,
        borderRadius: ThemeRadius.brLg,
      ),
      child: Row(
        children: [
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text(
                  'Referral code',
                  style: TextStyle(
                    fontFamily: ThemeFonts.ui,
                    fontSize: 11,
                    fontWeight: FontWeight.w500,
                    color: ThemeColors.textTertiary,
                  ),
                ),
                const SizedBox(height: 3),
                Text(
                  code,
                  style: const TextStyle(
                    fontFamily: 'monospace',
                    fontSize: 18,
                    fontWeight: FontWeight.w700,
                    letterSpacing: 1.5,
                    color: ThemeColors.textPrimary,
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(width: ThemeSpacing.sp3),
          Material(
            color: ThemeColors.bgRaised,
            borderRadius: ThemeRadius.brSm,
            child: InkWell(
              onTap: () => _copy(context),
              borderRadius: ThemeRadius.brSm,
              child: Container(
                padding: const EdgeInsets.all(9),
                decoration: BoxDecoration(
                  borderRadius: ThemeRadius.brSm,
                  border: Border.all(color: ThemeColors.border),
                ),
                child: const Icon(
                  Icons.copy_rounded,
                  size: 17,
                  color: ThemeColors.accent,
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  void _copy(BuildContext context) {
    unawaited(Clipboard.setData(ClipboardData(text: code)));
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: const Text('Code copied to clipboard'),
        duration: const Duration(seconds: 2),
        backgroundColor: ThemeColors.stone900,
        behavior: SnackBarBehavior.floating,
        margin: const EdgeInsets.all(ThemeSpacing.sp4),
        shape: RoundedRectangleBorder(borderRadius: ThemeRadius.brMd),
      ),
    );
  }
}
