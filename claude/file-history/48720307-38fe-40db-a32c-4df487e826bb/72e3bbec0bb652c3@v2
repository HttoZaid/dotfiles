import 'dart:async';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/map/widgets/map_view_options_sheet.dart';

class MapViewSwitcherButton extends ConsumerWidget {
  const MapViewSwitcherButton({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    return Container(
      width: 44,
      height: 44,
      decoration: const BoxDecoration(
        shape: BoxShape.circle,
        color: ThemeColors.bgRaised,
        boxShadow: ThemeShadows.sm,
      ),
      child: Material(
        color: Colors.transparent,
        shape: const CircleBorder(),
        child: InkWell(
          customBorder: const CircleBorder(),
          onTap: () => unawaited(
            showModalBottomSheet<void>(
              context: context,
              useSafeArea: true,
              backgroundColor: ThemeColors.bgRaised,
              shape: const RoundedRectangleBorder(
                borderRadius: BorderRadius.vertical(
                  top: Radius.circular(ThemeRadius.rXl),
                ),
              ),
              builder: (_) => const MapViewOptionsSheet(),
            ),
          ),
          child: const Center(
            child: Icon(Icons.layers, color: ThemeColors.stone600, size: 22),
          ),
        ),
      ),
    );
  }
}
