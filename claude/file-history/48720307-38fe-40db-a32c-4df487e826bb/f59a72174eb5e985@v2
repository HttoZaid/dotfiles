import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_api/ukcheckpoints_api.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';

class MapSearchBar extends ConsumerStatefulWidget {
  final void Function(Checkpoint) onCheckpointSelected;

  const MapSearchBar({required this.onCheckpointSelected, super.key});

  @override
  ConsumerState<MapSearchBar> createState() => _MapSearchBarState();
}

class _MapSearchBarState extends ConsumerState<MapSearchBar> {
  final _controller = TextEditingController();
  final _focusNode = FocusNode();
  bool _isFocused = false;

  @override
  void initState() {
    super.initState();
    _focusNode.addListener(() {
      setState(() {
        _isFocused = _focusNode.hasFocus;
      });
    });
  }

  @override
  void dispose() {
    _controller.dispose();
    _focusNode.dispose();
    super.dispose();
  }

  void _clear() {
    _controller.clear();
    ref.read(checkpointSearchProvider.notifier).update('');
  }

  @override
  Widget build(BuildContext context) {
    final search = ref.watch(checkpointSearchProvider);
    final results = ref.watch(filteredCheckpointsProvider);
    final topInset = MediaQuery.of(context).padding.top;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        Padding(
          padding: EdgeInsets.fromLTRB(
            ThemeSpacing.sp4,
            topInset + ThemeSpacing.sp3,
            ThemeSpacing.sp4,
            0,
          ),
          child: _SearchPill(
            controller: _controller,
            focusNode: _focusNode,
            hasText: search.isNotEmpty,
            onChanged: (value) =>
                ref.read(checkpointSearchProvider.notifier).update(value),
            onClear: _clear,
          ),
        ),
        if (_isFocused && search.isNotEmpty)
          Padding(
            padding: const EdgeInsets.fromLTRB(
              ThemeSpacing.sp4,
              ThemeSpacing.sp2,
              ThemeSpacing.sp4,
              0,
            ),
            child: _SearchResults(
              resultsAsync: results,
              onSelect: (checkpoint) {
                _focusNode.unfocus();
                widget.onCheckpointSelected(checkpoint);
              },
            ),
          ),
      ],
    );
  }
}

class _SearchPill extends StatelessWidget {
  final TextEditingController controller;
  final FocusNode focusNode;
  final bool hasText;
  final ValueChanged<String> onChanged;
  final VoidCallback onClear;

  const _SearchPill({
    required this.controller,
    required this.focusNode,
    required this.hasText,
    required this.onChanged,
    required this.onClear,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      height: 52,
      decoration: BoxDecoration(
        color: ThemeColors.bgRaised,
        borderRadius: ThemeRadius.brFull,
        boxShadow: ThemeShadows.md,
      ),
      child: Row(
        children: [
          const SizedBox(width: ThemeSpacing.sp4),
          const Icon(Icons.search, color: ThemeColors.accent, size: 22),
          const SizedBox(width: ThemeSpacing.sp2 + 2),
          Expanded(
            child: TextField(
              controller: controller,
              focusNode: focusNode,
              style: ThemeText.body,
              onChanged: onChanged,
              decoration: InputDecoration(
                hintText: 'Search checkpoints...',
                hintStyle: ThemeText.body.copyWith(
                  color: ThemeColors.textTertiary,
                ),
                border: InputBorder.none,
                enabledBorder: InputBorder.none,
                focusedBorder: InputBorder.none,
                filled: false,
                isDense: true,
                contentPadding: EdgeInsets.zero,
              ),
            ),
          ),
          if (hasText) ...[
            GestureDetector(
              onTap: onClear,
              child: Container(
                width: 28,
                height: 28,
                decoration: const BoxDecoration(
                  color: ThemeColors.stone200,
                  shape: BoxShape.circle,
                ),
                child: const Icon(
                  Icons.close,
                  size: 16,
                  color: ThemeColors.stone600,
                ),
              ),
            ),
            const SizedBox(width: ThemeSpacing.sp3),
          ] else
            const SizedBox(width: ThemeSpacing.sp4),
        ],
      ),
    );
  }
}

class _SearchResults extends StatelessWidget {
  final AsyncValue<CheckpointState> resultsAsync;
  final void Function(Checkpoint) onSelect;

  const _SearchResults({
    required this.resultsAsync,
    required this.onSelect,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: ThemeColors.bgRaised,
        borderRadius: ThemeRadius.brLg,
        boxShadow: ThemeShadows.md,
      ),
      child: ClipRRect(
        borderRadius: ThemeRadius.brLg,
        child: resultsAsync.when(
          data: (data) {
            final items = data.checkpoints.take(5).toList();
            if (items.isEmpty) return const _EmptyResult();
            return Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                for (int i = 0; i < items.length; i++) ...[
                  _ResultTile(
                    checkpoint: items[i],
                    onTap: () => onSelect(items[i]),
                  ),
                  if (i < items.length - 1)
                    const Divider(
                      height: 0.5,
                      thickness: 0.5,
                      indent: ThemeSpacing.sp4,
                      endIndent: ThemeSpacing.sp4,
                      color: ThemeColors.border,
                    ),
                ],
              ],
            );
          },
          loading: () => const Padding(
            padding: EdgeInsets.all(ThemeSpacing.sp4),
            child: Center(
              child: SizedBox(
                width: 20,
                height: 20,
                child: CircularProgressIndicator(
                  strokeWidth: 2,
                  color: ThemeColors.accent,
                ),
              ),
            ),
          ),
          error: (_, _) => const Padding(
            padding: EdgeInsets.all(ThemeSpacing.sp4),
            child: Text(
              'Could not load checkpoints. Please try again.',
              style: ThemeText.subheadline,
            ),
          ),
        ),
      ),
    );
  }
}

class _ResultTile extends StatelessWidget {
  final Checkpoint checkpoint;
  final VoidCallback onTap;

  const _ResultTile({required this.checkpoint, required this.onTap});

  @override
  Widget build(BuildContext context) {
    final status = checkpoint.contributions.isNotEmpty
        ? checkpoint.contributions.first.status
        : ContributionStatusEnum.UNKNOWN;

    return InkWell(
      onTap: onTap,
      child: Padding(
        padding: const EdgeInsets.symmetric(
          horizontal: ThemeSpacing.sp4,
          vertical: ThemeSpacing.sp3,
        ),
        child: Row(
          children: [
            _StatusDot(status: status),
            const SizedBox(width: ThemeSpacing.sp3),
            Expanded(
              child: Text(
                checkpoint.name,
                style: ThemeText.callout,
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
              ),
            ),
            const SizedBox(width: ThemeSpacing.sp2),
            const Icon(
              Icons.chevron_right,
              size: 18,
              color: ThemeColors.stone400,
            ),
          ],
        ),
      ),
    );
  }
}

class _StatusDot extends StatelessWidget {
  final ContributionStatusEnum status;

  const _StatusDot({required this.status});

  @override
  Widget build(BuildContext context) {
    final color = switch (status) {
      ContributionStatusEnum.ACTIVE => ThemeColors.danger,
      ContributionStatusEnum.INACTIVE => ThemeColors.success,
      ContributionStatusEnum.POLICE_ALERT => ThemeColors.warning,
      _ => ThemeColors.stone400,
    };

    return Container(
      width: 8,
      height: 8,
      decoration: BoxDecoration(color: color, shape: BoxShape.circle),
    );
  }
}

class _EmptyResult extends StatelessWidget {
  const _EmptyResult();

  @override
  Widget build(BuildContext context) {
    return const Padding(
      padding: EdgeInsets.all(ThemeSpacing.sp4),
      child: Text(
        'No checkpoints found.',
        style: ThemeText.subheadline,
      ),
    );
  }
}
