import 'dart:async';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/auth/providers/auth_controller.dart';
import 'package:ukcheckpoints_app/features/profile/providers/profile_controller.dart';
import 'package:url_launcher/url_launcher.dart';

class SettingsScreen extends ConsumerWidget {
  const SettingsScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final user = ref.watch(authControllerProvider).value;
    if (user == null) return const SizedBox.shrink();

    return Scaffold(
      backgroundColor: ThemeColors.bg,
      appBar: AppBar(
        backgroundColor: ThemeColors.bg,
        surfaceTintColor: Colors.transparent,
        elevation: 0,
        scrolledUnderElevation: 0,
        leading: IconButton(
          icon: const Icon(
            Icons.arrow_back_rounded,
            color: ThemeColors.textPrimary,
            size: 22,
          ),
          onPressed: () => Navigator.pop(context),
        ),
        title: const Text(
          'Settings',
          style: TextStyle(
            fontFamily: ThemeFonts.ui,
            fontSize: 17,
            fontWeight: FontWeight.w600,
            letterSpacing: -0.3,
            color: ThemeColors.textPrimary,
          ),
        ),
      ),
      body: SingleChildScrollView(
        physics: const BouncingScrollPhysics(),
        padding: const EdgeInsets.symmetric(horizontal: ThemeSpacing.sp4),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const SizedBox(height: ThemeSpacing.sp2),

            // ── Account ────────────────────────────────────────
            const _SectionLabel('Account'),
            _SettingsGroup(
              children: [
                _SettingRow(
                  icon: Icons.mail_outline_rounded,
                  label: 'Email',
                  value: user.profile.email,
                ),
                _SettingRow(
                  icon: Icons.phone_outlined,
                  label: 'Phone',
                  value: user.profile.phoneNumber ?? 'Not provided',
                  isLast: true,
                ),
              ],
            ),

            const SizedBox(height: ThemeSpacing.sp5),

            // ── Subscription ───────────────────────────────────
            const _SectionLabel('Subscription'),
            _SettingsGroup(
              children: [
                _SettingRow(
                  icon: Icons.credit_card_outlined,
                  label: 'Manage Billing',
                  isLast: true,
                  onTap: () async {
                    final url = await ref
                        .read(profileControllerProvider.notifier)
                        .createPortalSession();
                    if (url != null) {
                      await _launchUrl(url);
                    }
                  },
                ),
              ],
            ),

            const SizedBox(height: ThemeSpacing.sp5),

            // ── Support & Legal ────────────────────────────────
            const _SectionLabel('Support & Legal'),
            _SettingsGroup(
              children: [
                _SettingRow(
                  icon: Icons.help_outline_rounded,
                  label: 'Help & Support',
                  onTap: () => unawaited(
                    _launchUrl('https://ukcheckpoints.info/help'),
                  ),
                ),
                _SettingRow(
                  icon: Icons.shield_outlined,
                  label: 'Privacy Policy',
                  onTap: () => unawaited(
                    _launchUrl('https://ukcheckpoints.info/privacy'),
                  ),
                ),
                _SettingRow(
                  icon: Icons.description_outlined,
                  label: 'Terms of Service',
                  isLast: true,
                  onTap: () => unawaited(
                    _launchUrl('https://ukcheckpoints.info/terms'),
                  ),
                ),
              ],
            ),

            const SizedBox(height: ThemeSpacing.sp8),

            // ── Account actions ────────────────────────────────
            _ActionRow(
              icon: Icons.logout_rounded,
              label: 'Sign Out',
              onTap: () =>
                  ref.read(authControllerProvider.notifier).logout(),
            ),
            const SizedBox(height: ThemeSpacing.sp3),
            _ActionRow(
              icon: Icons.delete_outline_rounded,
              label: 'Delete Account',
              isDestructive: true,
              onTap: () => _showDeleteSheet(context, ref),
            ),

            const SizedBox(height: ThemeSpacing.sp16),
          ],
        ),
      ),
    );
  }

  static Future<void> _launchUrl(String url) async {
    final uri = Uri.parse(url);
    if (await canLaunchUrl(uri)) {
      await launchUrl(uri, mode: LaunchMode.externalApplication);
    }
  }

  void _showDeleteSheet(BuildContext context, WidgetRef ref) {
    unawaited(
      showModalBottomSheet(
        context: context,
        isScrollControlled: true,
        backgroundColor: Colors.transparent,
        builder: (_) => _DeleteSheet(ref: ref),
      ),
    );
  }
}

// ─── Section label ────────────────────────────────────────────

class _SectionLabel extends StatelessWidget {
  final String text;
  const _SectionLabel(this.text);

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.only(
        left: ThemeSpacing.sp1,
        bottom: ThemeSpacing.sp2,
      ),
      child: Text(
        text,
        style: const TextStyle(
          fontFamily: ThemeFonts.ui,
          fontSize: 12,
          fontWeight: FontWeight.w600,
          letterSpacing: 0.1,
          color: ThemeColors.stone400,
        ),
      ),
    );
  }
}

// ─── Grouped settings card ────────────────────────────────────

class _SettingsGroup extends StatelessWidget {
  final List<Widget> children;
  const _SettingsGroup({required this.children});

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: ThemeColors.bgRaised,
        borderRadius: ThemeRadius.brLg,
        border: Border.all(color: ThemeColors.border),
      ),
      clipBehavior: Clip.antiAlias,
      child: Column(children: children),
    );
  }
}

// ─── Setting row ──────────────────────────────────────────────

class _SettingRow extends StatelessWidget {
  final IconData icon;
  final String label;
  final String? value;
  final VoidCallback? onTap;
  final bool isLast;

  const _SettingRow({
    required this.icon,
    required this.label,
    this.value,
    this.onTap,
    this.isLast = false,
  });

  @override
  Widget build(BuildContext context) {
    final isClickable = onTap != null;

    return Column(
      children: [
        InkWell(
          onTap: onTap,
          child: Padding(
            padding: const EdgeInsets.symmetric(
              horizontal: ThemeSpacing.sp4,
              vertical: 14,
            ),
            child: Row(
              children: [
                Container(
                  width: 32,
                  height: 32,
                  decoration: BoxDecoration(
                    color: ThemeColors.stone100,
                    borderRadius: ThemeRadius.brSm,
                  ),
                  child: Icon(
                    icon,
                    size: 16,
                    color: ThemeColors.stone700,
                  ),
                ),
                const SizedBox(width: ThemeSpacing.sp3),
                Expanded(
                  child: Text(
                    label,
                    style: const TextStyle(
                      fontFamily: ThemeFonts.ui,
                      fontSize: 15,
                      fontWeight: FontWeight.w500,
                      color: ThemeColors.textPrimary,
                    ),
                  ),
                ),
                if (value != null)
                  Flexible(
                    child: Text(
                      value!,
                      textAlign: TextAlign.end,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(
                        fontFamily: ThemeFonts.ui,
                        fontSize: 14,
                        color: ThemeColors.textTertiary,
                      ),
                    ),
                  )
                else if (isClickable)
                  const Icon(
                    Icons.arrow_forward_ios_rounded,
                    size: 13,
                    color: ThemeColors.stone300,
                  ),
              ],
            ),
          ),
        ),
        if (!isLast)
          const Padding(
            padding: EdgeInsets.only(left: 60),
            child: Divider(height: 1, color: ThemeColors.border),
          ),
      ],
    );
  }
}

// ─── Action row (sign out / delete) ──────────────────────────

class _ActionRow extends StatelessWidget {
  final IconData icon;
  final String label;
  final VoidCallback onTap;
  final bool isDestructive;

  const _ActionRow({
    required this.icon,
    required this.label,
    required this.onTap,
    this.isDestructive = false,
  });

  @override
  Widget build(BuildContext context) {
    final color = isDestructive ? ThemeColors.danger : ThemeColors.textPrimary;
    final bgColor =
        isDestructive ? ThemeColors.dangerSubtle : ThemeColors.bgRaised;

    return Material(
      color: bgColor,
      borderRadius: ThemeRadius.brLg,
      child: InkWell(
        onTap: onTap,
        borderRadius: ThemeRadius.brLg,
        child: Container(
          padding: const EdgeInsets.symmetric(
            horizontal: ThemeSpacing.sp4,
            vertical: 16,
          ),
          decoration: BoxDecoration(
            borderRadius: ThemeRadius.brLg,
            border: Border.all(
              color: isDestructive
                  ? ThemeColors.danger.withValues(alpha: 0.20)
                  : ThemeColors.border,
            ),
          ),
          child: Row(
            children: [
              Icon(icon, size: 19, color: color),
              const SizedBox(width: ThemeSpacing.sp3),
              Text(
                label,
                style: TextStyle(
                  fontFamily: ThemeFonts.ui,
                  fontSize: 15,
                  fontWeight: FontWeight.w600,
                  color: color,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

// ─── Delete confirmation sheet ────────────────────────────────

class _DeleteSheet extends StatelessWidget {
  final WidgetRef ref;
  const _DeleteSheet({required this.ref});

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: const BoxDecoration(
        color: ThemeColors.bgRaised,
        borderRadius: BorderRadius.vertical(
          top: Radius.circular(ThemeRadius.r2xl),
        ),
      ),
      padding: EdgeInsets.fromLTRB(
        ThemeSpacing.sp5,
        ThemeSpacing.sp3,
        ThemeSpacing.sp5,
        ThemeSpacing.sp5 + MediaQuery.of(context).padding.bottom,
      ),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          // drag handle
          Center(
            child: Container(
              width: 32,
              height: 4,
              margin: const EdgeInsets.only(bottom: ThemeSpacing.sp5),
              decoration: BoxDecoration(
                color: ThemeColors.stone200,
                borderRadius: ThemeRadius.brFull,
              ),
            ),
          ),

          // danger icon
          const SizedBox(
            width: 52,
            height: 52,
            child: DecoratedBox(
              decoration: BoxDecoration(
                color: ThemeColors.dangerSubtle,
                shape: BoxShape.circle,
              ),
              child: Icon(
                Icons.delete_outline_rounded,
                size: 24,
                color: ThemeColors.danger,
              ),
            ),
          ),
          const SizedBox(height: ThemeSpacing.sp4),

          const Text(
            'Delete Account',
            style: TextStyle(
              fontFamily: ThemeFonts.ui,
              fontSize: 17,
              fontWeight: FontWeight.w700,
              letterSpacing: -0.3,
              color: ThemeColors.textPrimary,
            ),
          ),
          const SizedBox(height: ThemeSpacing.sp2),
          const Text(
            'Your account and all associated data will be permanently '
            'removed. This cannot be undone.',
            textAlign: TextAlign.center,
            style: TextStyle(
              fontFamily: ThemeFonts.ui,
              fontSize: 14,
              height: 1.5,
              color: ThemeColors.textSecondary,
            ),
          ),
          const SizedBox(height: ThemeSpacing.sp6),

          Row(
            children: [
              Expanded(
                child: OutlinedButton(
                  onPressed: () => Navigator.pop(context),
                  style: OutlinedButton.styleFrom(
                    foregroundColor: ThemeColors.textPrimary,
                    side: const BorderSide(color: ThemeColors.border),
                    padding: const EdgeInsets.symmetric(vertical: 14),
                    shape: RoundedRectangleBorder(
                      borderRadius: ThemeRadius.brMd,
                    ),
                    textStyle: const TextStyle(
                      fontFamily: ThemeFonts.ui,
                      fontWeight: FontWeight.w600,
                      fontSize: 15,
                    ),
                  ),
                  child: const Text('Cancel'),
                ),
              ),
              const SizedBox(width: ThemeSpacing.sp3),
              Expanded(
                child: FilledButton(
                  onPressed: () {
                    Navigator.pop(context);
                    unawaited(
                      ref
                          .read(profileControllerProvider.notifier)
                          .deleteAccount(),
                    );
                  },
                  style: FilledButton.styleFrom(
                    backgroundColor: ThemeColors.danger,
                    foregroundColor: Colors.white,
                    padding: const EdgeInsets.symmetric(vertical: 14),
                    shape: RoundedRectangleBorder(
                      borderRadius: ThemeRadius.brMd,
                    ),
                    textStyle: const TextStyle(
                      fontFamily: ThemeFonts.ui,
                      fontWeight: FontWeight.w600,
                      fontSize: 15,
                    ),
                  ),
                  child: const Text('Delete'),
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}
