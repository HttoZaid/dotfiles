import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';

class CheckpointSearchHeader extends ConsumerWidget {
  const CheckpointSearchHeader({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final theme = Theme.of(context);
    return Container(
      height: 44,
      decoration: BoxDecoration(
        color: ThemeColors.stone100,
        borderRadius: ThemeRadius.brMd,
      ),
      child: TextField(
        onChanged: (value) {
          ref.read(checkpointSearchProvider.notifier).update(value);
        },
        style: theme.textTheme.bodyLarge?.copyWith(
          fontSize: 14,
          fontWeight: FontWeight.w500,
        ),
        cursorColor: ThemeColors.accent,
        decoration: InputDecoration(
          hintText: 'Search area or coordinate...',
          hintStyle: theme.textTheme.bodyMedium?.copyWith(
            color: ThemeColors.textTertiary,
            fontSize: 14,
          ),
          prefixIcon: const Icon(
            CupertinoIcons.search,
            size: 16,
            color: ThemeColors.textTertiary,
          ),
          border: InputBorder.none,
          enabledBorder: InputBorder.none,
          focusedBorder: InputBorder.none,
          filled: false,
          contentPadding: const EdgeInsets.symmetric(vertical: 10),
        ),
      ),
    );
  }
}
