import 'dart:async';

import 'package:flutter/material.dart';
import 'package:intl/intl.dart';
import 'package:ukcheckpoints_api/ukcheckpoints_api.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_action_sheet_widget.dart';

class CheckpointCard extends StatelessWidget {
  final Checkpoint checkpoint;
  final double? distanceMeters;

  const CheckpointCard({
    required this.checkpoint,
    this.distanceMeters,
    super.key,
  });

  @override
  Widget build(BuildContext context) {
    final status =
        checkpoint.contributions.isNotEmpty
            ? checkpoint.contributions.first.status
            : null;
    final lastUpdate =
        checkpoint.contributions.isNotEmpty
            ? checkpoint.contributions.first.createdAt
            : checkpoint.createdAt;

    final (Color sc, IconData si) = _statusStyle(status);

    return RepaintBoundary(
      child: Container(
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(12),
          boxShadow: [
            BoxShadow(
              color: Colors.black.withValues(alpha: 0.045),
              blurRadius: 6,
              offset: const Offset(0, 2),
            ),
            BoxShadow(
              color: Colors.black.withValues(alpha: 0.025),
              blurRadius: 2,
              offset: const Offset(0, 1),
            ),
          ],
        ),
        child: Material(
          color: ThemeColors.bgRaised,
          borderRadius: BorderRadius.circular(12),
          clipBehavior: Clip.antiAlias,
          child: InkWell(
            splashColor: ThemeColors.stone100.withValues(alpha: 0.9),
            highlightColor: ThemeColors.stone100.withValues(alpha: 0.5),
            onTap: () {
              unawaited(
                showModalBottomSheet(
                  context: context,
                  isScrollControlled: true,
                  backgroundColor: Colors.transparent,
                  builder: (_) =>
                      CheckpointActionSheet(checkpoint: checkpoint),
                ),
              );
            },
            child: Padding(
              padding: const EdgeInsets.all(ThemeSpacing.sp3),
              child: Row(
                children: [
                  // Status icon circle
                  Container(
                    width: 40,
                    height: 40,
                    decoration: BoxDecoration(
                      color: sc.withValues(alpha: 0.09),
                      shape: BoxShape.circle,
                    ),
                    child: Icon(si, color: sc, size: 18),
                  ),
                  const SizedBox(width: ThemeSpacing.sp3),
                  // Content
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Text(
                          checkpoint.name,
                          style: const TextStyle(
                            fontFamily: ThemeFonts.ui,
                            fontSize: 15,
                            fontWeight: FontWeight.w600,
                            letterSpacing: -0.3,
                            color: ThemeColors.textPrimary,
                            height: 1.3,
                          ),
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                        ),
                        const SizedBox(height: 3),
                        _MetaRow(
                          status: status,
                          distanceMeters: distanceMeters,
                          lastUpdate: lastUpdate,
                          statusColor: sc,
                        ),
                      ],
                    ),
                  ),
                  const SizedBox(width: ThemeSpacing.sp2),
                  const Icon(
                    Icons.arrow_forward_ios_rounded,
                    size: 12,
                    color: ThemeColors.stone300,
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }

  static (Color, IconData) _statusStyle(ContributionStatusEnum? status) =>
      switch (status) {
        ContributionStatusEnum.ACTIVE => (
          ThemeColors.danger,
          Icons.sensors_rounded,
        ),
        ContributionStatusEnum.INACTIVE => (
          const Color(0xFF1F7A4D),
          Icons.check_circle_outline_rounded,
        ),
        ContributionStatusEnum.POLICE_ALERT => (
          const Color(0xFFB45309),
          Icons.warning_amber_rounded,
        ),
        _ => (ThemeColors.stone300, Icons.help_outline_rounded),
      };
}

class _MetaRow extends StatelessWidget {
  final ContributionStatusEnum? status;
  final double? distanceMeters;
  final DateTime lastUpdate;
  final Color statusColor;

  const _MetaRow({
    required this.status,
    required this.distanceMeters,
    required this.lastUpdate,
    required this.statusColor,
  });

  String get _statusLabel => switch (status) {
    ContributionStatusEnum.ACTIVE => 'Active',
    ContributionStatusEnum.INACTIVE => 'Clear',
    ContributionStatusEnum.POLICE_ALERT => 'Police',
    _ => 'Unknown',
  };

  String _distance(double m) {
    final mi = m / 1609.344;
    if (mi < 0.1) return '${m.round()} m';
    if (mi < 10) return '${mi.toStringAsFixed(1)} mi';
    return '${mi.round()} mi';
  }

  String _timeAgo(DateTime dt) {
    final diff = DateTime.now().difference(dt.toLocal());
    if (diff.inMinutes < 1) return 'just now';
    if (diff.inMinutes < 60) return '${diff.inMinutes}m ago';
    if (diff.inHours < 24) return '${diff.inHours}h ago';
    return DateFormat('HH:mm').format(dt.toLocal());
  }

  @override
  Widget build(BuildContext context) {
    const sep = TextSpan(
      text: '  ·  ',
      style: TextStyle(
        fontFamily: ThemeFonts.ui,
        fontSize: 13,
        color: ThemeColors.stone300,
      ),
    );

    return RichText(
      maxLines: 1,
      overflow: TextOverflow.ellipsis,
      text: TextSpan(
        children: [
          TextSpan(
            text: _statusLabel,
            style: TextStyle(
              fontFamily: ThemeFonts.ui,
              fontSize: 13,
              fontWeight: FontWeight.w600,
              color: statusColor,
            ),
          ),
          if (distanceMeters != null) ...[
            sep,
            TextSpan(
              text: _distance(distanceMeters!),
              style: const TextStyle(
                fontFamily: ThemeFonts.ui,
                fontSize: 13,
                color: ThemeColors.textTertiary,
              ),
            ),
          ],
          sep,
          TextSpan(
            text: _timeAgo(lastUpdate),
            style: const TextStyle(
              fontFamily: ThemeFonts.ui,
              fontSize: 13,
              color: ThemeColors.textTertiary,
            ),
          ),
        ],
      ),
    );
  }
}
