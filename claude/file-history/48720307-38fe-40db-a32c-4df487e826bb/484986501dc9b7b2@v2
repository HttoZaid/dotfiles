import 'dart:math';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/map/controllers/map_controller.dart';

class MapOrientationButton extends ConsumerWidget {
  const MapOrientationButton({super.key});

  bool _isNorth(double bearing) {
    final normalized = bearing % 360;
    return normalized < 1.0 || normalized > 359.0;
  }

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final mapController = ref.watch(mapControllerProvider);
    final bearing = ref.watch(mapBearingProvider);

    if (mapController == null || _isNorth(bearing)) {
      return const SizedBox.shrink();
    }

    return Container(
      width: 44,
      height: 44,
      decoration: const BoxDecoration(
        shape: BoxShape.circle,
        color: ThemeColors.bgRaised,
        boxShadow: ThemeShadows.sm,
      ),
      child: Material(
        color: Colors.transparent,
        shape: const CircleBorder(),
        child: InkWell(
          customBorder: const CircleBorder(),
          onTap: () => ref
              .read(mapControllerProvider.notifier)
              .resetOrientationToNorth(),
          child: Center(
            // Rotate the compass so its N always points to geographic north.
            // HERE SDK bearing = clockwise degrees from north, so we negate.
            child: Transform.rotate(
              angle: -bearing * (pi / 180),
              child: const Icon(
                Icons.explore,
                color: ThemeColors.accent,
                size: 22,
              ),
            ),
          ),
        ),
      ),
    );
  }
}
