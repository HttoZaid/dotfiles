import 'package:flutter/material.dart';
import 'package:ukcheckpoints_api/ukcheckpoints_api.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/domain/geoutils.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_card_widget.dart';

class CheckpointListContent extends StatelessWidget {
  final CheckpointState state;
  final String searchQuery;
  final double? userLat;
  final double? userLng;

  const CheckpointListContent({
    super.key,
    required this.state,
    required this.searchQuery,
    this.userLat,
    this.userLng,
  });

  @override
  Widget build(BuildContext context) {
    final checkpoints = state.checkpoints;
    final hasLocation = userLat != null && userLng != null;

    final nearby = <Checkpoint>[];
    final others = <Checkpoint>[];

    if (hasLocation && searchQuery.isEmpty) {
      for (final cp in checkpoints) {
        final status =
            cp.contributions.isNotEmpty
                ? cp.contributions.first.status
                : null;
        final isKnownStatus =
            status != null && status != ContributionStatusEnum.UNKNOWN;

        if (isKnownStatus &&
            isWithinProximity(
              cp.latitude,
              cp.longitude,
              userLat!,
              userLng!,
            )) {
          nearby.add(cp);
        } else {
          others.add(cp);
        }
      }
    } else {
      others.addAll(checkpoints);
    }

    return SliverPadding(
      padding: const EdgeInsets.only(bottom: ThemeSpacing.sp16),
      sliver: SliverMainAxisGroup(
        slivers: [
          if (nearby.isNotEmpty) ...[
            const _SectionHeader(title: 'Nearby'),
            _CheckpointSliverList(
              checkpoints: nearby,
              userLat: userLat,
              userLng: userLng,
            ),
            const _SectionHeader(title: 'All checkpoints'),
          ],
          _CheckpointSliverList(
            checkpoints: others,
            userLat: userLat,
            userLng: userLng,
          ),
        ],
      ),
    );
  }
}

class _CheckpointSliverList extends StatelessWidget {
  final List<Checkpoint> checkpoints;
  final double? userLat;
  final double? userLng;

  const _CheckpointSliverList({
    required this.checkpoints,
    this.userLat,
    this.userLng,
  });

  @override
  Widget build(BuildContext context) {
    final hasLocation = userLat != null && userLng != null;

    return SliverPadding(
      padding: const EdgeInsets.symmetric(horizontal: ThemeSpacing.sp4),
      sliver: SliverList(
        delegate: SliverChildBuilderDelegate(
          (context, index) {
            final cp = checkpoints[index];
            final dist =
                hasLocation
                    ? distanceMeters(
                      cp.latitude,
                      cp.longitude,
                      userLat!,
                      userLng!,
                    )
                    : null;
            return Padding(
              padding: const EdgeInsets.only(bottom: ThemeSpacing.sp2),
              child: CheckpointCard(checkpoint: cp, distanceMeters: dist),
            );
          },
          childCount: checkpoints.length,
        ),
      ),
    );
  }
}

class _SectionHeader extends StatelessWidget {
  final String title;

  const _SectionHeader({required this.title});

  @override
  Widget build(BuildContext context) {
    return SliverToBoxAdapter(
      child: Padding(
        padding: const EdgeInsets.fromLTRB(
          ThemeSpacing.sp4,
          ThemeSpacing.sp4,
          ThemeSpacing.sp4,
          ThemeSpacing.sp2,
        ),
        child: Text(
          title.toUpperCase(),
          style: const TextStyle(
            fontFamily: ThemeFonts.ui,
            fontSize: 11,
            fontWeight: FontWeight.w700,
            letterSpacing: 0.6,
            color: ThemeColors.textTertiary,
          ),
        ),
      ),
    );
  }
}
