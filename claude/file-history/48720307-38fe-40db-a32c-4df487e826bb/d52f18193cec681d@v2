import 'dart:async';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/providers/navigation_provider.dart';
import 'package:ukcheckpoints_app/core/services/realtime_service.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/auth/providers/auth_controller.dart';
import 'package:ukcheckpoints_app/features/checkpoints/screens/checkpoint_list_screen.dart';
import 'package:ukcheckpoints_app/features/map/screens/map_screen.dart';
import 'package:ukcheckpoints_app/features/profile/screens/profile_screen.dart';

class MainWrapper extends ConsumerStatefulWidget {
  const MainWrapper({super.key});

  @override
  ConsumerState<MainWrapper> createState() => _MainWrapperState();
}

class _MainWrapperState extends ConsumerState<MainWrapper> {
  static const _screens = <Widget>[
    MapScreen(),
    CheckpointListScreen(),
    ProfileScreen(),
  ];

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      final user = ref.read(authControllerProvider).value;
      if (user != null) {
        unawaited(ref.read(realtimeServiceProvider).connect());
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    final index = ref.watch(bottomNavIndexProvider);

    return Scaffold(
      body: IndexedStack(index: index, children: _screens),
      bottomNavigationBar: DecoratedBox(
        decoration: const BoxDecoration(
          border: Border(
            top: BorderSide(color: ThemeColors.border, width: 0.5),
          ),
        ),
        child: NavigationBar(
          selectedIndex: index,
          onDestinationSelected: (i) =>
              ref.read(bottomNavIndexProvider.notifier).state = i,
          height: 64,
          animationDuration: ThemeMotion.durBase,
          labelBehavior: NavigationDestinationLabelBehavior.alwaysShow,
          destinations: const [
            NavigationDestination(
              icon: Icon(Icons.map_outlined),
              selectedIcon: Icon(Icons.map),
              label: 'Map',
            ),
            NavigationDestination(
              icon: Icon(Icons.shield_outlined),
              selectedIcon: Icon(Icons.shield),
              label: 'Checkpoints',
            ),
            NavigationDestination(
              icon: Icon(Icons.person_outline),
              selectedIcon: Icon(Icons.person),
              label: 'Profile',
            ),
          ],
        ),
      ),
    );
  }
}
