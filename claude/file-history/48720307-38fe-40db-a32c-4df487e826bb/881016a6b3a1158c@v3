import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';

class CheckpointSearchHeader extends ConsumerStatefulWidget {
  const CheckpointSearchHeader({super.key});

  @override
  ConsumerState<CheckpointSearchHeader> createState() =>
      _CheckpointSearchHeaderState();
}

class _CheckpointSearchHeaderState
    extends ConsumerState<CheckpointSearchHeader> {
  final _controller = TextEditingController();

  @override
  void initState() {
    super.initState();
    _controller.addListener(() => setState(() {}));
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final hasText = _controller.text.isNotEmpty;

    return TextField(
      controller: _controller,
      onChanged: (v) => ref.read(checkpointSearchProvider.notifier).update(v),
      style: const TextStyle(
        fontFamily: ThemeFonts.ui,
        fontSize: 14,
        fontWeight: FontWeight.w400,
        color: ThemeColors.textPrimary,
      ),
      cursorColor: ThemeColors.accent,
      cursorHeight: 16,
      decoration: InputDecoration(
        hintText: 'Search by name or area...',
        hintStyle: const TextStyle(
          fontFamily: ThemeFonts.ui,
          fontSize: 14,
          fontWeight: FontWeight.w400,
          color: ThemeColors.textTertiary,
        ),
        prefixIcon: const Padding(
          padding: EdgeInsets.only(left: 12, right: 8),
          child: Icon(
            Icons.search_rounded,
            size: 18,
            color: ThemeColors.stone400,
          ),
        ),
        prefixIconConstraints: const BoxConstraints(),
        suffixIcon:
            hasText
                ? GestureDetector(
                  onTap: () {
                    _controller.clear();
                    ref.read(checkpointSearchProvider.notifier).update('');
                  },
                  child: const Padding(
                    padding: EdgeInsets.only(right: 10),
                    child: Icon(
                      Icons.close_rounded,
                      size: 16,
                      color: ThemeColors.stone400,
                    ),
                  ),
                )
                : null,
        suffixIconConstraints:
            const BoxConstraints(),
        filled: true,
        fillColor: ThemeColors.bgSubtle,
        contentPadding: const EdgeInsets.symmetric(
          horizontal: 12,
          vertical: 10,
        ),
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(ThemeRadius.rSm),
          borderSide: BorderSide.none,
        ),
        enabledBorder: OutlineInputBorder(
          borderRadius: BorderRadius.circular(ThemeRadius.rSm),
          borderSide: BorderSide.none,
        ),
        focusedBorder: OutlineInputBorder(
          borderRadius: BorderRadius.circular(ThemeRadius.rSm),
          borderSide: const BorderSide(color: ThemeColors.accent, width: 1.5),
        ),
      ),
    );
  }
}
