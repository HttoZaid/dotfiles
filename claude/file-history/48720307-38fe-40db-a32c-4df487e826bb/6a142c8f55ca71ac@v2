import 'dart:math' as math;

const double kProximityThresholdMeters = 500;

bool isWithinProximity(num lat1, num lon1, num lat2, num lon2) {
  return distanceMeters(lat1, lon1, lat2, lon2) <= kProximityThresholdMeters;
}

double distanceMeters(num lat1, num lon1, num lat2, num lon2) {
  const p = 0.017453292519943295;
  final a =
      0.5 -
      math.cos((lat1.toDouble() - lat2.toDouble()) * p) / 2 +
      math.cos(lat2.toDouble() * p) *
          math.cos(lat1.toDouble() * p) *
          (1 - math.cos((lon1.toDouble() - lon2.toDouble()) * p)) /
          2;
  return 12742 * math.asin(math.sqrt(a)) * 1000;
}
