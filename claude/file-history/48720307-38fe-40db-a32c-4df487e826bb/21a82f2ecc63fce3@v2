import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_api/ukcheckpoints_api.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/domain/checkpoint_error.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_empty_view.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_error_view.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_filter_bar.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_list_content.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_search_header.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_shimmer_widget.dart';

class CheckpointListScreen extends ConsumerWidget {
  const CheckpointListScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final filteredAsync = ref.watch(filteredCheckpointsProvider);
    final searchQuery = ref.watch(checkpointSearchProvider);
    final location = ref.watch(userLocationStreamProvider).value;
    final isSyncing = filteredAsync.value?.isSyncing ?? false;
    final total = filteredAsync.value?.total ?? 0;
    final checkpoints = filteredAsync.value?.checkpoints ?? const [];

    return Scaffold(
      backgroundColor: ThemeColors.bg,
      body: SafeArea(
        bottom: false,
        child: RefreshIndicator(
          onRefresh: () =>
              ref.read(checkpointNotifierProvider.notifier).refresh(),
          displacement: 32,
          color: ThemeColors.accent,
          backgroundColor: ThemeColors.bgRaised,
          strokeWidth: 2,
          child: CustomScrollView(
            physics: const AlwaysScrollableScrollPhysics(),
            slivers: [
              SliverAppBar(
                floating: true,
                snap: true,
                backgroundColor: ThemeColors.bg,
                surfaceTintColor: Colors.transparent,
                elevation: 0,
                scrolledUnderElevation: 0,
                titleSpacing: ThemeSpacing.sp4,
                title: Row(
                  children: [
                    const Text(
                      'Checkpoints',
                      style: TextStyle(
                        fontFamily: ThemeFonts.ui,
                        fontSize: 22,
                        fontWeight: FontWeight.w600,
                        letterSpacing: -0.5,
                        color: ThemeColors.textPrimary,
                      ),
                    ),
                    if (total > 0) ...[
                      const SizedBox(width: ThemeSpacing.sp2),
                      _CountBadge(count: total),
                    ],
                    const Spacer(),
                    if (isSyncing)
                      const SizedBox(
                        width: 16,
                        height: 16,
                        child: CircularProgressIndicator(
                          strokeWidth: 2,
                          color: ThemeColors.accent,
                        ),
                      ),
                  ],
                ),
                bottom: const PreferredSize(
                  preferredSize: Size.fromHeight(92),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Padding(
                        padding: EdgeInsets.symmetric(
                          horizontal: ThemeSpacing.sp4,
                        ),
                        child: CheckpointSearchHeader(),
                      ),
                      SizedBox(height: 6),
                      CheckpointFilterBar(),
                      SizedBox(height: 6),
                    ],
                  ),
                ),
              ),

              // Stats summary — new feature
              if (checkpoints.isNotEmpty)
                SliverToBoxAdapter(
                  child: _StatsBar(checkpoints: checkpoints),
                ),

              filteredAsync.when(
                loading: () => const CheckpointShimmer(),
                error: (err, _) {
                  final msg = err is CheckpointError
                      ? err.message
                      : err.toString();
                  return CheckpointErrorView(message: msg);
                },
                data: (state) {
                  if (state.checkpoints.isEmpty) {
                    return CheckpointEmptyView(query: searchQuery);
                  }
                  return CheckpointListContent(
                    state: state,
                    searchQuery: searchQuery,
                    userLat: location?.latitude,
                    userLng: location?.longitude,
                  );
                },
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _CountBadge extends StatelessWidget {
  final int count;
  const _CountBadge({required this.count});

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
      decoration: BoxDecoration(
        color: ThemeColors.stone200,
        borderRadius: BorderRadius.circular(ThemeRadius.rSm),
      ),
      child: Text(
        count.toString(),
        style: const TextStyle(
          fontFamily: ThemeFonts.ui,
          fontSize: 12,
          fontWeight: FontWeight.w600,
          color: ThemeColors.stone600,
          letterSpacing: -0.1,
        ),
      ),
    );
  }
}

class _StatsBar extends StatelessWidget {
  final List<Checkpoint> checkpoints;
  const _StatsBar({required this.checkpoints});

  @override
  Widget build(BuildContext context) {
    var active = 0;
    var police = 0;
    var clear = 0;
    for (final cp in checkpoints) {
      if (cp.contributions.isEmpty) continue;
      switch (cp.contributions.first.status) {
        case ContributionStatusEnum.ACTIVE:
          active++;
        case ContributionStatusEnum.POLICE_ALERT:
          police++;
        case ContributionStatusEnum.INACTIVE:
          clear++;
        case ContributionStatusEnum.UNKNOWN:
          break;
      }
    }

    if (active + police + clear == 0) return const SizedBox.shrink();

    return Padding(
      padding: const EdgeInsets.fromLTRB(
        ThemeSpacing.sp4,
        ThemeSpacing.sp3,
        ThemeSpacing.sp4,
        ThemeSpacing.sp1,
      ),
      child: Row(
        children: [
          if (active > 0)
            _StatChip(
              count: active,
              label: 'Active',
              color: ThemeColors.danger,
            ),
          if (active > 0 && police > 0)
            const SizedBox(width: ThemeSpacing.sp2),
          if (police > 0)
            _StatChip(
              count: police,
              label: 'Police',
              color: const Color(0xFFB45309),
            ),
          if (police > 0 && clear > 0)
            const SizedBox(width: ThemeSpacing.sp2),
          if (clear > 0)
            _StatChip(
              count: clear,
              label: 'Clear',
              color: const Color(0xFF1F7A4D),
            ),
        ],
      ),
    );
  }
}

class _StatChip extends StatelessWidget {
  final int count;
  final String label;
  final Color color;
  const _StatChip({
    required this.count,
    required this.label,
    required this.color,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
      decoration: BoxDecoration(
        color: color.withValues(alpha: 0.08),
        borderRadius: BorderRadius.circular(ThemeRadius.rSm),
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Container(
            width: 6,
            height: 6,
            decoration: BoxDecoration(
              color: color,
              shape: BoxShape.circle,
            ),
          ),
          const SizedBox(width: 5),
          Text(
            '$count $label',
            style: TextStyle(
              fontFamily: ThemeFonts.ui,
              fontSize: 12,
              fontWeight: FontWeight.w600,
              color: color,
              letterSpacing: -0.1,
            ),
          ),
        ],
      ),
    );
  }
}
