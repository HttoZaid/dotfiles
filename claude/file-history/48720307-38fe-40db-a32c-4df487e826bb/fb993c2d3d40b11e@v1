import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_api/ukcheckpoints_api.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';

class CheckpointFilterBar extends ConsumerWidget {
  const CheckpointFilterBar({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final activeFilter = ref.watch(checkpointStatusFilterProvider);
    return SizedBox(
      height: 52,
      child: ListView(
        scrollDirection: Axis.horizontal,
        padding: const EdgeInsets.symmetric(vertical: 8, horizontal: ThemeSpacing.sp4),
        physics: const BouncingScrollPhysics(),
        children: [
          _FilterChip(
            label: 'All',
            isSelected: activeFilter == null,
            onTap: () {
              ref
                  .read(checkpointStatusFilterProvider.notifier)
                  .setFilter(null);
            },
          ),
          _FilterChip(
            label: 'Active',
            color: ThemeColors.danger,
            isSelected: activeFilter == ContributionStatusEnum.ACTIVE,
            onTap: () {
              ref
                  .read(checkpointStatusFilterProvider.notifier)
                  .setFilter(ContributionStatusEnum.ACTIVE);
            },
          ),
          _FilterChip(
            label: 'Activity',
            color: const Color(0xFFFF9500),
            isSelected: activeFilter == ContributionStatusEnum.POLICE_ALERT,
            onTap: () {
              ref
                  .read(checkpointStatusFilterProvider.notifier)
                  .setFilter(ContributionStatusEnum.POLICE_ALERT);
            },
          ),
          _FilterChip(
            label: 'Inactive',
            color: const Color(0xFF34C759),
            isSelected: activeFilter == ContributionStatusEnum.INACTIVE,
            onTap: () {
              ref
                  .read(checkpointStatusFilterProvider.notifier)
                  .setFilter(ContributionStatusEnum.INACTIVE);
            },
          ),
        ],
      ),
    );
  }
}

class _FilterChip extends StatelessWidget {
  final String label;
  final bool isSelected;
  final VoidCallback onTap;
  final Color? color;

  const _FilterChip({
    required this.label,
    required this.isSelected,
    required this.onTap,
    this.color,
  });

  @override
  Widget build(BuildContext context) {
    final themeColor = color ?? ThemeColors.accent;
    return Padding(
      padding: const EdgeInsets.only(right: 6),
      child: InkWell(
        onTap: onTap,
        borderRadius: ThemeRadius.brFull,
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 200),
          padding: const EdgeInsets.symmetric(horizontal: 16),
          decoration: BoxDecoration(
            color:
                isSelected
                    ? themeColor.withValues(alpha: 0.1)
                    : ThemeColors.stone100,
            borderRadius: ThemeRadius.brFull,
            border: Border.all(
              color: isSelected ? themeColor : Colors.transparent,
              width: 1.5,
            ),
          ),
          child: Center(
            child: Text(
              label,
              style: TextStyle(
                fontSize: 13,
                fontWeight: isSelected ? FontWeight.w800 : FontWeight.w600,
                color: isSelected ? themeColor : ThemeColors.textSecondary,
                letterSpacing: -0.2,
              ),
            ),
          ),
        ),
      ),
    );
  }
}
