import 'dart:async';

import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';

class CheckpointErrorView extends ConsumerWidget {
  final String message;

  const CheckpointErrorView({required this.message, super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final theme = Theme.of(context);
    return SliverFillRemaining(
      hasScrollBody: false,
      child: Padding(
        padding: const EdgeInsets.all(ThemeSpacing.sp8),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(
              CupertinoIcons.wifi_exclamationmark,
              size: 56,
              color: ThemeColors.stone300,
            ),
            const SizedBox(height: ThemeSpacing.sp6),
            Text(
              'Sync interrupted',
              style: theme.textTheme.titleLarge?.copyWith(
                fontWeight: FontWeight.w900,
              ),
            ),
            const SizedBox(height: ThemeSpacing.sp2),
            Text(
              message,
              textAlign: TextAlign.center,
              style: theme.textTheme.bodyMedium,
            ),
            const SizedBox(height: ThemeSpacing.sp8),
            SizedBox(
              width: 160,
              child: ElevatedButton(
                onPressed: () {
                  unawaited(ref
                      .read(checkpointNotifierProvider.notifier)
                      .refresh());
                },
                style: ElevatedButton.styleFrom(
                  backgroundColor: ThemeColors.textPrimary,
                  elevation: 0,
                ),
                child: const Text('Try again'),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
