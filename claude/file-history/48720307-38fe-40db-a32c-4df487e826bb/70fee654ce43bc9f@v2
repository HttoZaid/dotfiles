import 'package:flutter/material.dart';
import 'package:intl/intl.dart';
import 'package:ukcheckpoints_api/ukcheckpoints_api.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';

class ReferralList extends StatelessWidget {
  final List<ReferralDetails> referrals;

  const ReferralList({required this.referrals, super.key});

  @override
  Widget build(BuildContext context) {
    if (referrals.isEmpty) return const SizedBox.shrink();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const SizedBox(height: ThemeSpacing.sp5),
        const Text(
          'Referral history',
          style: TextStyle(
            fontFamily: ThemeFonts.ui,
            fontSize: 11,
            fontWeight: FontWeight.w600,
            letterSpacing: 0.4,
            color: ThemeColors.stone400,
          ),
        ),
        const SizedBox(height: ThemeSpacing.sp2),
        Container(
          decoration: BoxDecoration(
            color: ThemeColors.bgRaised,
            borderRadius: ThemeRadius.brLg,
            border: Border.all(color: ThemeColors.border),
          ),
          clipBehavior: Clip.antiAlias,
          child: ListView.separated(
            shrinkWrap: true,
            physics: const NeverScrollableScrollPhysics(),
            itemCount: referrals.length,
            separatorBuilder: (_, _) => const Padding(
              padding: EdgeInsets.only(left: 60),
              child: Divider(height: 1, color: ThemeColors.border),
            ),
            itemBuilder: (context, i) => _ReferralRow(referral: referrals[i]),
          ),
        ),
      ],
    );
  }
}

class _ReferralRow extends StatelessWidget {
  final ReferralDetails referral;
  const _ReferralRow({required this.referral});

  @override
  Widget build(BuildContext context) {
    final isCompleted =
        referral.status == ReferralDetailsStatusEnum.COMPLETED;
    final initial = referral.refereeUsername.isNotEmpty
        ? referral.refereeUsername[0].toUpperCase()
        : '?';
    final joinedStr =
        'Joined ${DateFormat('MMM d, yyyy').format(referral.referredAt)}';

    return Padding(
      padding: const EdgeInsets.symmetric(
        horizontal: ThemeSpacing.sp4,
        vertical: ThemeSpacing.sp3,
      ),
      child: Row(
        children: [
          // Avatar initial circle
          Container(
            width: 36,
            height: 36,
            alignment: Alignment.center,
            decoration: const BoxDecoration(
              color: ThemeColors.stone100,
              shape: BoxShape.circle,
            ),
            child: Text(
              initial,
              style: const TextStyle(
                fontFamily: ThemeFonts.ui,
                fontSize: 13,
                fontWeight: FontWeight.w700,
                color: ThemeColors.stone600,
              ),
            ),
          ),
          const SizedBox(width: ThemeSpacing.sp3),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  referral.refereeUsername,
                  style: const TextStyle(
                    fontFamily: ThemeFonts.ui,
                    fontSize: 14,
                    fontWeight: FontWeight.w600,
                    color: ThemeColors.textPrimary,
                  ),
                ),
                Text(
                  joinedStr,
                  style: const TextStyle(
                    fontFamily: ThemeFonts.ui,
                    fontSize: 12,
                    color: ThemeColors.textTertiary,
                  ),
                ),
              ],
            ),
          ),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
            decoration: BoxDecoration(
              color: isCompleted
                  ? ThemeColors.accentSubtle
                  : ThemeColors.stone100,
              borderRadius: ThemeRadius.brSm,
            ),
            child: Text(
              isCompleted ? 'Completed' : 'Pending',
              style: TextStyle(
                fontFamily: ThemeFonts.ui,
                fontSize: 11,
                fontWeight: FontWeight.w600,
                color: isCompleted
                    ? ThemeColors.accent
                    : ThemeColors.stone400,
              ),
            ),
          ),
        ],
      ),
    );
  }
}
