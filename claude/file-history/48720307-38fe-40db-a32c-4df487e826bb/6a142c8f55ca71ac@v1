import 'dart:math' as math;

const double kProximityThresholdMeters = 500;

bool isWithinProximity(num lat1, num lon1, num lat2, num lon2) {
  const p = 0.017453292519943295;
  final l1 = lat1.toDouble();
  final l2 = lat2.toDouble();
  final n1 = lon1.toDouble();
  final n2 = lon2.toDouble();
  final a =
      0.5 -
      math.cos((l1 - l2) * p) / 2 +
      math.cos(l2 * p) *
          math.cos(l1 * p) *
          (1 - math.cos((n1 - n2) * p)) /
          2;
  return (12742 * math.asin(math.sqrt(a)) * 1000) <= kProximityThresholdMeters;
}
