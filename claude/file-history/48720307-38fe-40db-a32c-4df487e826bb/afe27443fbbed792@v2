import 'dart:convert';
import 'dart:io';

import 'package:flutter/foundation.dart';
import 'package:path_provider/path_provider.dart';

class MapPreferencesService {
  static const _defaults = {
    'mapScheme': 'normalDay',
    'trafficEnabled': false,
    'publicTransitEnabled': false,
    'safetyCamerasEnabled': false,
    'trafficLightsEnabled': false,
    'congestionZonesEnabled': false,
    'roadExitLabelsEnabled': false,
  };

  Map<String, dynamic> _prefs = Map.of(_defaults);
  bool _loaded = false;

  Future<String> get _path async {
    final dir = await getApplicationDocumentsDirectory();
    return '${dir.path}/map_preferences.json';
  }

  Future<void> _ensureLoaded() async {
    if (_loaded) return;
    _loaded = true;
    try {
      final file = File(await _path);
      if (await file.exists()) {
        final content = await file.readAsString();
        final json = jsonDecode(content) as Map<String, dynamic>;
        _prefs = Map.of(_defaults);
        for (final key in _defaults.keys) {
          if (json.containsKey(key)) {
            _prefs[key] = json[key];
          }
        }
      }
    } catch (e, st) {
      debugPrint('[MapPreferencesService] load error: $e\n$st');
      _prefs = Map.of(_defaults);
    }
  }

  Future<void> _save() async {
    final file = File(await _path);
    await file.writeAsString(jsonEncode(_prefs));
  }

  // ── Getters ──────────────────────────────────────────────────

  Future<String> getMapScheme() async {
    await _ensureLoaded();
    return _prefs['mapScheme'] as String;
  }

  Future<bool> isTrafficEnabled() async {
    await _ensureLoaded();
    return _prefs['trafficEnabled'] as bool;
  }

  Future<bool> isPublicTransitEnabled() async {
    await _ensureLoaded();
    return _prefs['publicTransitEnabled'] as bool;
  }

  Future<bool> isSafetyCamerasEnabled() async {
    await _ensureLoaded();
    return _prefs['safetyCamerasEnabled'] as bool;
  }

  Future<bool> isTrafficLightsEnabled() async {
    await _ensureLoaded();
    return _prefs['trafficLightsEnabled'] as bool;
  }

  Future<bool> isCongestionZonesEnabled() async {
    await _ensureLoaded();
    return _prefs['congestionZonesEnabled'] as bool;
  }

  Future<bool> isRoadExitLabelsEnabled() async {
    await _ensureLoaded();
    return _prefs['roadExitLabelsEnabled'] as bool;
  }

  // ── Setters ──────────────────────────────────────────────────

  Future<void> setMapScheme(String scheme) async {
    await _ensureLoaded();
    _prefs['mapScheme'] = scheme;
    await _save();
  }

  Future<void> setTrafficEnabled(bool enabled) async {
    await _ensureLoaded();
    _prefs['trafficEnabled'] = enabled;
    await _save();
  }

  Future<void> setPublicTransitEnabled(bool enabled) async {
    await _ensureLoaded();
    _prefs['publicTransitEnabled'] = enabled;
    await _save();
  }

  Future<void> setSafetyCamerasEnabled(bool enabled) async {
    await _ensureLoaded();
    _prefs['safetyCamerasEnabled'] = enabled;
    await _save();
  }

  Future<void> setTrafficLightsEnabled(bool enabled) async {
    await _ensureLoaded();
    _prefs['trafficLightsEnabled'] = enabled;
    await _save();
  }

  Future<void> setCongestionZonesEnabled(bool enabled) async {
    await _ensureLoaded();
    _prefs['congestionZonesEnabled'] = enabled;
    await _save();
  }

  Future<void> setRoadExitLabelsEnabled(bool enabled) async {
    await _ensureLoaded();
    _prefs['roadExitLabelsEnabled'] = enabled;
    await _save();
  }
}
