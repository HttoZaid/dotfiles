import 'dart:async';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/map/widgets/map_view_options_sheet.dart';

class MapViewSwitcherButton extends ConsumerWidget {
  const MapViewSwitcherButton({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    return Container(
      decoration: BoxDecoration(
        color: ThemeColors.bgRaised,
        borderRadius: ThemeRadius.brFull,
        boxShadow: ThemeShadows.md,
        border: Border.all(color: ThemeColors.border),
      ),
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          borderRadius: ThemeRadius.brFull,
          onTap: () {
            unawaited(
              showModalBottomSheet<void>(
                context: context,
                useSafeArea: true,
                backgroundColor: ThemeColors.bgRaised,
                shape: const RoundedRectangleBorder(
                  borderRadius: BorderRadius.vertical(
                    top: Radius.circular(ThemeRadius.rXl),
                  ),
                ),
                builder: (_) => const MapViewOptionsSheet(),
              ),
            );
          },
          child: const Padding(
            padding: EdgeInsets.all(ThemeSpacing.sp3),
            child: Icon(Icons.layers, color: ThemeColors.accent, size: 24),
          ),
        ),
      ),
    );
  }
}
