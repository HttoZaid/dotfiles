import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';
import 'package:intl/intl.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/auth/providers/auth_controller.dart';
import 'package:ukcheckpoints_app/features/profile/providers/profile_controller.dart';
import 'package:ukcheckpoints_app/features/profile/widgets/contribution_graph_widget.dart';
import 'package:ukcheckpoints_app/features/profile/widgets/profile_shimmer_widget.dart';
import 'package:ukcheckpoints_app/features/profile/widgets/referral_code_item_widget.dart';
import 'package:ukcheckpoints_app/features/profile/widgets/referral_list_widget.dart';

class ProfileScreen extends ConsumerWidget {
  const ProfileScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final authState = ref.watch(authControllerProvider);
    final theme = Theme.of(context);
    final colorScheme = theme.colorScheme;

    return Scaffold(
      backgroundColor: theme.scaffoldBackgroundColor,
      body: authState.when(
        loading: () => const SafeArea(child: ProfileShimmer()),
        error: (err, _) => Center(child: Text(err.toString())),
        data: (user) {
          if (user == null) return const SizedBox.shrink();

          return SafeArea(
            child: LayoutBuilder(
              builder: (context, constraints) {
                final isWide = constraints.maxWidth > 600;
                final horizontalPadding =
                    isWide ? constraints.maxWidth * 0.2 : ThemeSpacing.sp4;

                return CustomScrollView(
                  physics: const BouncingScrollPhysics(),
                  slivers: [
                    SliverAppBar(
                      floating: true,
                      backgroundColor: theme.scaffoldBackgroundColor,
                      surfaceTintColor: Colors.transparent,
                      elevation: 0,
                      centerTitle: false,
                      automaticallyImplyLeading: false,
                      title: Text(
                        'Profile',
                        style: theme.textTheme.displayMedium?.copyWith(
                          fontSize: 24,
                          fontWeight: FontWeight.w700,
                        ),
                      ),
                      actions: [
                        Padding(
                          padding: const EdgeInsets.only(
                            right: ThemeSpacing.sp4,
                          ),
                          child: IconButton(
                            onPressed: () => context.push('/settings'),
                            icon: Icon(
                              CupertinoIcons.settings,
                              color: colorScheme.onSurface,
                              size: 22,
                            ),
                          ),
                        ),
                      ],
                    ),
                    SliverPadding(
                      padding: EdgeInsets.symmetric(
                        horizontal: horizontalPadding,
                      ),
                      sliver: SliverList(
                        delegate: SliverChildListDelegate([
                          _ProfileHeader(
                            userName: user.profile.userName,
                            avatarUrl: user.profile.avatarUrl,
                            joinDate: user.profile.createdAt,
                          ),
                          const SizedBox(height: ThemeSpacing.sp8),
                          _SubscriptionStatusCard(
                            status:
                                user.profile.subscription.status?.name ??
                                'Inactive',
                            expiry: user.profile.subscription.periodEndDate,
                          ),
                          const SizedBox(height: ThemeSpacing.sp8),
                          _UserStatsGrid(
                            total:
                                user.profile.stats.totalContributions.toInt(),
                            streak:
                                user.profile.stats.contributionStreak.toInt(),
                            today: user.profile.stats.today.toInt(),
                          ),
                          const SizedBox(height: ThemeSpacing.sp8),
                          ContributionGraph(
                            contributions:
                                user.profile.stats.last7Days.toList(),
                          ),
                          const SizedBox(height: ThemeSpacing.sp8),
                          const _ReferralSection(),
                          const SizedBox(height: ThemeSpacing.sp8),
                          ReferralList(
                            referrals:
                                user.profile.stats.referralsMade.toList(),
                          ),
                          const SizedBox(height: ThemeSpacing.sp16),
                        ]),
                      ),
                    ),
                  ],
                );
              },
            ),
          );
        },
      ),
    );
  }
}

class _ProfileHeader extends StatelessWidget {
  final String userName;
  final String avatarUrl;
  final DateTime joinDate;

  const _ProfileHeader({
    required this.userName,
    required this.avatarUrl,
    required this.joinDate,
  });

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    return Row(
      children: [
        Container(
          width: 72,
          height: 72,
          decoration: BoxDecoration(
            color: theme.colorScheme.surfaceContainerHighest,
            borderRadius: ThemeRadius.brLg,
          ),
          child: ClipRRect(
            borderRadius: ThemeRadius.brLg,
            child: Image.network(
              avatarUrl,
              fit: BoxFit.cover,
              errorBuilder:
                  (_, __, ___) => Icon(
                    CupertinoIcons.person_fill,
                    color: theme.colorScheme.outline,
                    size: 32,
                  ),
            ),
          ),
        ),
        const SizedBox(width: ThemeSpacing.sp5),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                userName,
                style: theme.textTheme.titleLarge?.copyWith(
                  fontWeight: FontWeight.w700,
                  letterSpacing: -0.5,
                ),
              ),
              const SizedBox(height: 2),
              Text(
                'Member since ${DateFormat('MMMM yyyy').format(joinDate)}',
                style: theme.textTheme.bodyMedium,
              ),
            ],
          ),
        ),
      ],
    );
  }
}

class _SubscriptionStatusCard extends StatelessWidget {
  final String status;
  final DateTime? expiry;

  const _SubscriptionStatusCard({required this.status, this.expiry});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final colorScheme = theme.colorScheme;
    final statusLower = status.toLowerCase();
    final isActive = statusLower == 'active' || statusLower == 'trialing';
    final displayStatus =
        status[0].toUpperCase() + status.substring(1).toLowerCase();

    return Container(
      padding: const EdgeInsets.all(ThemeSpacing.sp5),
      decoration: BoxDecoration(
        color: colorScheme.surface,
        borderRadius: ThemeRadius.brLg,
        border: Border.all(
          color:
              isActive
                  ? colorScheme.primary.withValues(alpha: 0.2)
                  : theme.dividerColor,
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                'Membership Status',
                style: theme.textTheme.labelSmall?.copyWith(
                  fontWeight: FontWeight.w600,
                ),
              ),
              Container(
                padding: const EdgeInsets.symmetric(
                  horizontal: 10,
                  vertical: 4,
                ),
                decoration: BoxDecoration(
                  color:
                      isActive
                          ? colorScheme.primary.withValues(alpha: 0.1)
                          : colorScheme.error.withValues(alpha: 0.1),
                  borderRadius: ThemeRadius.brFull,
                ),
                child: Text(
                  displayStatus,
                  style: theme.textTheme.labelSmall?.copyWith(
                    fontWeight: FontWeight.w800,
                    color: isActive ? colorScheme.primary : colorScheme.error,
                  ),
                ),
              ),
            ],
          ),
          if (expiry != null && isActive) ...[
            const SizedBox(height: ThemeSpacing.sp4),
            Text(
              'Renews ${DateFormat('MMMM d, yyyy').format(expiry!)}',
              style: theme.textTheme.bodyLarge?.copyWith(
                fontWeight: FontWeight.w600,
              ),
            ),
          ],
        ],
      ),
    );
  }
}

class _UserStatsGrid extends StatelessWidget {
  final int total;
  final int streak;
  final int today;

  const _UserStatsGrid({
    required this.total,
    required this.streak,
    required this.today,
  });

  @override
  Widget build(BuildContext context) {
    return Row(
      children: [
        Expanded(child: _StatBlock(label: 'Total', value: total.toString())),
        const SizedBox(width: ThemeSpacing.sp3),
        Expanded(child: _StatBlock(label: 'Streak', value: '$streak d')),
        const SizedBox(width: ThemeSpacing.sp3),
        Expanded(child: _StatBlock(label: 'Today', value: today.toString())),
      ],
    );
  }
}

class _StatBlock extends StatelessWidget {
  final String label;
  final String value;

  const _StatBlock({required this.label, required this.value});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    return Container(
      padding: const EdgeInsets.symmetric(vertical: ThemeSpacing.sp4),
      decoration: BoxDecoration(
        color: theme.colorScheme.onSurface,
        borderRadius: ThemeRadius.brLg,
      ),
      child: Column(
        children: [
          Text(
            label,
            style: theme.textTheme.labelSmall?.copyWith(
              color: theme.colorScheme.surface.withValues(alpha: 0.6),
              fontWeight: FontWeight.w600,
            ),
          ),
          const SizedBox(height: 4),
          Text(
            value,
            style: theme.textTheme.titleMedium?.copyWith(
              fontSize: 17,
              fontWeight: FontWeight.w800,
              color: theme.colorScheme.surface,
            ),
          ),
        ],
      ),
    );
  }
}

class _ReferralSection extends ConsumerWidget {
  const _ReferralSection();

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final referralState = ref.watch(profileControllerProvider);
    final theme = Theme.of(context);

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Padding(
          padding: const EdgeInsets.symmetric(vertical: ThemeSpacing.sp2),
          child: Text(
            'Referrals',
            style: theme.textTheme.labelSmall?.copyWith(
              fontWeight: FontWeight.w700,
              letterSpacing: 0.5,
            ),
          ),
        ),
        referralState.when(
          loading: () => const Center(child: CupertinoActivityIndicator()),
          error: (err, _) => Text('Error loading referrals: $err'),
          data: (codes) {
            if (codes.isEmpty) {
              return _CreateReferralCard(
                onTap:
                    () =>
                        ref
                            .read(profileControllerProvider.notifier)
                            .createReferralCode(),
              );
            }
            return Column(
              children:
                  codes.map((c) => ReferralCodeItem(code: c.code)).toList(),
            );
          },
        ),
      ],
    );
  }
}

class _CreateReferralCard extends StatelessWidget {
  final VoidCallback onTap;

  const _CreateReferralCard({required this.onTap});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final colorScheme = theme.colorScheme;

    return InkWell(
      onTap: onTap,
      borderRadius: ThemeRadius.brLg,
      child: Container(
        padding: const EdgeInsets.all(ThemeSpacing.sp5),
        decoration: BoxDecoration(
          color: colorScheme.surface,
          borderRadius: ThemeRadius.brLg,
          border: Border.all(color: theme.dividerColor),
        ),
        child: Row(
          children: [
            Icon(
              CupertinoIcons.plus_circle_fill,
              color: colorScheme.primary,
              size: 24,
            ),
            const SizedBox(width: ThemeSpacing.sp4),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'Create Referral Code',
                    style: theme.textTheme.titleMedium?.copyWith(
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                  Text(
                    'Invite friends to join the network',
                    style: theme.textTheme.bodyMedium,
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
