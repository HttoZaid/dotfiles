import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:here_sdk/mapview.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/map/controllers/map_controller.dart';

class MapViewOptionsSheet extends ConsumerWidget {
  const MapViewOptionsSheet({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final scheme = ref.watch(currentMapSchemeProvider);
    final trafficOn = ref.watch(isTrafficEnabledProvider);
    final transitOn = ref.watch(isPublicTransitEnabledProvider);
    final camerasOn = ref.watch(isSafetyCamerasEnabledProvider);
    final lightsOn = ref.watch(isTrafficLightsEnabledProvider);
    final zonesOn = ref.watch(isCongestionZonesEnabledProvider);
    final exitsOn = ref.watch(isRoadExitLabelsEnabledProvider);
    final mapReady = ref.watch(mapControllerProvider) != null;

    final isSatellite = scheme == MapScheme.hybridDay;

    return SafeArea(
      child: SingleChildScrollView(
        padding: const EdgeInsets.fromLTRB(
          ThemeSpacing.sp4,
          ThemeSpacing.sp3,
          ThemeSpacing.sp4,
          ThemeSpacing.sp4,
        ),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Center(
              child: Container(
                width: 36,
                height: 4,
                decoration: BoxDecoration(
                  color: ThemeColors.borderStrong,
                  borderRadius: ThemeRadius.brFull,
                ),
              ),
            ),
            const SizedBox(height: ThemeSpacing.sp5),

            const Padding(
              padding: EdgeInsets.only(bottom: ThemeSpacing.sp3),
              child: Text('Map View', style: ThemeText.headline),
            ),
            Row(
              children: [
                Expanded(
                  child: _MapSchemeCard(
                    label: 'Default',
                    subtitle: 'Streets and labels',
                    icon: Icons.map_outlined,
                    selected: !isSatellite,
                    previewImage:
                        'assets/images/map_preview/map_default_preview.png',
                    onTap:
                        isSatellite
                            ? () {
                              ref
                                  .read(mapControllerProvider.notifier)
                                  .setMapScheme(MapScheme.normalDay);
                              Navigator.of(context).pop();
                            }
                            : null,
                  ),
                ),
                const SizedBox(width: ThemeSpacing.sp3),
                Expanded(
                  child: _MapSchemeCard(
                    label: 'Satellite',
                    subtitle: 'Aerial with labels',
                    icon: Icons.satellite_alt,
                    selected: isSatellite,
                    previewImage:
                        'assets/images/map_preview/map_satellite_preview.png',
                    onTap:
                        !isSatellite
                            ? () {
                              ref
                                  .read(mapControllerProvider.notifier)
                                  .setMapScheme(MapScheme.hybridDay);
                              Navigator.of(context).pop();
                            }
                            : null,
                  ),
                ),
              ],
            ),
            const SizedBox(height: ThemeSpacing.sp6),

            const Padding(
              padding: EdgeInsets.only(bottom: ThemeSpacing.sp3),
              child: Text('Traffic & Transport', style: ThemeText.headline),
            ),
            _FeatureToggleCard(
              icon: Icons.directions_transit,
              label: 'Public transit',
              subtitle: 'Subway, tram and train lines',
              value: transitOn,
              enabled: mapReady,
              onChanged: (_) {
                ref.read(mapControllerProvider.notifier).togglePublicTransit();
              },
            ),
            const SizedBox(height: ThemeSpacing.sp2),
            _FeatureToggleCard(
              icon: Icons.traffic,
              label: 'Traffic',
              subtitle: 'Live traffic flow and incidents',
              value: trafficOn,
              enabled: mapReady,
              onChanged: (_) {
                ref.read(mapControllerProvider.notifier).toggleTrafficFlow();
              },
            ),
            const SizedBox(height: ThemeSpacing.sp6),

            const Padding(
              padding: EdgeInsets.only(bottom: ThemeSpacing.sp3),
              child: Text('Road Features', style: ThemeText.headline),
            ),
            _FeatureToggleCard(
              icon: Icons.videocam_outlined,
              label: 'Safety cameras',
              subtitle: 'Speed and red-light camera locations',
              value: camerasOn,
              enabled: mapReady,
              onChanged: (_) {
                ref
                    .read(mapControllerProvider.notifier)
                    .toggleSafetyCameras();
              },
            ),
            const SizedBox(height: ThemeSpacing.sp2),
            _FeatureToggleCard(
              icon: Icons.traffic_outlined,
              label: 'Traffic lights',
              subtitle: 'Signalised junctions on the map',
              value: lightsOn,
              enabled: mapReady,
              onChanged: (_) {
                ref
                    .read(mapControllerProvider.notifier)
                    .toggleTrafficLights();
              },
            ),
            const SizedBox(height: ThemeSpacing.sp2),
            _FeatureToggleCard(
              icon: Icons.toll_outlined,
              label: 'Congestion zones',
              subtitle: 'ULEZ, congestion charge and clean air zones',
              value: zonesOn,
              enabled: mapReady,
              onChanged: (_) {
                ref
                    .read(mapControllerProvider.notifier)
                    .toggleCongestionZones();
              },
            ),
            const SizedBox(height: ThemeSpacing.sp2),
            _FeatureToggleCard(
              icon: Icons.signpost_outlined,
              label: 'Road exit labels',
              subtitle: 'Junction and motorway exit numbers',
              value: exitsOn,
              enabled: mapReady,
              onChanged: (_) {
                ref
                    .read(mapControllerProvider.notifier)
                    .toggleRoadExitLabels();
              },
            ),
            SizedBox(height: MediaQuery.of(context).padding.bottom),
          ],
        ),
      ),
    );
  }
}

class _MapSchemeCard extends StatelessWidget {
  const _MapSchemeCard({
    required this.label,
    required this.subtitle,
    required this.icon,
    required this.selected,
    required this.previewImage,
    this.onTap,
  });

  final String label;
  final String subtitle;
  final IconData icon;
  final bool selected;
  final String previewImage;
  final VoidCallback? onTap;

  @override
  Widget build(BuildContext context) {
    final borderColor = selected ? ThemeColors.accent : ThemeColors.border;

    return GestureDetector(
      onTap: onTap,
      child: AnimatedContainer(
        duration: ThemeMotion.durBase,
        curve: ThemeMotion.smooth,
        decoration: BoxDecoration(
          color: selected ? ThemeColors.accentSubtle : ThemeColors.bgRaised,
          borderRadius: ThemeRadius.brLg,
          border: Border.all(color: borderColor, width: selected ? 2 : 1),
        ),
        child: ClipRRect(
          borderRadius: ThemeRadius.brLg,
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              SizedBox(
                height: 80,
                child: Stack(
                  fit: StackFit.expand,
                  children: [
                    Image.asset(
                      previewImage,
                      fit: BoxFit.cover,
                      errorBuilder:
                          (context, error, stackTrace) => Container(
                            color: ThemeColors.bgSubtle,
                            child: Icon(
                              icon,
                              size: 32,
                              color: ThemeColors.textTertiary,
                            ),
                          ),
                    ),
                    if (selected)
                      Positioned(
                        top: ThemeSpacing.sp2,
                        right: ThemeSpacing.sp2,
                        child: Container(
                          width: 22,
                          height: 22,
                          decoration: const BoxDecoration(
                            color: ThemeColors.accent,
                            shape: BoxShape.circle,
                          ),
                          child: const Icon(
                            Icons.check,
                            color: Colors.white,
                            size: 14,
                          ),
                        ),
                      ),
                  ],
                ),
              ),
              Padding(
                padding: const EdgeInsets.fromLTRB(
                  ThemeSpacing.sp3,
                  ThemeSpacing.sp2,
                  ThemeSpacing.sp3,
                  ThemeSpacing.sp3,
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Icon(
                          icon,
                          size: 16,
                          color:
                              selected
                                  ? ThemeColors.accent
                                  : ThemeColors.textSecondary,
                        ),
                        const SizedBox(width: ThemeSpacing.sp1),
                        Flexible(
                          child: Text(
                            label,
                            style: ThemeText.subheadline.copyWith(
                              fontWeight: FontWeight.w500,
                              color:
                                  selected
                                      ? ThemeColors.accent
                                      : ThemeColors.textPrimary,
                            ),
                            maxLines: 1,
                            overflow: TextOverflow.ellipsis,
                          ),
                        ),
                      ],
                    ),
                    const SizedBox(height: ThemeSpacing.sp1),
                    Text(
                      subtitle,
                      style: const TextStyle(
                        fontFamily: ThemeFonts.ui,
                        fontSize: 11,
                        fontWeight: FontWeight.w400,
                        height: 1.4,
                        color: ThemeColors.textTertiary,
                      ),
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _FeatureToggleCard extends StatelessWidget {
  const _FeatureToggleCard({
    required this.icon,
    required this.label,
    required this.subtitle,
    required this.value,
    required this.enabled,
    required this.onChanged,
  });

  final IconData icon;
  final String label;
  final String subtitle;
  final bool value;
  final bool enabled;
  final ValueChanged<bool> onChanged;

  @override
  Widget build(BuildContext context) {
    return Opacity(
      opacity: enabled ? 1.0 : 0.45,
      child: Container(
        padding: const EdgeInsets.fromLTRB(
          ThemeSpacing.sp3,
          ThemeSpacing.sp2,
          ThemeSpacing.sp2,
          ThemeSpacing.sp2,
        ),
        decoration: BoxDecoration(
          color: ThemeColors.bgRaised,
          borderRadius: ThemeRadius.brLg,
          border: Border.all(color: ThemeColors.border),
        ),
        child: Row(
          children: [
            Container(
              width: 40,
              height: 40,
              decoration: BoxDecoration(
                color: value ? ThemeColors.accentSubtle : ThemeColors.bgSubtle,
                borderRadius: ThemeRadius.brMd,
              ),
              child: Icon(
                icon,
                size: 20,
                color: value ? ThemeColors.accent : ThemeColors.textTertiary,
              ),
            ),
            const SizedBox(width: ThemeSpacing.sp3),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisSize: MainAxisSize.min,
                children: [
                  Text(label, style: ThemeText.callout),
                  const SizedBox(height: 2),
                  Text(subtitle, style: ThemeText.footnote),
                ],
              ),
            ),
            Transform.scale(
              scale: 0.85,
              child: Switch(
                value: value,
                onChanged: enabled ? onChanged : null,
                activeTrackColor: ThemeColors.accent,
              ),
            ),
          ],
        ),
      ),
    );
  }
}
