import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';

class MapSpeedOverlay extends ConsumerWidget {
  const MapSpeedOverlay({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final location = ref.watch(userLocationStreamProvider).value;
    if (location == null) return const SizedBox.shrink();

    final speedMph = location.speed * 2.23694;
    if (speedMph < 3.0) return const SizedBox.shrink();

    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
      decoration: BoxDecoration(
        color: ThemeColors.bgRaised,
        borderRadius: ThemeRadius.brFull,
        boxShadow: ThemeShadows.sm,
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        crossAxisAlignment: CrossAxisAlignment.baseline,
        textBaseline: TextBaseline.alphabetic,
        children: [
          Text(
            speedMph.toStringAsFixed(0),
            style: const TextStyle(
              fontFamily: ThemeFonts.ui,
              fontSize: 20,
              fontWeight: FontWeight.w600,
              height: 1,
              color: ThemeColors.textPrimary,
            ),
          ),
          const SizedBox(width: 3),
          const Text(
            'mph',
            style: TextStyle(
              fontFamily: ThemeFonts.ui,
              fontSize: 11,
              fontWeight: FontWeight.w500,
              color: ThemeColors.textTertiary,
            ),
          ),
        ],
      ),
    );
  }
}
