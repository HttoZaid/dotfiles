import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/checkpoints/domain/checkpoint_error.dart';
import 'package:ukcheckpoints_app/features/checkpoints/providers/checkpoint_provider.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_empty_view.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_error_view.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_filter_bar.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_list_content.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_search_header.dart';
import 'package:ukcheckpoints_app/features/checkpoints/widgets/checkpoint_shimmer_widget.dart';

class CheckpointListScreen extends ConsumerWidget {
  const CheckpointListScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final theme = Theme.of(context);
    final filteredAsync = ref.watch(filteredCheckpointsProvider);
    final searchQuery = ref.watch(checkpointSearchProvider);
    final location = ref.watch(userLocationStreamProvider).value;
    final isSyncing = filteredAsync.value?.isSyncing ?? false;

    return Scaffold(
      backgroundColor: theme.scaffoldBackgroundColor,
      body: SafeArea(
        bottom: false,
        child: RefreshIndicator(
          onRefresh: () {
            return ref.read(checkpointNotifierProvider.notifier).refresh();
          },
          displacement: ThemeSpacing.sp8,
          color: ThemeColors.accent,
          backgroundColor: ThemeColors.bgRaised,
          strokeWidth: 2,
          child: CustomScrollView(
            physics: const AlwaysScrollableScrollPhysics(),
            slivers: [
              SliverAppBar(
                floating: true,
                snap: true,
                backgroundColor: theme.scaffoldBackgroundColor,
                surfaceTintColor: Colors.transparent,
                elevation: 0,
                centerTitle: false,
                toolbarHeight: 72,
                title: Row(
                  children: [
                    Expanded(
                      child: Text(
                        'Checkpoints',
                        style: theme.textTheme.displayMedium?.copyWith(
                          fontSize: 28,
                          fontWeight: FontWeight.w900,
                          letterSpacing: -1.2,
                          color: ThemeColors.textPrimary,
                        ),
                      ),
                    ),
                    if (isSyncing)
                      const Padding(
                        padding: EdgeInsets.only(right: ThemeSpacing.sp3),
                        child: SizedBox(
                          width: 14,
                          height: 14,
                          child: CircularProgressIndicator(
                            strokeWidth: 2,
                            color: ThemeColors.accent,
                          ),
                        ),
                      ),
                    _CountBadge(count: filteredAsync.value?.total ?? 0),
                  ],
                ),
                bottom: const PreferredSize(
                  preferredSize: Size.fromHeight(104),
                  child: Column(
                    children: [
                      Padding(
                        padding: EdgeInsets.symmetric(
                          horizontal: ThemeSpacing.sp4,
                        ),
                        child: CheckpointSearchHeader(),
                      ),
                      CheckpointFilterBar(),
                      SizedBox(height: ThemeSpacing.sp2),
                    ],
                  ),
                ),
              ),
              filteredAsync.when(
                loading: () => const CheckpointShimmer(),
                error: (err, _) {
                  final message = err is CheckpointError
                      ? err.message
                      : err.toString();
                  return CheckpointErrorView(message: message);
                },
                data: (state) {
                  if (state.checkpoints.isEmpty) {
                    return CheckpointEmptyView(query: searchQuery);
                  }

                  return CheckpointListContent(
                    state: state,
                    searchQuery: searchQuery,
                    userLat: location?.latitude,
                    userLng: location?.longitude,
                  );
                },
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _CountBadge extends StatelessWidget {
  final int count;

  const _CountBadge({required this.count});

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
      decoration: BoxDecoration(
        color: ThemeColors.stone200,
        borderRadius: ThemeRadius.brFull,
      ),
      child: Text(
        count.toString(),
        style: const TextStyle(
          color: ThemeColors.textPrimary,
          fontSize: 12,
          fontWeight: FontWeight.w900,
          fontFamily: ThemeFonts.ui,
        ),
      ),
    );
  }
}
