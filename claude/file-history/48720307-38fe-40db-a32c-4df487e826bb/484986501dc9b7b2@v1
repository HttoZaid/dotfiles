import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/map/controllers/map_controller.dart';

class MapOrientationButton extends ConsumerWidget {
  const MapOrientationButton({super.key});

  bool _isNorth(double bearing) {
    final normalized = bearing % 360;
    return normalized < 1.0 || normalized > 359.0;
  }

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final mapController = ref.watch(mapControllerProvider);
    final bearing = ref.watch(mapBearingProvider);

    if (mapController == null || _isNorth(bearing)) {
      return const SizedBox.shrink();
    }

    return Container(
      decoration: BoxDecoration(
        color: ThemeColors.bgRaised,
        borderRadius: ThemeRadius.brFull,
        boxShadow: ThemeShadows.md,
        border: Border.all(color: ThemeColors.border),
      ),
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          borderRadius: ThemeRadius.brFull,
          onTap: () {
            ref.read(mapControllerProvider.notifier).resetOrientationToNorth();
          },
          child: const Padding(
            padding: EdgeInsets.all(ThemeSpacing.sp3),
            child: Icon(Icons.explore, color: ThemeColors.accent, size: 24),
          ),
        ),
      ),
    );
  }
}
