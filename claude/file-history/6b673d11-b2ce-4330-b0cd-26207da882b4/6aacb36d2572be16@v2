import "server-only";

import { createClient } from "@/lib/supabase/server";
import type { AnalyticsSummary } from "@/app/(dashboard)/analytics/_lib/analytics-types";
import { regenerateSchoolSummaryAction } from "../_actions/regenerate-school-summary";

function parseStringArray(value: unknown): string[] {
  if (Array.isArray(value)) return value as string[];
  if (typeof value === "string") {
    try {
      return JSON.parse(value) as string[];
    } catch {
      return [];
    }
  }
  return [];
}

export async function getSchoolSummary(
  schoolId: string,
): Promise<AnalyticsSummary | null> {
  const supabase = await createClient();
  const {
    data: { user },
    error: authError,
  } = await supabase.auth.getUser();

  if (authError || !user) return null;

  // Build a fingerprint of current analysis IDs for this school
  const { data: lessonData } = await supabase
    .from("lessons")
    .select("id, lesson_analyses(id, created_at)")
    .eq("school_id", schoolId)
    .order("created_at", {
      referencedTable: "lesson_analyses",
      ascending: false,
    })
    .limit(1, { referencedTable: "lesson_analyses" });

  const analysedEntries = (lessonData ?? [])
    .filter((l) => l.lesson_analyses && l.lesson_analyses.length > 0)
    .map((l) => l.lesson_analyses[0])
    .sort((a, b) => a.id.localeCompare(b.id));

  if (analysedEntries.length < 3) return null;

  const fingerprint = analysedEntries.map((a) => `${a.id}|${a.created_at}`).join("|");

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const db = supabase.from as any;
  const { data: row, error: rowError } = await db("analytics_summaries")
    .select("*")
    .eq("scope_type", "school")
    .eq("scope_id", schoolId)
    .maybeSingle();

  if (rowError) {
    console.error("getSchoolSummary: fetch error", { schoolId, error: rowError });
    return null;
  }

  const stale = !row || row.source_fingerprint !== fingerprint;

  if (row) {
    if (stale) {
      // Fire and forget — next load will see the fresh result
      regenerateSchoolSummaryAction(schoolId);
    }
    return {
      strengths: parseStringArray(row.strengths),
      growthOpportunities: parseStringArray(row.growth_opportunities),
      generatedAt: row.generated_at as string,
      stale,
    };
  }

  // No cached row — generate synchronously and return
  const result = await regenerateSchoolSummaryAction(schoolId);
  if (!result.success) return null;

  const { data: freshRow } = await db("analytics_summaries")
    .select("*")
    .eq("scope_type", "school")
    .eq("scope_id", schoolId)
    .maybeSingle();

  if (!freshRow) return null;

  return {
    strengths: parseStringArray(freshRow.strengths),
    growthOpportunities: parseStringArray(freshRow.growth_opportunities),
    generatedAt: freshRow.generated_at as string,
    stale: false,
  };
}
