"use client";

import { StatCard } from "@/app/(dashboard)/organization/_components/stat-card";
import { Button } from "@/components/ui/button";
import { useI18n } from "@/i18n/client-provider";
import { ArrowRightIcon, BuildingsIcon } from "@phosphor-icons/react";
import Link from "next/link";
import type { OrgOverviewData } from "../_queries/get-overview";

type Props = {
  data: OrgOverviewData;
  displayName: string;
};

function getGreetingKey(): "greeting_morning" | "greeting_afternoon" | "greeting_evening" {
  const h = new Date().getHours();
  if (h < 12) return "greeting_morning";
  if (h < 17) return "greeting_afternoon";
  return "greeting_evening";
}

export function OrgOverview({ data, displayName }: Props) {
  const t = useI18n();
  const copy = t.dashboard.overview;

  const greeting = copy[getGreetingKey()];

  return (
    <div className="space-y-6">
      <header>
        <p className="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
          {data.organizationName}
        </p>
        <p className="mt-0.5 text-sm text-muted-foreground">{greeting}</p>
        <h1 className="text-2xl font-medium tracking-tight">{displayName}</h1>
      </header>

      <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <StatCard label={copy.org_schools} value={data.schoolsCount} />
        <StatCard label={copy.org_members} value={data.totalMembers} />
        <StatCard
          label={copy.org_pending}
          value={data.totalPending}
          tone={data.totalPending > 0 ? "warning" : "default"}
        />
        <StatCard
          label={copy.org_no_principal}
          value={data.schoolsNoPrincipal}
          tone={data.schoolsNoPrincipal > 0 ? "warning" : "default"}
        />
      </div>

      <div className="flex flex-col gap-3 rounded-xl border border-border bg-card p-4">
        <h2 className="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
          {copy.quick_actions}
        </h2>
        <div className="flex flex-wrap gap-2">
          <Button asChild variant="outline" size="sm">
            <Link href="/organization">
              <BuildingsIcon size={13} weight="bold" />
              {copy.org_view_all}
              <ArrowRightIcon size={11} weight="bold" />
            </Link>
          </Button>
        </div>
      </div>
    </div>
  );
}
