import { notFound, redirect } from "next/navigation";
import { getUserProfile, getSchool } from "../_queries/school";
import { getSchoolAnalytics } from "./_queries/get-school-analytics";
import { SchoolAnalyticsShell } from "./_components/school-analytics-shell";

export const dynamic = "force-dynamic";

export default async function SchoolAnalyticsPage() {
  const { user, profile } = await getUserProfile();

  if (!user) redirect("/sign-in");
  if (!profile?.school_id) notFound();
  if (profile.role !== "principal" && profile.role !== "head_of_department") {
    redirect("/forbidden");
  }

  const [school, analytics] = await Promise.all([
    getSchool(profile.school_id),
    getSchoolAnalytics(profile.school_id),
  ]);

  if (!analytics) notFound();

  return (
    <SchoolAnalyticsShell
      schoolName={school?.name ?? "Your School"}
      data={analytics}
    />
  );
}
