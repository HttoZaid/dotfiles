import { escHtml, renderTemplate } from "../_lib/render";

export type AnalysisCompleteEmailArgs = {
  to: string;
  teacherName: string;
  lessonTitle: string;
  lessonLink: string;
};

export async function buildAnalysisCompleteEmail(
  args: AnalysisCompleteEmailArgs,
): Promise<{ subject: string; html: string }> {
  const html = await renderTemplate("analysis-complete", {
    teacher_name: escHtml(args.teacherName),
    lesson_title: escHtml(args.lessonTitle),
    lesson_link: args.lessonLink,
  });

  return {
    subject: `Your lesson analysis is ready — ${args.lessonTitle}`,
    html,
  };
}
