"use client";

import Image from "next/image";
import { cn } from "@/lib/utils";
import type { TeacherStat } from "../_queries/get-school-analytics";
import type { Classification } from "@/app/(dashboard)/analytics/_lib/analytics-types";

type Props = {
  teachers: TeacherStat[];
};

const RATING_LABEL: Record<Classification, string> = {
  excellent: "Excellent",
  good: "Good",
  satisfactory: "Satisfactory",
  needs_improvement: "Needs Improvement",
};

const RATING_STYLE: Record<Classification, string> = {
  excellent: "bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/30 dark:text-emerald-400 dark:border-emerald-800/40",
  good: "bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/30 dark:text-blue-400 dark:border-blue-800/40",
  satisfactory: "bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/30 dark:text-amber-400 dark:border-amber-800/40",
  needs_improvement: "bg-red-50 text-red-700 border-red-200 dark:bg-red-950/30 dark:text-red-400 dark:border-red-800/40",
};

function scoreColor(score: number) {
  if (score >= 80) return "text-emerald-600 dark:text-emerald-400";
  if (score >= 60) return "text-amber-600 dark:text-amber-400";
  return "text-red-600 dark:text-red-400";
}

function Avatar({ name, url }: { name: string; url: string | null }) {
  const initials = name
    .split(" ")
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

  return (
    <div className="flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border bg-muted text-[11px] font-semibold text-muted-foreground">
      {url ? (
        <Image src={url} alt="" width={32} height={32} className="size-full object-cover" />
      ) : (
        initials
      )}
    </div>
  );
}

function RatingBadge({ rating }: { rating: Classification }) {
  return (
    <span
      className={cn(
        "rounded-md border px-2 py-0.5 text-[11px] font-semibold",
        RATING_STYLE[rating],
      )}
    >
      {RATING_LABEL[rating]}
    </span>
  );
}

export function TeacherBreakdownTable({ teachers }: Props) {
  if (teachers.length === 0) return null;

  return (
    <div className="rounded-xl border bg-card overflow-hidden">
      <div className="px-5 py-4 border-b border-border flex items-center justify-between gap-4">
        <div>
          <h2 className="text-[15px] font-semibold tracking-tight">Staff Overview</h2>
          <p className="text-[12px] text-muted-foreground mt-0.5">
            Quick glance at teacher performance across the school.
          </p>
        </div>
        <span className="rounded-full bg-muted px-2.5 py-1 text-[11px] font-medium text-muted-foreground shrink-0">
          {teachers.length} teachers
        </span>
      </div>
      <div className="overflow-x-auto">
        <table className="w-full text-sm">
          <thead>
            <tr className="border-b border-border bg-muted/25">
              <th className="px-5 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                Teacher
              </th>
              <th className="hidden md:table-cell px-4 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                Dept
              </th>
              <th className="hidden sm:table-cell px-4 py-2.5 text-right text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                Lessons
              </th>
              <th className="px-4 py-2.5 text-center text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                Rating
              </th>
              <th className="px-5 py-2.5 text-right text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                Score
              </th>
            </tr>
          </thead>
          <tbody className="divide-y divide-border">
            {teachers.map((teacher) => (
              <tr key={teacher.id} className="hover:bg-muted/20 transition-colors group">
                <td className="px-5 py-3.5">
                  <div className="flex items-center gap-3 min-w-0">
                    <Avatar name={teacher.name} url={teacher.avatarUrl} />
                    <div className="min-w-0">
                      <p className="truncate font-medium text-[13px] text-foreground leading-tight">
                        {teacher.name}
                      </p>
                      <p className="mt-0.5 text-[11px] text-muted-foreground">
                        {teacher.role === "head_of_department" ? "Head of Dept." : "Teacher"}
                      </p>
                    </div>
                  </div>
                </td>
                <td className="hidden md:table-cell px-4 py-3.5">
                  <span className="text-[13px] text-muted-foreground">
                    {teacher.department ?? "—"}
                  </span>
                </td>
                <td className="hidden sm:table-cell px-4 py-3.5 text-right tabular-nums">
                  {teacher.totalLessons === 0 ? (
                    <span className="text-[13px] text-muted-foreground">—</span>
                  ) : (
                    <span className="text-[13px] text-foreground">
                      {teacher.analysedLessons}
                      <span className="text-muted-foreground">/{teacher.totalLessons}</span>
                    </span>
                  )}
                </td>
                <td className="px-4 py-3.5 text-center">
                  {teacher.rating ? (
                    <RatingBadge rating={teacher.rating} />
                  ) : (
                    <span className="text-[13px] text-muted-foreground">—</span>
                  )}
                </td>
                <td className="px-5 py-3.5 text-right">
                  {teacher.averageScore !== null ? (
                    <span className={cn("tabular-nums text-[15px] font-semibold", scoreColor(teacher.averageScore))}>
                      {teacher.averageScore}%
                    </span>
                  ) : (
                    <span className="text-[13px] text-muted-foreground">No data</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
