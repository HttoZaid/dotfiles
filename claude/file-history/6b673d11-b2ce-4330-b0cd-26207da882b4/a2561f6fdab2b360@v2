"use client";

import Image from "next/image";
import { useI18n } from "@/i18n/client-provider";
import { cn } from "@/lib/utils";
import type { TeacherStat } from "../_queries/get-school-analytics";

type Props = {
  teachers: TeacherStat[];
};

function ScoreBadge({ score }: { score: number | null }) {
  if (score === null) return <span className="text-muted-foreground text-sm">—</span>;
  const color =
    score >= 80
      ? "text-emerald-600 dark:text-emerald-400"
      : score >= 60
        ? "text-amber-600 dark:text-amber-400"
        : "text-red-600 dark:text-red-400";
  return (
    <span className={cn("tabular-nums text-sm font-medium", color)}>{score}%</span>
  );
}

function Avatar({ name, url }: { name: string; url: string | null }) {
  const initials = name
    .split(" ")
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

  return (
    <div className="flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border bg-muted text-[11px] font-semibold text-muted-foreground">
      {url ? (
        <Image src={url} alt="" width={32} height={32} className="size-full object-cover" />
      ) : (
        initials
      )}
    </div>
  );
}

function RolePill({ role }: { role: string }) {
  return (
    <span className="rounded-sm bg-muted px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
      {role.replace("_", " ")}
    </span>
  );
}

function relativeDate(iso: string): string {
  const diff = Date.now() - new Date(iso).getTime();
  const days = Math.floor(diff / 86400000);
  if (days === 0) return "Today";
  if (days === 1) return "Yesterday";
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months}mo ago`;
  return `${Math.floor(months / 12)}yr ago`;
}

export function TeacherBreakdownTable({ teachers }: Props) {
  const t = useI18n();
  const copy = t.dashboard.organization.school_analytics;

  if (teachers.length === 0) return null;

  return (
    <div className="rounded-lg border bg-card overflow-hidden">
      <div className="p-4 sm:p-5 border-b border-border">
        <h2 className="text-base font-medium tracking-tight">{copy.teacher_breakdown_title}</h2>
        <p className="text-xs text-muted-foreground mt-0.5">{copy.teacher_breakdown_desc}</p>
      </div>
      <div className="overflow-x-auto">
        <table className="w-full text-sm">
          <thead>
            <tr className="border-b border-border bg-muted/30">
              <th className="px-4 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                {copy.col_teacher}
              </th>
              <th className="px-4 py-2.5 text-right text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                {copy.col_lessons}
              </th>
              <th className="px-4 py-2.5 text-right text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                {copy.col_avg_score}
              </th>
              <th className="hidden md:table-cell px-4 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                {copy.col_focus_area}
              </th>
              <th className="hidden sm:table-cell px-4 py-2.5 text-right text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                {copy.col_last_active}
              </th>
            </tr>
          </thead>
          <tbody className="divide-y divide-border">
            {teachers.map((teacher) => (
              <tr key={teacher.id} className="hover:bg-muted/20 transition-colors">
                <td className="px-4 py-3">
                  <div className="flex items-center gap-3 min-w-0">
                    <Avatar name={teacher.name} url={teacher.avatarUrl} />
                    <div className="min-w-0">
                      <p className="truncate font-medium text-foreground leading-tight">
                        {teacher.name}
                      </p>
                      <div className="mt-0.5">
                        <RolePill role={teacher.role} />
                      </div>
                    </div>
                  </div>
                </td>
                <td className="px-4 py-3 text-right tabular-nums">
                  {teacher.totalLessons === 0 ? (
                    <span className="text-muted-foreground">{copy.no_lessons}</span>
                  ) : (
                    <span className="text-foreground">
                      {teacher.analysedLessons}
                      <span className="text-muted-foreground">/{teacher.totalLessons}</span>
                    </span>
                  )}
                </td>
                <td className="px-4 py-3 text-right">
                  <ScoreBadge score={teacher.averageScore} />
                </td>
                <td className="hidden md:table-cell px-4 py-3">
                  {teacher.lowestDimension ? (
                    <span className="rounded-sm bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/40 px-2 py-0.5 text-[11px] font-medium text-amber-700 dark:text-amber-400">
                      {teacher.lowestDimension}
                    </span>
                  ) : (
                    <span className="text-muted-foreground">—</span>
                  )}
                </td>
                <td className="hidden sm:table-cell px-4 py-3 text-right text-muted-foreground">
                  {teacher.lastAnalysedAt
                    ? relativeDate(teacher.lastAnalysedAt)
                    : copy.never}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
