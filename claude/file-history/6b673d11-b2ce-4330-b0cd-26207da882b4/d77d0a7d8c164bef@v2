create table if not exists public.analytics_summaries (
  id                    uuid primary key default gen_random_uuid(),
  scope_type            text not null check (scope_type in ('teacher', 'school', 'organization')),
  scope_id              uuid not null,
  strengths             jsonb not null default '[]'::jsonb,
  growth_opportunities  jsonb not null default '[]'::jsonb,
  source_lesson_count   int  not null,
  source_fingerprint    text not null,
  generated_at          timestamptz not null default now(),
  unique (scope_type, scope_id)
);

alter table public.analytics_summaries enable row level security;

create policy "read own teacher summary" on public.analytics_summaries
  for select
  using (scope_type = 'teacher' and scope_id = auth.uid());

create policy "teacher upsert own summary" on public.analytics_summaries
  for insert
  with check (scope_type = 'teacher' and scope_id = auth.uid());

create policy "teacher update own summary" on public.analytics_summaries
  for update
  using (scope_type = 'teacher' and scope_id = auth.uid());

create policy "principal read school summary" on public.analytics_summaries
  for select
  using (
    scope_type = 'school'
    and exists (
      select 1 from public.profiles
      where id = auth.uid()
        and school_id = analytics_summaries.scope_id
        and role in ('principal', 'head_of_department')
    )
  );

create policy "principal upsert school summary" on public.analytics_summaries
  for insert
  with check (
    scope_type = 'school'
    and exists (
      select 1 from public.profiles
      where id = auth.uid()
        and school_id = analytics_summaries.scope_id
        and role in ('principal', 'head_of_department')
    )
  );

create policy "principal update school summary" on public.analytics_summaries
  for update
  using (
    scope_type = 'school'
    and exists (
      select 1 from public.profiles
      where id = auth.uid()
        and school_id = analytics_summaries.scope_id
        and role in ('principal', 'head_of_department')
    )
  );

create policy "org admin read school summary" on public.analytics_summaries
  for select
  using (
    scope_type = 'school'
    and exists (
      select 1 from public.profiles p
      join public.schools s on s.id = analytics_summaries.scope_id
      where p.id = auth.uid()
        and p.role = 'org_admin'
        and s.organization_id = p.organization_id
    )
  );
