"use client";

import type { ReactNode } from "react";
import { BuildingsIcon } from "@phosphor-icons/react";
import { DimensionsChart } from "@/app/(dashboard)/analytics/_components/dimensions-chart";
import { DistributionChart } from "@/app/(dashboard)/analytics/_components/distribution-chart";
import { TrendChart } from "@/app/(dashboard)/analytics/_components/trend-chart";
import type { SchoolAnalyticsData } from "../_queries/get-school-analytics";
import { TeacherBreakdownTable } from "./teacher-breakdown-table";

type Props = {
  schoolName: string;
  data: SchoolAnalyticsData;
  aiSummarySlot: ReactNode;
};

function KpiCard({
  label,
  value,
  sub,
  tone,
}: {
  label: string;
  value: string | number;
  sub?: string;
  tone?: "positive" | "warning" | "default";
}) {
  const valueClass =
    tone === "positive"
      ? "text-emerald-600 dark:text-emerald-400"
      : tone === "warning"
        ? "text-amber-600 dark:text-amber-400"
        : "text-foreground";

  return (
    <div className="rounded-xl border bg-card p-4 flex flex-col gap-1">
      <p className="text-[12px] font-medium text-muted-foreground">{label}</p>
      <p className={`text-2xl font-semibold tabular-nums tracking-tight ${valueClass}`}>
        {value}
      </p>
      {sub && <p className="text-[11px] text-muted-foreground">{sub}</p>}
    </div>
  );
}

export function SchoolAnalyticsShell({ schoolName, data, aiSummarySlot }: Props) {
  const { aggregate, teachers, totalTeacherCount, activeTeacherCount, excellentLessonCount, isEmpty } = data;

  return (
    <div className="space-y-6">
      {/* Header */}
      <header className="flex flex-col gap-1">
        <p className="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
          {schoolName}
        </p>
        <h1 className="text-[22px] font-semibold tracking-tight">School Analytics</h1>
        <p className="text-[13px] text-muted-foreground">
          School-wide teaching performance across all staff.
        </p>
      </header>

      {/* Sage AI Insights — passed from server page */}
      {aiSummarySlot}

      {isEmpty ? (
        <div className="flex flex-col items-center justify-center gap-3 px-6 py-24 text-center rounded-xl border bg-card">
          <div className="flex size-12 items-center justify-center rounded-full bg-muted text-muted-foreground ring-1 ring-border">
            <BuildingsIcon size={24} />
          </div>
          <h3 className="text-[15px] font-medium text-foreground">No lessons analysed yet</h3>
          <p className="max-w-[400px] text-[13px] leading-relaxed text-muted-foreground">
            School-wide analytics appear once teachers start uploading and analysing lessons.
          </p>
        </div>
      ) : (
        <div className="space-y-4">
          {/* KPI Strip */}
          <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <KpiCard
              label="Total Teachers"
              value={totalTeacherCount}
              sub={`${activeTeacherCount} active`}
            />
            <KpiCard
              label="Lessons Analysed"
              value={aggregate.kpis.totalLessons}
              sub="across all staff"
            />
            <KpiCard
              label="Average Score"
              value={`${aggregate.kpis.averageScore}%`}
              sub="school-wide"
              tone={
                aggregate.kpis.averageScore >= 75
                  ? "positive"
                  : aggregate.kpis.averageScore < 50
                    ? "warning"
                    : "default"
              }
            />
            <KpiCard
              label="Excellent Lessons"
              value={excellentLessonCount}
              sub="rated excellent"
              tone={excellentLessonCount > 0 ? "positive" : "default"}
            />
          </div>

          {/* Charts */}
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div className="rounded-xl border bg-card p-5">
              <h2 className="text-[15px] font-semibold tracking-tight">Six Dimensions Performance</h2>
              <p className="text-[12px] text-muted-foreground mt-0.5 mb-4">
                School-wide teaching effectiveness benchmarks.
              </p>
              <DimensionsChart
                dimensions={aggregate.dimensions}
                overallScore={aggregate.overallScore}
                primaryFocusKey={aggregate.kpis.primaryFocus.key}
                totalLessons={aggregate.kpis.totalLessons}
              />
            </div>

            <div className="rounded-xl border bg-card p-5">
              <h2 className="text-[15px] font-semibold tracking-tight">Institutional Distribution</h2>
              <p className="text-[12px] text-muted-foreground mt-0.5 mb-4">
                School-wide performance breakdown by quality tier.
              </p>
              <DistributionChart
                distribution={aggregate.distribution}
                totalLessons={aggregate.kpis.totalLessons}
              />
            </div>
          </div>

          <div className="rounded-xl border bg-card p-5">
            <h2 className="text-[15px] font-semibold tracking-tight">Institutional Performance Trends</h2>
            <p className="text-[12px] text-muted-foreground mt-0.5 mb-4">
              Average school performance across all departments over time.
            </p>
            <TrendChart trend={aggregate.trend} averageScore={aggregate.kpis.averageScore} />
          </div>

          {/* Teacher breakdown */}
          <TeacherBreakdownTable teachers={teachers} />
        </div>
      )}
    </div>
  );
}
