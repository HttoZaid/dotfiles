INSERT INTO public.lesson_analyses (id, lesson_id, kind, payload, model, created_at) VALUES

  -- lesson-4: Cell Respiration (Eve Rahman) — Good, 74%
  ('00000000-0000-0000-0004-000000000012',
   '00000000-0000-0000-0003-000000000004', 'full_analysis',
   '{"lesson_id":"00000000-0000-0000-0003-000000000004","overall_score":74,"classification":"Good","summary":"A clear and engaging lesson on aerobic and anaerobic respiration. Eve structured the content logically and maintained a positive classroom atmosphere throughout. Formative assessment checks were present but could be more systematic.","metrics":[{"name":"lesson_structure","label":"Good","score":76,"narrative":"The lesson followed a clear sequence with an explicit starter activity, well-paced main input, and a consolidation task. Learning objectives were shared verbally but not displayed throughout.","factors":[{"text":"Logical progression from aerobic to anaerobic respiration.","type":"strength"},{"text":"Effective starter activity activating prior knowledge.","type":"strength"},{"text":"Display learning objectives for the full lesson duration.","type":"improvement","technique":"Learning Objectives"},{"text":"Include a formal plenary to consolidate key vocabulary.","type":"improvement","technique":"Lesson Closure"}]},{"name":"behaviour_management","label":"Good","score":78,"narrative":"Classroom atmosphere was calm and productive. Transitions between activities were smooth and student behaviour was consistently on-task.","factors":[{"text":"Positive, calm tone maintained throughout.","type":"strength"},{"text":"Smooth transitions between activities with clear instructions.","type":"strength"},{"text":"Use proximity more to pre-empt low-level disruption at the back.","type":"improvement","technique":"Proximity Management"},{"text":"Establish a consistent signal for silent working time.","type":"improvement","technique":"Classroom Routines"}]},{"name":"clarity","label":"Good","score":80,"narrative":"Explanations were accurate and well-paced. The use of an equation to summarise aerobic respiration was effective. Some technical vocabulary was introduced without sufficient scaffolding.","factors":[{"text":"Clear and accurate scientific explanations throughout.","type":"strength"},{"text":"Effective use of equations as visual anchors.","type":"strength"},{"text":"Pre-teach key vocabulary before introducing complex concepts.","type":"improvement","technique":"Vocabulary Instruction"},{"text":"Use diagrams or animations to support verbal explanations.","type":"improvement","technique":"Visual Representation"}]},{"name":"formative_assessment","label":"Satisfactory","score":62,"narrative":"Mini-whiteboards were used once effectively. However, the majority of comprehension checks relied on hands-up responses, which limits whole-class insight into understanding.","factors":[{"text":"Mini-whiteboard activity provided useful whole-class data.","type":"strength"},{"text":"Circulated during group work to check understanding informally.","type":"strength"},{"text":"Replace hands-up with cold-call or randomised questioning.","type":"improvement","technique":"Cold Call"},{"text":"Add an exit ticket at the end of the lesson.","type":"improvement","technique":"Exit Ticket"}]},{"name":"engagement","label":"Good","score":75,"narrative":"Students were consistently on-task and participated actively in the group sorting activity. The real-world context of exercise and energy maintained interest throughout.","factors":[{"text":"Real-world context of exercise made content relatable.","type":"strength"},{"text":"Group sorting activity generated strong peer discussion.","type":"strength"},{"text":"Include more student choice in how they demonstrate understanding.","type":"improvement","technique":"Student Agency"},{"text":"Increase frequency of student talk opportunities.","type":"improvement","technique":"Think-Pair-Share"}]},{"name":"technology","label":"Satisfactory","score":55,"narrative":"A PowerPoint was used competently for displaying content. Technology use was largely passive — students did not interact with any digital tools during the lesson.","factors":[{"text":"Presentation slides were clear and uncluttered.","type":"strength"},{"text":