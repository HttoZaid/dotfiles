-- ENUM VALUES (from migrations)
-- ─────────────────────────────────────────────────────────────────────────────
--  user_role          : teacher | head_of_department | principal | org_admin
--  onboarding_stage   : role_pending | workspace_pending | details_pending | complete
--  lesson_status      : pending | uploaded | processing | ready | failed
--  lesson_source      : video_upload | live_recording | transcript
--  feedback_lang      : en | ar
--  invitation_status  : pending | accepted | expired | revoked
--  notification_tone  : info | success | warning | danger | neutral
--
-- CONSTRAINTS TO KNOW
--   profiles_role_scope_coherent:
--     teacher            → school_id can be NULL (solo teachers allowed)
--     head_of_department → school_id required
--     principal          → school_id required
--     org_admin          → organization_id required, school_id must be NULL
--   invitations_role_scope_coherent:
--     teacher/hod/principal → school_id required, organization_id NULL
--     org_admin             → organization_id required, school_id NULL
--   invitations_hod_needs_department:
--     head_of_department requires department_name
--   lessons_subject_present_when_school:
--     school_id set → subject_id OR subject_label must be non-null
--
-- ID NAMESPACE
--   0000-0000-0000-XXXX  structural (orgs, schools, phases, depts, grades…)
--   0000-0000-0001-XXXX  profiles (auth.users created by seed_users.ts)
--   0000-0000-0002-XXXX  teacher_grades
--   0000-0000-0003-XXXX  lessons
--   0000-0000-0004-XXXX  lesson_analyses
--   0000-0000-0005-XXXX  invitations
--   0000-0000-0006-XXXX  notifications
--   0000-0000-0007-XXXX  notification_events
--   0000-0000-0008-XXXX  action_plans
--
-- EDGE CASES
--   school-3   organization_id = NULL  (standalone school, no org)
--   dept-6     phase_id = NULL         (dept not tied to any phase)
--   user-10    teacher, no school, no org  (solo teacher)
--   user-11    teacher, school set, dept/subject NULL  (joined, not placed)
--   user-12    teacher, school + dept set, subject NULL
--   user-13    teacher at standalone school (no org)
--   lesson-11  school_id = NULL, org only
--   lesson-12  standalone school, no org, dept/subject NULL
--   lesson-13  no school, no org (solo teacher lesson)
--   invite-6   to standalone school (organization_id = NULL)
