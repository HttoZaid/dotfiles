create table if not exists public.analytics_summaries (
  id                    uuid primary key default gen_random_uuid(),
  scope_type            text not null check (scope_type in ('teacher', 'school', 'organization')),
  scope_id              uuid not null,
  strengths             jsonb not null default '[]'::jsonb,
  growth_opportunities  jsonb not null default '[]'::jsonb,
  source_lesson_count   int  not null,
  source_fingerprint    text not null,
  generated_at          timestamptz not null default now(),
  unique (scope_type, scope_id)
);

alter table public.analytics_summaries enable row level security;

create policy "read own teacher summary" on public.analytics_summaries
  for select
  using (scope_type = 'teacher' and scope_id = auth.uid());
