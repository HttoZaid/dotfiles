import {
  bodyText,
  ctaButton,
  detailsBox,
  emailLayout,
  escHtml,
  mutedText,
} from "../_lib/layout";

export type InvitationEmailArgs = {
  to: string;
  inviterName: string;
  schoolName: string;
  role: string;
  inviteLink: string;
  departmentName?: string;
  subjectName?: string;
};

export function buildInvitationEmail(args: InvitationEmailArgs): {
  subject: string;
  html: string;
} {
  const { inviterName, schoolName, role, inviteLink, departmentName, subjectName } =
    args;

  const details: { label: string; value: string }[] = [
    { label: "School", value: schoolName },
    { label: "Role", value: role },
  ];
  if (departmentName) details.push({ label: "Department", value: departmentName });
  if (subjectName) details.push({ label: "Subject", value: subjectName });

  const content = [
    bodyText(`Hi there,`),
    bodyText(
      `<strong>${escHtml(inviterName)}</strong> has invited you to join <strong>${escHtml(schoolName)}</strong> on Learnalyze as a <strong>${escHtml(role)}</strong>.`,
    ),
    detailsBox(details),
    bodyText(
      `Click the button below to accept your invitation and set up your account.`,
    ),
    ctaButton(inviteLink, "Accept invitation"),
    mutedText("This invitation expires in 7&nbsp;days."),
  ].join("\n");

  return {
    subject: `${inviterName} invited you to join ${schoolName} on Learnalyze`,
    html: emailLayout("You're invited to Learnalyze", content),
  };
}
