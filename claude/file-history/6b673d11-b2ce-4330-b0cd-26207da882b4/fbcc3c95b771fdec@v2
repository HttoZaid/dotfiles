import { getUserProfileServer } from "@/app/(dashboard)/school/_queries";
import { notFound } from "next/navigation";
import { getOverviewData } from "./_queries/get-overview";
import { OrgOverview } from "./_components/org-overview";
import { PrincipalOverview } from "./_components/principal-overview";
import { TeacherOverview } from "./_components/teacher-overview";

export const dynamic = "force-dynamic";

export default async function OverviewPage() {
  const [{ profile }, data] = await Promise.all([
    getUserProfileServer(),
    getOverviewData(),
  ]);

  if (!profile || !data) notFound();

  const displayName = profile.display_name ?? profile.email;

  if (data.kind === "teacher" || data.kind === "head_of_department") {
    return <TeacherOverview data={data} displayName={displayName} />;
  }

  if (data.kind === "principal") {
    return <PrincipalOverview data={data} displayName={displayName} />;
  }

  if (data.kind === "org_admin") {
    return <OrgOverview data={data} displayName={displayName} />;
  }

  notFound();
}
