"use client";

import type { ReactNode } from "react";
import { BuildingsIcon } from "@phosphor-icons/react";
import { DimensionsChart } from "@/app/(dashboard)/analytics/_components/dimensions-chart";
import { DistributionChart } from "@/app/(dashboard)/analytics/_components/distribution-chart";
import { TrendChart } from "@/app/(dashboard)/analytics/_components/trend-chart";
import type { SchoolAnalyticsData } from "../_queries/get-school-analytics";
import { TeacherBreakdownTable } from "./teacher-breakdown-table";

type Props = {
  schoolName: string;
  data: SchoolAnalyticsData;
  aiSummarySlot: ReactNode;
  teacherHrefBase?: string;
};

function KpiCard({
  label,
  value,
  sub,
  tone,
}: {
  label: string;
  value: string | number;
  sub?: string;
  tone?: "positive" | "warning" | "default";
}) {
  const valueClass =
    tone === "positive"
      ? "text-emerald-600 dark:text-emerald-400"
      : tone === "warning"
        ? "text-orange-600 dark:text-orange-400"
        : "text-foreground";

  return (
    <div className="rounded-xl border bg-card p-4 flex flex-col gap-1">
      <p className="text-[12px] font-medium text-muted-foreground">{label}</p>
      <p className={`text-2xl font-semibold tabular-nums tracking-tight ${valueClass}`}>
        {value}
      </p>
      {sub && <p className="text-[11px] text-muted-foreground">{sub}</p>}
    </div>
  );
}

const RATING_TIERS = [
  {
    label: "Excellent",
    range: "85–100%",
    desc: "Professional standard with innovative practices",
    color: "bg-emerald-500",
    textColor: "text-emerald-700 dark:text-emerald-400",
    bg: "bg-emerald-50 dark:bg-emerald-950/30",
    border: "border-emerald-200 dark:border-emerald-800/40",
  },
  {
    label: "Good",
    range: "65–84%",
    desc: "Strong teaching with effective practices",
    color: "bg-blue-500",
    textColor: "text-blue-700 dark:text-blue-400",
    bg: "bg-blue-50 dark:bg-blue-950/30",
    border: "border-blue-200 dark:border-blue-800/40",
  },
  {
    label: "Satisfactory",
    range: "39–64%",
    desc: "Solid foundation, room for improvement",
    color: "bg-orange-500",
    textColor: "text-orange-700 dark:text-orange-400",
    bg: "bg-orange-50 dark:bg-orange-950/30",
    border: "border-orange-200 dark:border-orange-800/40",
  },
  {
    label: "Needs Improvement",
