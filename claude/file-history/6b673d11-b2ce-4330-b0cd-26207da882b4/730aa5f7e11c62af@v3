import { escHtml, renderTemplate } from "../_lib/render";

export type InvitationEmailArgs = {
  to: string;
  inviterName: string;
  schoolName: string;
  role: string;
  inviteLink: string;
  departmentName?: string;
  subjectName?: string;
};

export async function buildInvitationEmail(
  args: InvitationEmailArgs,
): Promise<{ subject: string; html: string }> {
  const row = (label: string, value: string) =>
    `<tr>
      <td style="padding:5px 0;font-size:13px;color:#78716c;white-space:nowrap;padding-right:20px">${escHtml(label)}</td>
      <td style="padding:5px 0;font-size:13px;color:#1c1917;font-weight:500">${escHtml(value)}</td>
    </tr>`;

  const html = await renderTemplate("invitation", {
    inviter_name: escHtml(args.inviterName),
    school_name: escHtml(args.schoolName),
    role: escHtml(args.role),
    invite_link: args.inviteLink,
    school_row: row("School", args.schoolName),
    role_row: row("Role", args.role),
    department_row: args.departmentName ? row("Department", args.departmentName) : "",
    subject_row: args.subjectName ? row("Subject", args.subjectName) : "",
  });

  return {
    subject: `${args.inviterName} invited you to join ${args.schoolName} on Learnalyze`,
    html,
  };
}
