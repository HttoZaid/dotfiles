import { createClient } from "@/lib/supabase/server";
import type { AnalyticsSummary } from "../_lib/analytics-types";
import { regenerateAnalyticsSummary } from "../_actions/regenerate-analytics-summary";

export async function getAnalyticsSummary(): Promise<AnalyticsSummary | null> {
  const supabase = await createClient();
  const { data: { user }, error: authError } = await supabase.auth.getUser();
  if (authError || !user) return null;

  const { data: analyses } = await supabase
    .from("lessons")
    .select(`id, lesson_analyses ( id, created_at )`)
    .order("created_at", {
      referencedTable: "lesson_analyses",
      ascending: false,
    })
    .limit(1, { referencedTable: "lesson_analyses" });

  const analysedIds = (analyses ?? [])
    .filter((l) => l.lesson_analyses && l.lesson_analyses.length > 0)
    .map((l) => l.lesson_analyses[0])
    .sort((a, b) => a.id.localeCompare(b.id));

  if (analysedIds.length < 3) return null;

  const fingerprint = analysedIds.map((a) => `${a.id}|${a.created_at}`).join("|");

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const db = supabase.from as any;

  const { data: row, error: rowError } = await db("analytics_summaries")
    .select("*")
    .eq("scope_type", "teacher")
    .eq("scope_id", user.id)
    .maybeSingle();

  if (rowError) {
    console.error("getAnalyticsSummary: fetch error", rowError);
    return null;
  }

  const stale = !row || row.source_fingerprint !== fingerprint;

  if (row) {
    if (stale) {
      regenerateAnalyticsSummary();
    }

    let strengths: string[] = [];
    let growthOpportunities: string[] = [];
    try {
      strengths =
        typeof row.strengths === "string"
          ? JSON.parse(row.strengths)
          : (row.strengths as string[]);
      growthOpportunities =
        typeof row.growth_opportunities === "string"
          ? JSON.parse(row.growth_opportunities)
          : (row.growth_opportunities as string[]);
    } catch {
      // keep empty arrays
    }

    return {
      strengths,
      growthOpportunities,
      generatedAt: row.generated_at as string,
      stale,
    };
  }

  const result = await regenerateAnalyticsSummary();
  if (!result.success) return null;

  const { data: freshRow } = await db("analytics_summaries")
    .select("*")
    .eq("scope_type", "teacher")
    .eq("scope_id", user.id)
    .maybeSingle();

  if (!freshRow) return null;

  let strengths: string[] = [];
  let growthOpportunities: string[] = [];
  try {
    strengths =
      typeof freshRow.strengths === "string"
        ? JSON.parse(freshRow.strengths)
        : (freshRow.strengths as string[]);
    growthOpportunities =
      typeof freshRow.growth_opportunities === "string"
        ? JSON.parse(freshRow.growth_opportunities)
        : (freshRow.growth_opportunities as string[]);
  } catch {
    // keep empty arrays
  }

  return {
    strengths,
    growthOpportunities,
    generatedAt: freshRow.generated_at as string,
    stale: false,
  };
}
