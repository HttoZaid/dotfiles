import "server-only";

import { FROM, getResend } from "./_lib/client";
import {
  type AnalysisCompleteEmailArgs,
  buildAnalysisCompleteEmail,
} from "./_templates/analysis-complete";
import {
  type InvitationEmailArgs,
  buildInvitationEmail,
} from "./_templates/invitation";
import {
  type PasswordResetEmailArgs,
  buildPasswordResetEmail,
} from "./_templates/password-reset";

export type EmailResult = { ok: true } | { ok: false; error: string };

async function send(to: string, subject: string, html: string): Promise<EmailResult> {
  try {
    const { error } = await getResend().emails.send({
      from: FROM,
      to: [to],
      subject,
      html,
    });

    if (error) {
      console.error("email.send failed", { to, subject, error: error.message });
      return { ok: false, error: error.message };
    }

    return { ok: true };
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    console.error("email.send threw", { to, subject, error: message });
    return { ok: false, error: message };
  }
}

async function sendInvitation(args: InvitationEmailArgs): Promise<EmailResult> {
  const { subject, html } = buildInvitationEmail(args);
  return send(args.to, subject, html);
}

async function sendAnalysisComplete(
  args: AnalysisCompleteEmailArgs,
): Promise<EmailResult> {
  const { subject, html } = buildAnalysisCompleteEmail(args);
  return send(args.to, subject, html);
}

async function sendPasswordReset(
  args: PasswordResetEmailArgs,
): Promise<EmailResult> {
  const { subject, html } = buildPasswordResetEmail(args);
  return send(args.to, subject, html);
}

export const email = {
  sendInvitation,
  sendAnalysisComplete,
  sendPasswordReset,
} as const;

export type { InvitationEmailArgs, AnalysisCompleteEmailArgs, PasswordResetEmailArgs };
