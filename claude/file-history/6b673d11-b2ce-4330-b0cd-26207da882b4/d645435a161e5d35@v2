"use client";

import { useI18n } from "@/i18n/client-provider";
import { BuildingsIcon } from "@phosphor-icons/react";
import { DimensionsChart } from "@/app/(dashboard)/analytics/_components/dimensions-chart";
import { DistributionChart } from "@/app/(dashboard)/analytics/_components/distribution-chart";
import { TrendChart } from "@/app/(dashboard)/analytics/_components/trend-chart";
import type { SchoolAnalyticsData } from "../_queries/get-school-analytics";
import { TeacherBreakdownTable } from "./teacher-breakdown-table";

type Props = {
  schoolName: string;
  data: SchoolAnalyticsData;
};

export function SchoolAnalyticsShell({ schoolName, data }: Props) {
  const t = useI18n();
  const copy = t.dashboard.organization.school_analytics;
  const analyticsCopy = t.dashboard.analytics;

  const { aggregate, teachers, activeTeacherCount, isEmpty } = data;

  return (
    <div className="space-y-6">
      <header className="flex flex-col gap-1">
        <p className="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          {schoolName}
        </p>
        <h1 className="text-2xl font-medium tracking-tight">{copy.title}</h1>
        <p className="text-sm text-muted-foreground">{copy.subtitle}</p>
      </header>

      {isEmpty ? (
        <div className="flex flex-col items-center justify-center gap-3 px-6 py-24 text-center rounded-lg border bg-card">
          <div className="flex size-12 items-center justify-center rounded-full bg-muted text-muted-foreground ring-1 ring-border">
            <BuildingsIcon size={24} />
          </div>
          <h3 className="text-[15px] font-medium text-foreground">{copy.empty_title}</h3>
          <p className="max-w-[400px] text-[13px] leading-relaxed text-muted-foreground">
            {copy.empty_body}
          </p>
        </div>
      ) : (
        <div className="space-y-4">
          {/* KPI strip + active teachers count */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            <div className="rounded-lg border bg-card p-4">
              <p className="text-sm text-muted-foreground">{analyticsCopy.kpi_total_lessons}</p>
              <p className="mt-2 text-2xl font-medium tabular-nums tracking-tight">
                {aggregate.kpis.totalLessons}
              </p>
              <p className="mt-0.5 text-xs text-muted-foreground">{analyticsCopy.kpi_analysed_label}</p>
            </div>

            <div className="rounded-lg border bg-card p-4">
              <p className="text-sm text-muted-foreground">{analyticsCopy.kpi_avg_score}</p>
              <p className="mt-2 text-2xl font-medium tabular-nums tracking-tight">
                {aggregate.kpis.averageScore}%
              </p>
              <p className="mt-0.5 text-xs text-muted-foreground">{analyticsCopy.kpi_across_label}</p>
            </div>

            <div className="rounded-lg border bg-card p-4">
              <p className="text-sm text-muted-foreground">{analyticsCopy.kpi_top_rated}</p>
              <p className="mt-2 text-2xl font-medium tabular-nums tracking-tight">
                {aggregate.kpis.topRatedCount}
              </p>
              <p className="mt-0.5 text-xs text-muted-foreground">{analyticsCopy.kpi_top_rated_desc}</p>
            </div>

            <div className="rounded-lg border bg-card p-4">
              <p className="text-sm text-muted-foreground">{analyticsCopy.kpi_primary_focus}</p>
              <p className="mt-2 text-xl font-medium tracking-tight">
                {aggregate.kpis.primaryFocus.label}
              </p>
              <p className="mt-0.5 text-xs text-muted-foreground">
                {aggregate.kpis.primaryFocus.score}% {analyticsCopy.kpi_lowest_dim}
              </p>
            </div>

            <div className="rounded-lg border bg-card p-4">
              <p className="text-sm text-muted-foreground">{copy.active_teachers}</p>
              <p className="mt-2 text-2xl font-medium tabular-nums tracking-tight">
                {activeTeacherCount}
              </p>
              <p className="mt-0.5 text-xs text-muted-foreground">{copy.active_teachers_desc}</p>
            </div>
          </div>

          {/* Charts */}
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div className="rounded-lg border bg-card p-4 sm:p-5">
              <h2 className="text-base font-medium tracking-tight">{analyticsCopy.dimensions_title}</h2>
              <p className="text-xs text-muted-foreground mt-0.5 mb-3">{analyticsCopy.dimensions_desc}</p>
              <DimensionsChart
                dimensions={aggregate.dimensions}
                overallScore={aggregate.overallScore}
                primaryFocusKey={aggregate.kpis.primaryFocus.key}
                totalLessons={aggregate.kpis.totalLessons}
              />
            </div>

            <div className="rounded-lg border bg-card p-4 sm:p-5">
              <h2 className="text-base font-medium tracking-tight">{analyticsCopy.distribution_title}</h2>
              <p className="text-xs text-muted-foreground mt-0.5 mb-3">{analyticsCopy.distribution_desc}</p>
              <DistributionChart
                distribution={aggregate.distribution}
                totalLessons={aggregate.kpis.totalLessons}
              />
            </div>
          </div>

          <div className="rounded-lg border bg-card p-4 sm:p-5">
            <h2 className="text-base font-medium tracking-tight">{analyticsCopy.trend_title}</h2>
            <p className="text-xs text-muted-foreground mt-0.5 mb-3">{analyticsCopy.trend_desc}</p>
            <TrendChart trend={aggregate.trend} averageScore={aggregate.kpis.averageScore} />
          </div>

          {/* Teacher breakdown */}
          <TeacherBreakdownTable teachers={teachers} />
        </div>
      )}
    </div>
  );
}
