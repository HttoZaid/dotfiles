import "server-only";

import { isAnalysisPayload } from "@/app/(dashboard)/lessons/[id]/_lib/analysis-types";
import { OrgSummary } from "@/app/(dashboard)/organization/_lib/types";
import { createClient } from "@/lib/supabase/server";
import { Database } from "@/lib/supabase/types";

type UserRole = Database["public"]["Enums"]["user_role"];

export type TeacherOverviewData = {
  kind: "teacher" | "head_of_department";
  totalLessons: number;
  analysedLessons: number;
  latestScore: number | null;
  activeGoals: number;
  latestGoal: {
    id: string;
    focus_area: string;
    goal_text: string;
    status: string;
  } | null;
};

export type PrincipalOverviewData = {
  kind: "principal";
  schoolName: string;
  schoolCountry: string | null;
  memberCount: number;
  pendingCount: number;
  activeSchoolPlans: number;
};

export type OrgOverviewData = {
  kind: "org_admin";
  organizationName: string;
  schoolsCount: number;
  totalMembers: number;
  totalPending: number;
  schoolsNoPrincipal: number;
};

export type OverviewData =
  | TeacherOverviewData
  | PrincipalOverviewData
  | OrgOverviewData;

export async function getOverviewData(): Promise<OverviewData | null> {
  const supabase = await createClient();

  const {
    data: { user },
    error: authError,
  } = await supabase.auth.getUser();

  if (authError || !user) return null;

  const { data: profile } = await supabase
    .from("profiles")
    .select("id, role, school_id, organization_id")
    .eq("id", user.id)
    .single();

  if (!profile?.role) return null;

  const role = profile.role as UserRole;

  if (role === "teacher" || role === "head_of_department") {
    return getTeacherOverview(user.id, role);
  }

  if (role === "principal") {
    if (!profile.school_id) return null;
    return getPrincipalOverview(profile.school_id);
  }

  if (role === "org_admin") {
    if (!profile.organization_id) return null;
    return getOrgOverview(profile.organization_id);
  }

  return null;
}

async function getTeacherOverview(
  userId: string,
  role: "teacher" | "head_of_department",
): Promise<TeacherOverviewData> {
  const supabase = await createClient();

  const [totalRes, analysedRes, latestLessonRes, activeGoalsRes, latestGoalRes] =
    await Promise.all([
      supabase
        .from("lessons")
        .select("id", { count: "exact", head: true })
        .eq("uploaded_by", userId),

      supabase
        .from("lessons")
        .select("id, lesson_analyses!inner(id)", { count: "exact", head: true })
        .eq("uploaded_by", userId),

      supabase
        .from("lessons")
        .select("id, lesson_analyses(id, payload)")
        .eq("uploaded_by", userId)
        .order("created_at", { ascending: false })
        .limit(1)
        .limit(1, { referencedTable: "lesson_analyses" })
        .maybeSingle(),

      supabase
        .from("action_plans")
        .select("id", { count: "exact", head: true })
        .eq("teacher_id", userId)
        .neq("status", "Met"),

      supabase
        .from("action_plans")
        .select("id, focus_area, goal_text, status")
        .eq("teacher_id", userId)
        .neq("status", "Met")
        .order("updated_at", { ascending: false })
        .limit(1)
        .maybeSingle(),
    ]);

  let latestScore: number | null = null;
  const analyses = latestLessonRes.data?.lesson_analyses;
  if (analyses && analyses.length > 0) {
    const raw = analyses[0].payload;
    if (isAnalysisPayload(raw)) {
      latestScore = Math.round(raw.overall_score);
    }
  }

  return {
    kind: role,
    totalLessons: totalRes.count ?? 0,
    analysedLessons: analysedRes.count ?? 0,
    latestScore,
    activeGoals: activeGoalsRes.count ?? 0,
    latestGoal: latestGoalRes.data ?? null,
  };
}

async function getPrincipalOverview(
  schoolId: string,
): Promise<PrincipalOverviewData> {
  const supabase = await createClient();

  const [schoolRes, membersRes, pendingRes, plansRes] = await Promise.all([
    supabase
      .from("schools")
      .select("name, country")
      .eq("id", schoolId)
      .single(),

    supabase
      .from("profiles")
      .select("id", { count: "exact", head: true })
      .eq("school_id", schoolId)
      .not("role", "is", null),

    supabase
      .from("invitations")
      .select("id", { count: "exact", head: true })
      .eq("school_id", schoolId)
      .eq("status", "pending"),

    supabase
      .from("action_plans")
      .select("id", { count: "exact", head: true })
      .eq("school_id", schoolId)
      .neq("status", "Met"),
  ]);

  return {
    kind: "principal",
    schoolName: schoolRes.data?.name ?? "Your School",
    schoolCountry: schoolRes.data?.country ?? null,
    memberCount: membersRes.count ?? 0,
    pendingCount: pendingRes.count ?? 0,
    activeSchoolPlans: plansRes.count ?? 0,
  };
}

async function getOrgOverview(orgId: string): Promise<OrgOverviewData> {
  const supabase = await createClient();

  const { data, error } = await supabase
    .rpc("get_organization_summary", { p_org_id: orgId })
    .single<OrgSummary>();

  if (error || !data) {
    console.error("getOrgOverview: rpc failed", { error, orgId });
    return {
      kind: "org_admin",
      organizationName: "Your Organization",
      schoolsCount: 0,
      totalMembers: 0,
      totalPending: 0,
      schoolsNoPrincipal: 0,
    };
  }

  return {
    kind: "org_admin",
    organizationName: data.name,
    schoolsCount: data.schools_count,
    totalMembers: data.total_members,
    totalPending: data.total_pending,
    schoolsNoPrincipal: data.schools_no_principal,
  };
}
