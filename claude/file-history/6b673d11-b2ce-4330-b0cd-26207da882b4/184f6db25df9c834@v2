"use client";

import { StatCard } from "@/app/(dashboard)/organization/_components/stat-card";
import { Button } from "@/components/ui/button";
import { useI18n } from "@/i18n/client-provider";
import {
  ArrowRightIcon,
  ChartBarIcon,
  TargetIcon,
  VideoCameraIcon,
} from "@phosphor-icons/react";
import Link from "next/link";
import type { TeacherOverviewData } from "../_queries/get-overview";

type Props = {
  data: TeacherOverviewData;
  displayName: string;
};

function getGreetingKey(): "greeting_morning" | "greeting_afternoon" | "greeting_evening" {
  const h = new Date().getHours();
  if (h < 12) return "greeting_morning";
  if (h < 17) return "greeting_afternoon";
  return "greeting_evening";
}

export function TeacherOverview({ data, displayName }: Props) {
  const t = useI18n();
  const copy = t.dashboard.overview;

  const greeting = copy[getGreetingKey()];
  const scoreDisplay = data.latestScore !== null ? `${data.latestScore}%` : "—";
  const scoreTone =
    data.latestScore === null
      ? "muted"
      : data.latestScore < 60
        ? "warning"
        : "default";

  if (data.totalLessons === 0) {
    return (
      <div className="space-y-6">
        <header>
          <p className="text-sm text-muted-foreground">{greeting}</p>
          <h1 className="text-2xl font-medium tracking-tight">{displayName}</h1>
        </header>

        <div className="flex flex-col items-center justify-center gap-3 rounded-xl border border-border bg-card px-6 py-20 text-center">
          <div className="flex size-12 items-center justify-center rounded-full bg-muted text-muted-foreground ring-1 ring-border">
            <VideoCameraIcon size={22} />
          </div>
          <h2 className="text-[15px] font-medium text-foreground">
            {copy.teacher_no_lessons_title}
          </h2>
          <p className="max-w-sm text-[13px] leading-relaxed text-muted-foreground">
            {copy.teacher_no_lessons_body}
          </p>
          <Button asChild size="sm" className="mt-2">
            <Link href="/lessons/upload">{copy.teacher_upload_first}</Link>
          </Button>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <header>
        <p className="text-sm text-muted-foreground">{greeting}</p>
        <h1 className="text-2xl font-medium tracking-tight">{displayName}</h1>
      </header>

      <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <StatCard label={copy.teacher_lessons_total} value={data.totalLessons} />
        <StatCard label={copy.teacher_lessons_analysed} value={data.analysedLessons} />
        <StatCard
          label={copy.teacher_latest_score}
          value={scoreDisplay}
          tone={scoreTone}
        />
        <StatCard label={copy.teacher_active_goals} value={data.activeGoals} />
      </div>

      <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
        <CurrentGoalCard data={data} copy={copy} />
        <QuickActionsCard copy={copy} />
      </div>
    </div>
  );
}

type CopyShape = ReturnType<typeof useI18n>["dashboard"]["overview"];

function CurrentGoalCard({
  data,
  copy,
}: {
  data: TeacherOverviewData;
  copy: CopyShape;
}) {
  return (
    <div className="flex flex-col gap-4 rounded-xl border border-border bg-card p-4">
      <h2 className="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
        {copy.teacher_current_goal}
      </h2>

      {data.latestGoal ? (
        <div className="flex flex-1 flex-col gap-3">
          <span className="inline-flex w-fit items-center rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-[11px] font-medium text-primary">
            {data.latestGoal.focus_area}
          </span>
          <p className="line-clamp-3 text-[14px] leading-relaxed text-foreground">
            {data.latestGoal.goal_text}
          </p>
          <div className="mt-auto flex items-center justify-between">
            <GoalStatusBadge status={data.latestGoal.status} />
            <Button asChild variant="ghost" size="sm" className="h-7 gap-1 text-xs">
              <Link href="/action-plans">
                {copy.teacher_view_all_goals}
                <ArrowRightIcon size={11} weight="bold" />
              </Link>
            </Button>
          </div>
        </div>
      ) : (
        <div className="flex flex-1 flex-col items-center justify-center gap-2 py-6 text-center">
          <div className="flex size-10 items-center justify-center rounded-full bg-muted">
            <TargetIcon size={18} className="text-muted-foreground" />
          </div>
          <p className="text-[13px] font-medium text-foreground">
            {copy.teacher_no_goal_title}
          </p>
          <p className="max-w-[200px] text-[12px] leading-relaxed text-muted-foreground">
            {copy.teacher_no_goal_body}
          </p>
          <Button asChild variant="outline" size="sm" className="mt-1">
            <Link href="/action-plans">{copy.teacher_set_goal_cta}</Link>
          </Button>
        </div>
      )}
    </div>
  );
}

function QuickActionsCard({ copy }: { copy: CopyShape }) {
  const actions = [
    {
      href: "/lessons/upload",
      label: copy.teacher_upload,
      icon: VideoCameraIcon,
    },
    {
      href: "/analytics",
      label: copy.teacher_analytics,
      icon: ChartBarIcon,
    },
    {
      href: "/action-plans",
      label: copy.teacher_goals,
      icon: TargetIcon,
    },
  ] as const;

  return (
    <div className="flex flex-col gap-4 rounded-xl border border-border bg-card p-4">
      <h2 className="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
        {copy.quick_actions}
      </h2>
      <div className="flex flex-col gap-1.5">
        {actions.map(({ href, label, icon: Icon }) => (
          <Link
            key={href}
            href={href}
            className="flex items-center justify-between rounded-lg px-3 py-2.5 text-[13px] font-medium text-foreground transition-colors hover:bg-accent"
          >
            <div className="flex items-center gap-2.5">
              <Icon size={15} className="text-muted-foreground" />
              {label}
            </div>
            <ArrowRightIcon size={12} weight="bold" className="text-muted-foreground" />
          </Link>
        ))}
      </div>
    </div>
  );
}

function GoalStatusBadge({ status }: { status: string }) {
  const isActive = status === "Active";
  const isMet = status === "Met";

  return (
    <span
      className={
        isActive
          ? "inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium bg-success/10 text-success"
          : isMet
            ? "inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium bg-muted text-muted-foreground"
            : "inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium bg-warning/10 text-warning"
      }
    >
      {status}
    </span>
  );
}
