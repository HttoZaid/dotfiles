import { getUserProfileServer } from "@/app/(dashboard)/school/_queries";
import { can, type Capability } from "@/lib/permissions";
import { ReactNode } from "react";

interface ServerGuardProps {
  cap: Capability | Capability[];
  children: ReactNode;
  fallback?: ReactNode;
}

export async function ServerGuard({
  cap,
  children,
  fallback = null,
}: ServerGuardProps) {
  const { profile } = await getUserProfileServer();
  if (!profile) return <>{fallback}</>;

  const caps = Array.isArray(cap) ? cap : [cap];
  const hasAccess = caps.some((c) =>
    can(c, { role: profile.role, school_id: profile.school_id }),
  );

  if (!hasAccess) return <>{fallback}</>;
  return <>{children}</>;
}
