"use server";

import { createClient } from "@/lib/supabase/server";
import type { ActionStateResponse } from "@/types/actions";

type TableName = Parameters<Awaited<ReturnType<typeof createClient>>["from"]>[0];
type UpsertResult = { error: { message: string } | null };

export async function regenerateSchoolSummaryAction(
  schoolId: string,
): Promise<ActionStateResponse<void>> {
  const supabase = await createClient();
  const {
    data: { user },
    error: authError,
  } = await supabase.auth.getUser();

  if (authError || !user) {
    return { success: false, message: "Authentication required" };
  }

  const { data: profile } = await supabase
    .from("profiles")
    .select("role, school_id, organization_id")
    .eq("id", user.id)
    .single();

  const isPrincipal =
    (profile?.role === "principal" || profile?.role === "head_of_department") &&
    profile.school_id === schoolId;
  const isOrgAdmin = profile?.role === "org_admin";

  if (!isPrincipal && !isOrgAdmin) {
    return { success: false, message: "You don't have permission to do that." };
  }

  try {
    const { data, error: fetchError } = await supabase
      .from("lessons")
      .select("id, lesson_analyses(id, payload, created_at)")
      .eq("school_id", schoolId)
      .order("created_at", {
        referencedTable: "lesson_analyses",
        ascending: false,
      })
      .limit(1, { referencedTable: "lesson_analyses" });

    if (fetchError || !data) {
      console.error("regenerateSchoolSummaryAction: fetch error", {
        schoolId,
        error: fetchError,
      });
      return { success: false, message: "Failed to fetch lesson data." };
    }

    const analysed = data.filter(
      (l) => l.lesson_analyses && l.lesson_analyses.length > 0,
    );

    if (analysed.length < 3) {
      return {
        success: false,
        message: "Not enough analysed lessons — need at least 3.",
      };
    }

    const { isAnalysisPayload } = await import(
      "@/app/(dashboard)/lessons/[id]/_lib/analysis-types"
    );

    const validPayloads = analysed
      .map((l) => l.lesson_analyses[0].payload)
      .filter((p) => isAnalysisPayload(p));

    if (validPayloads.length < 3) {
      return { success: false, message: "Not enough valid analysis data." };
    }

    const strengths: string[] = [];
    const growthOpportunities: string[] = [];

    for (const p of validPayloads) {
      const ps = p.performance_summary;
      if (ps) {
        for (const s of ps.key_strengths ?? []) strengths.push(s.text);
        for (const a of ps.areas_for_improvement ?? []) growthOpportunities.push(a.text);
      }
    }

    const analysisIds = analysed.map((l) => l.lesson_analyses[0].id).sort();
    const fingerprint = analysisIds.join("|");

    const { error: upsertError } = (await supabase
      .from("analytics_summaries" as TableName)
      .upsert(
        {
          scope_type: "school",
          scope_id: schoolId,
          strengths: JSON.stringify(strengths.slice(0, 6)),
          growth_opportunities: JSON.stringify(growthOpportunities.slice(0, 6)),
          source_lesson_count: analysed.length,
          source_fingerprint: fingerprint,
          generated_at: new Date().toISOString(),
        } as never,
        { onConflict: "scope_type,scope_id" },
      )) as unknown as UpsertResult;

    if (upsertError) {
      console.error("regenerateSchoolSummaryAction: upsert error", {
        schoolId,
        error: upsertError,
      });
      return { success: false, message: "Failed to save insights." };
    }

    return { success: true, message: null };
  } catch (error) {
    console.error("regenerateSchoolSummaryAction:", { schoolId, error });
    return { success: false, message: "An unexpected error occurred." };
  }
}
