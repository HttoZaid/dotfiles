import {
  bodyText,
  ctaButton,
  emailLayout,
  escHtml,
  mutedText,
} from "../_lib/layout";

export type AnalysisCompleteEmailArgs = {
  to: string;
  teacherName: string;
  lessonTitle: string;
  lessonLink: string;
};

export function buildAnalysisCompleteEmail(args: AnalysisCompleteEmailArgs): {
  subject: string;
  html: string;
} {
  const { teacherName, lessonTitle, lessonLink } = args;

  const successBadge = `
<table cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px">
  <tr>
    <td style="background:#f0fdf9;border:1px solid #ccfbee;border-radius:8px;padding:12px 16px">
      <table cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding-right:10px;vertical-align:middle">
            <span style="display:inline-block;width:20px;height:20px;background:#44c5a0;border-radius:50%;text-align:center;line-height:20px;font-size:12px;color:#0a2e24;font-weight:700">&check;</span>
          </td>
          <td style="vertical-align:middle;font-size:13px;font-weight:600;color:#0a5c3f">Analysis complete</td>
        </tr>
      </table>
    </td>
  </tr>
</table>`;

  const lessonCard = `
<table cellpadding="0" cellspacing="0" border="0" style="width:100%;border:1px solid #e7e5e4;border-radius:8px;margin:20px 0">
  <tr>
    <td style="padding:14px 16px">
      <p style="margin:0 0 2px;font-size:11px;font-weight:600;color:#a8a29e;text-transform:uppercase;letter-spacing:0.06em">Lesson</p>
      <p style="margin:0;font-size:15px;font-weight:600;color:#1c1917">${escHtml(lessonTitle)}</p>
    </td>
  </tr>
</table>`;

  const content = [
    successBadge,
    bodyText(`Hi ${escHtml(teacherName)},`),
    bodyText(
      `Your lesson analysis is ready. Head over to Learnalyze to review your detailed feedback across all six teaching dimensions.`,
    ),
    lessonCard,
    ctaButton(lessonLink, "View analysis"),
    mutedText(
      `Keep it up &mdash; consistent reflection is how great teachers get better.`,
    ),
  ].join("\n");

  return {
    subject: `Your lesson analysis is ready — ${lessonTitle}`,
    html: emailLayout("Lesson analysis ready", content),
  };
}
