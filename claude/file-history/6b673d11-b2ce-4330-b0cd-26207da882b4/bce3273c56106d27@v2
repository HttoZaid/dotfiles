export function escHtml(s: string): string {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

export function ctaButton(href: string, label: string): string {
  return `<table cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 8px">
<tr>
  <td style="border-radius:8px;background:#44c5a0">
    <a href="${escHtml(href)}" style="display:inline-block;padding:13px 28px;font-size:14px;font-weight:600;color:#0a2e24;text-decoration:none;letter-spacing:-0.01em">${escHtml(label)} &rarr;</a>
  </td>
</tr>
</table>`;
}

export function detailsBox(rows: { label: string; value: string }[]): string {
  const items = rows
    .map(
      (r) =>
        `<tr><td style="padding:3px 0;font-size:13px;color:#57534e;white-space:nowrap;padding-right:12px">${escHtml(r.label)}</td><td style="padding:3px 0;font-size:13px;color:#1c1917;font-weight:500">${escHtml(r.value)}</td></tr>`,
    )
    .join("\n");

  return `<table cellpadding="0" cellspacing="0" border="0" style="width:100%;background:#f5f5f4;border-radius:8px;padding:14px 16px;margin:20px 0;border:1px solid #e7e5e4">
<tr><td><table cellpadding="0" cellspacing="0" border="0">${items}</table></td></tr>
</table>`;
}

export function bodyText(s: string): string {
  return `<p style="margin:0 0 16px;font-size:15px;color:#292524;line-height:1.65">${s}</p>`;
}

export function mutedText(s: string): string {
  return `<p style="margin:12px 0 0;font-size:13px;color:#a8a29e;line-height:1.6">${s}</p>`;
}
