import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/navigation/models/navigation_phase.dart';
import 'package:ukcheckpoints_app/features/navigation/providers/nav_state_provider.dart';
import 'package:ukcheckpoints_app/features/navigation/search/nav_search_notifier.dart';
import 'package:ukcheckpoints_app/features/navigation/sheets/route_checkpoints_section.dart';
import 'package:ukcheckpoints_app/features/navigation/sheets/trip_overview_content.dart';
import 'package:ukcheckpoints_app/features/navigation/utils/strings.dart';
import 'package:ukcheckpoints_app/features/navigation/utils/uk_formatter.dart';

/// Full-sheet guidance view shown when the user expands the sheet while a
/// route is active (TripOverview or ActiveDrive).
///
/// For TripOverview it delegates to [NavTripOverviewContent] (which already
/// contains the complete layout + checkpoints). For ActiveDrive it shows the
/// current route summary, the checkpoint list, and an "End trip" button.
class NavGuidanceFullContent extends ConsumerWidget {
  const NavGuidanceFullContent({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    return switch (ref.watch(navStateNotifierProvider)) {
      TripOverview() => const NavTripOverviewContent(),
      ActiveDrive() => const _ActiveDriveFullContent(),
      _ => const SizedBox.shrink(),
    };
  }
}

// ─── Active-drive full view ────────────────────────────────────────────────

class _ActiveDriveFullContent extends ConsumerWidget {
  const _ActiveDriveFullContent();

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final phase = ref.watch(navStateNotifierProvider);
    if (phase is! ActiveDrive) return const SizedBox.shrink();

    final route = phase.route;
    final dest = ref.watch(navSearchNotifierProvider).selectedDest;
    final destName = dest?.title ?? NavStrings.goingToHint;

    final dur = route.duration;
    final hours = dur.inHours;
    final mins = dur.inMinutes.remainder(60);
    final durationStr = hours > 0 ? '${hours}h ${mins}m' : '$mins min';

    final eta = DateTime.now().add(dur);
    final etaStr = TimeOfDay.fromDateTime(eta).format(context);
    final distStr = UkFormatter.formatDistance(route.lengthInMeters);

    return Padding(
      padding: const EdgeInsets.fromLTRB(
        ThemeSpacing.sp4,
        ThemeSpacing.sp2,
        ThemeSpacing.sp4,
        ThemeSpacing.sp5,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          // Destination row
          Row(
            children: [
              const Icon(Icons.navigation, size: 18, color: ThemeColors.accent),
              const SizedBox(width: ThemeSpacing.sp2),
              Expanded(
                child: Text(
                  destName,
                  style: ThemeText.titleMedium,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                ),
              ),
            ],
          ),

          const SizedBox(height: ThemeSpacing.sp4),

          // Summary chips
          IntrinsicHeight(
            child: Row(
              children: [
                _InfoChip(label: NavStrings.arrivalLabel, value: etaStr),
                const _Divider(),
                _InfoChip(label: NavStrings.durationLabel, value: durationStr),
                const _Divider(),
                _InfoChip(label: NavStrings.distanceLabel, value: distStr),
              ],
            ),
          ),

          const SizedBox(height: ThemeSpacing.sp4),

          // Route checkpoints (sorted by distance along route)
          const RouteCheckpointsSection(),

          const SizedBox(height: ThemeSpacing.sp4),

          FilledButton(
            style: FilledButton.styleFrom(
              backgroundColor: ThemeColors.danger,
            ),
            onPressed: () =>
                ref.read(navStateNotifierProvider.notifier).stopDrive(),
            child: const Text(NavStrings.endTripCta),
          ),
        ],
      ),
    );
  }
}

// ─── Shared sub-widgets ────────────────────────────────────────────────────

class _InfoChip extends StatelessWidget {
  final String label;
  final String value;

  const _InfoChip({required this.label, required this.value});

  @override
  Widget build(BuildContext context) {
    return Expanded(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Text(
            value,
            style: ThemeText.titleMedium,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
          ),
          Text(
            label,
            style: ThemeText.labelSmall.copyWith(
              color: ThemeColors.textTertiary,
            ),
          ),
        ],
      ),
    );
  }
}

class _Divider extends StatelessWidget {
  const _Divider();

  @override
  Widget build(BuildContext context) {
    return const SizedBox(
      width: 1,
      height: 36,
      child: DecoratedBox(
        decoration: BoxDecoration(color: ThemeColors.border),
      ),
    );
  }
}
