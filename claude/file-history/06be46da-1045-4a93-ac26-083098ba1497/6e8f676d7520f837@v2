// ─── MaterialApp theme ────────────────────────────────────────
// useMaterial3: true throughout.
// Fixed ColorScheme — all 30 M3 roles populated explicitly.
// No colorSchemeSeed / dynamic color (see pack identity above).

abstract final class AppTheme {
  static ThemeData get light {
    const cs = ColorScheme.light(
      // Primary — brand blue
      primary:            ThemeColors.accent,
      onPrimary:          ThemeColors.surface,
      primaryContainer:   ThemeColors.accentSubtle,
      onPrimaryContainer: ThemeColors.accentStrong,

      // Secondary — neutral, co-equal actions
      secondary:            ThemeColors.secondary,
      onSecondary:          ThemeColors.surface,
      secondaryContainer:   ThemeColors.secondaryContainer,
      onSecondaryContainer: ThemeColors.onSecondaryContainer,

      // Tertiary — mapped to neutral to prevent M3 teal bleed
      tertiary:            ThemeColors.textTertiary,
      onTertiary:          ThemeColors.surface,
      tertiaryContainer:   ThemeColors.surfaceContainer,
      onTertiaryContainer: ThemeColors.textSecondary,

      // Error
      error:            ThemeColors.danger,
      onError:          ThemeColors.surface,
      errorContainer:   ThemeColors.dangerSubtle,
      onErrorContainer: ThemeColors.danger,

      // Surface container hierarchy (lowest → highest elevation)
      surface:                 ThemeColors.surface,
      onSurface:               ThemeColors.textPrimary,
      onSurfaceVariant:        ThemeColors.textSecondary,
      surfaceContainerLowest:  ThemeColors.bg,
      surfaceContainerLow:     ThemeColors.surface,
      surfaceContainer:        ThemeColors.surfaceContainer,
      surfaceContainerHigh:    ThemeColors.surfaceContainerHigh,
      surfaceContainerHighest: _Palette.n200,

      // Inverse — snackbars, dark-surface chips
      inverseSurface:   ThemeColors.textPrimary,
      onInverseSurface: ThemeColors.surface,
      inversePrimary:   ThemeColors.accentSubtle,

      // Outline
      outline:        ThemeColors.borderStrong,
      outlineVariant: ThemeColors.border,

      // Scrim / shadow base
      scrim:  Color(0xFF000000),
      shadow: _Palette.n900,
    );

    return ThemeData(
      useMaterial3: true,
      fontFamily: ThemeFonts.ui,
      colorScheme: cs,
      scaffoldBackgroundColor: ThemeColors.bg,
      primaryColor: ThemeColors.accent,
      splashFactory: InkRipple.splashFactory,

      // ── Full M3 15-token text theme ──
      textTheme: const TextTheme(
        displayLarge:   ThemeText.displayLarge,
        displayMedium:  ThemeText.displayMedium,
        displaySmall:   ThemeText.displaySmall,
        headlineLarge:  ThemeText.headlineLarge,
        headlineMedium: ThemeText.headlineMedium,
        headlineSmall:  ThemeText.headlineSmall,
        titleLarge:     ThemeText.titleLarge,
        titleMedium:    ThemeText.titleMedium,
        titleSmall:     ThemeText.titleSmall,
        bodyLarge:      ThemeText.bodyLarge,
        bodyMedium:     ThemeText.bodyMedium,
        bodySmall:      ThemeText.bodySmall,
        labelLarge:     ThemeText.labelLarge,
        labelMedium:    ThemeText.labelMedium,
        labelSmall:     ThemeText.labelSmall,
      ),

      // ── Buttons — M3 Expressive pill shape, 48dp L-size ──
      elevatedButtonTheme: ElevatedButtonThemeData(
        style: ElevatedButton.styleFrom(
          backgroundColor: ThemeColors.accent,
          foregroundColor: ThemeColors.surface,
          elevation: 0,
          shadowColor: Colors.transparent,
          minimumSize: const Size(0, 48),
          padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
          shape: const StadiumBorder(),
          textStyle: ThemeText.labelLarge.copyWith(color: ThemeColors.surface),
        ).copyWith(
          overlayColor: WidgetStateProperty.all(Colors.black12),
        ),
      ),

      filledButtonTheme: FilledButtonThemeData(
        style: FilledButton.styleFrom(
          backgroundColor: ThemeColors.accent,
          foregroundColor: ThemeColors.surface,
          minimumSize: const Size(0, 48),
          padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
          shape: const StadiumBorder(),
          textStyle: ThemeText.labelLarge,
        ),
      ),

      outlinedButtonTheme: OutlinedButtonThemeData(
        style: OutlinedButton.styleFrom(
          foregroundColor: ThemeColors.textPrimary,
          minimumSize: const Size(0, 48),
          padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
          shape: const StadiumBorder(),
          side: const BorderSide(color: ThemeColors.borderStrong),
          textStyle: ThemeText.labelLarge,
        ),
      ),

      textButtonTheme: TextButtonThemeData(
        style: TextButton.styleFrom(
          foregroundColor: ThemeColors.accent,
          minimumSize: const Size(44, 44),
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
          shape: RoundedRectangleBorder(borderRadius: ThemeRadius.brMedium),
          textStyle: ThemeText.labelLarge,
        ),
      ),

      // ── Inputs — M3 extraSmall corners (4dp) ──
      inputDecorationTheme: InputDecorationTheme(
        filled: true,
        fillColor: ThemeColors.surface,
        contentPadding:
            const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
        hintStyle:
            ThemeText.bodyMedium.copyWith(color: ThemeColors.textTertiary),
        labelStyle:
            ThemeText.labelLarge.copyWith(color: ThemeColors.textSecondary),
        floatingLabelStyle:
            ThemeText.labelMedium.copyWith(color: ThemeColors.accent),
        enabledBorder: OutlineInputBorder(
          borderRadius: ThemeRadius.brExtraSmall,
          borderSide: const BorderSide(color: ThemeColors.borderStrong),
        ),
        focusedBorder: OutlineInputBorder(
          borderRadius: ThemeRadius.brExtraSmall,
          borderSide: const BorderSide(color: ThemeColors.accent, width: 2),
        ),
        errorBorder: OutlineInputBorder(
          borderRadius: ThemeRadius.brExtraSmall,
          borderSide: const BorderSide(color: ThemeColors.danger),
        ),
        focusedErrorBorder: OutlineInputBorder(
          borderRadius: ThemeRadius.brExtraSmall,
          borderSide:
              const BorderSide(color: ThemeColors.danger, width: 2),
        ),
        disabledBorder: OutlineInputBorder(
          borderRadius: ThemeRadius.brExtraSmall,
          borderSide: const BorderSide(color: ThemeColors.border),
        ),
      ),

      // ── Cards — M3 medium corners (12dp), no elevation ──
      cardTheme: CardThemeData(
        color: ThemeColors.surface,
        elevation: 0,
        margin: EdgeInsets.zero,
        shape: RoundedRectangleBorder(
          borderRadius: ThemeRadius.brMedium,
          side: const BorderSide(color: ThemeColors.border),
        ),
      ),

      // ── Bottom sheets — M3 extraLarge top corners (28dp) ──
      bottomSheetTheme: const BottomSheetThemeData(
        backgroundColor: ThemeColors.surface,
        surfaceTintColor: Colors.transparent,
        elevation: 0,
        modalElevation: 0,
        showDragHandle: true,
        dragHandleColor: ThemeColors.borderStrong,
        dragHandleSize: Size(32, 4),
        shape: RoundedRectangleBorder(
          borderRadius: ThemeRadius.brSheet,
