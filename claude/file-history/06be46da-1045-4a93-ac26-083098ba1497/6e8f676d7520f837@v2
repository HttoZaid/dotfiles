// ─── Shape system ─────────────────────────────────────────────
// M3 Expressive shape scale (dp):
//   extraSmall=4  small=8  medium=12  large=16  extraLarge=28  full
// Components pick the corner size matching their role:
//   inputs/snackbars → extraSmall
//   cards            → medium
//   modals / sheets  → extraLarge (28dp top corners)
//   buttons / chips  → full (pill)

abstract final class ThemeRadius {
  // M3 shape tokens
  static const double extraSmall = 4;
  static const double small      = 8;
  static const double medium     = 12;
  static const double large      = 16;
  static const double extraLarge = 28;
  static const double full       = 9999;

  static final BorderRadius brExtraSmall = BorderRadius.circular(extraSmall);
  static final BorderRadius brSmall      = BorderRadius.circular(small);
  static final BorderRadius brMedium     = BorderRadius.circular(medium);
  static final BorderRadius brLarge      = BorderRadius.circular(large);
  static final BorderRadius brExtraLarge = BorderRadius.circular(extraLarge);
  static final BorderRadius brFull       = BorderRadius.circular(full);

  // Sheet top-corners only (M3 modal bottom sheet spec: 28dp)
  static const BorderRadius brSheet = BorderRadius.only(
    topLeft:  Radius.circular(extraLarge),
    topRight: Radius.circular(extraLarge),
  );

  // Legacy aliases — keep while call-sites migrate
  static const double rXs  = extraSmall;
  static const double rSm  = 6;          // off-scale; use extraSmall or small
  static const double rMd  = small;
  static const double rLg  = medium;
  static const double rXl  = large;
  static const double r2xl = 22;         // pre-M3 value; prefer extraLarge
  static const double rFull = full;
  static final BorderRadius brXs  = brExtraSmall;
  static final BorderRadius brSm  = BorderRadius.circular(6);
  static final BorderRadius brMd  = brSmall;
  static final BorderRadius brLg  = brMedium;
  static final BorderRadius brXl  = brLarge;
  static final BorderRadius br2xl = BorderRadius.circular(22);
}

// ─── Elevation / shadows ──────────────────────────────────────
// Shadows signal depth, not decoration.
// 0 → use background contrast or outline instead of shadow
// pop     → hover cards, floating map buttons
// overlay → dropdowns, popovers, autocomplete
// modal   → bottom sheets, dialogs

abstract final class ThemeShadows {
  static const List<BoxShadow> pop = [
    BoxShadow(blurRadius: 2, offset: Offset(0, 1), color: Color(0x0F161A20)),
    BoxShadow(blurRadius: 8, offset: Offset(0, 4), color: Color(0x09161A20)),
  ];
  static const List<BoxShadow> overlay = [
    BoxShadow(blurRadius: 8,  offset: Offset(0, 2), color: Color(0x14161A20)),
    BoxShadow(blurRadius: 20, offset: Offset(0, 8), color: Color(0x0D161A20)),
  ];
  static const List<BoxShadow> modal = [
    BoxShadow(blurRadius: 32, offset: Offset(0, -4), color: Color(0x1A161A20)),
    BoxShadow(blurRadius: 8,  offset: Offset(0,  2), color: Color(0x10161A20)),
  ];

  // Legacy aliases
  static const List<BoxShadow> sm = pop;
  static const List<BoxShadow> md = overlay;
  static const List<BoxShadow> lg = modal;
}

// ─── Motion ───────────────────────────────────────────────────
// M3 Expressive: springs for meaningful state changes,
// easing for enter/exit.
//
// Emil Kowalski's rule: only animate what changes meaning.
// Anything triggered >50×/session should be instant.
//
// Duration budget per interaction tier:
//   instant (0)    keyboard, Esc, frequent nav tabs
//   fast   (100)   hover, focus ring, color change, opacity
//   normal (200)   enter/exit, dropdown, optimistic confirm
//   medium (300)   modal/sheet enter, route reveal
//   slow   (400)   map route draw, complex state change

abstract final class ThemeMotion {
  // ── Named durations ──
  static const Duration instant = Duration(milliseconds: 0);
  static const Duration fast    = Duration(milliseconds: 100);
  static const Duration normal  = Duration(milliseconds: 200);
  static const Duration medium  = Duration(milliseconds: 300);
  static const Duration slow    = Duration(milliseconds: 400);

  // M3 granular scale — use only when fine control is needed
  static const Duration short1  = Duration(milliseconds: 50);
  static const Duration short2  = Duration(milliseconds: 100); // = fast
  static const Duration short3  = Duration(milliseconds: 150);
  static const Duration short4  = Duration(milliseconds: 200); // = normal
  static const Duration medium1 = Duration(milliseconds: 250);
  static const Duration medium2 = Duration(milliseconds: 300); // = medium
  static const Duration medium3 = Duration(milliseconds: 350);
  static const Duration medium4 = Duration(milliseconds: 400); // = slow
  static const Duration long1   = Duration(milliseconds: 450);
  static const Duration long2   = Duration(milliseconds: 500);

  // ── Easing curves ──
  // Enter: decelerate into final position (elements arriving)
  static const Curve easeOut = Cubic(0.16, 1.0, 0.3, 1.0);

  // Exit: accelerate away (elements leaving)
  static const Curve easeIn = Cubic(0.4, 0.0, 1.0, 1.0);

  // Bidirectional / data transitions / color: M3 Standard + Grain fluid
  static const Curve smooth = Cubic(0.2, 0.0, 0.0, 1.0);

  // M3 emphasized — important cross-screen transitions
  static const Curve emphasized = Cubic(0.2, 0.0, 0.0, 1.0);

  // Snappy — fast feedback: button press, chip select, toggle
  static const Curve snappy = Cubic(0.2, 0.0, 0.0, 1.0);

  // Spring — drag/gesture release, FAB expand, physical interactions.
  // Sparingly — not for critical-path or high-frequency actions.
  static const Curve spring = Cubic(0.34, 1.56, 0.64, 1.0);

  // Legacy aliases
  static const Duration durFast   = fast;
  static const Duration durBase   = normal;
  static const Duration durSlow   = medium;
  static const Duration durSlower = slow;
}

