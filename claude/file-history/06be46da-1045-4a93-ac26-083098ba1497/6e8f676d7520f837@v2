      // ── App bar — transparent, no tint ──
      appBarTheme: const AppBarTheme(
        backgroundColor: ThemeColors.surface,
        foregroundColor: ThemeColors.textPrimary,
        elevation: 0,
        scrolledUnderElevation: 0,
        surfaceTintColor: Colors.transparent,
        systemOverlayStyle: SystemUiOverlayStyle(
          statusBarColor: Colors.transparent,
          statusBarIconBrightness: Brightness.dark,
          statusBarBrightness: Brightness.light,
        ),
        titleTextStyle: TextStyle(
          fontFamily: ThemeFonts.ui,
          fontSize: 17,
          fontWeight: FontWeight.w600,
          color: ThemeColors.textPrimary,
        ),
        centerTitle: false,
      ),

      // ── Chip — pill, no border ──
      chipTheme: const ChipThemeData(
        backgroundColor: ThemeColors.surfaceContainer,
        selectedColor: ThemeColors.accentSubtle,
        labelStyle: ThemeText.labelMedium,
        padding: EdgeInsets.symmetric(horizontal: 8, vertical: 4),
        shape: StadiumBorder(),
        elevation: 0,
        pressElevation: 0,
      ),

      // ── Switch ──
      switchTheme: SwitchThemeData(
        thumbColor: WidgetStateProperty.all(ThemeColors.surface),
        trackColor: WidgetStateProperty.resolveWith((states) {
          if (states.contains(WidgetState.selected)) {
            return ThemeColors.accent;
          }
          return ThemeColors.borderStrong;
        }),
        trackOutlineColor:
            WidgetStateProperty.all(Colors.transparent),
      ),

      // ── Snackbar — inverse surface (dark on light) ──
      snackBarTheme: SnackBarThemeData(
        behavior: SnackBarBehavior.floating,
        backgroundColor: ThemeColors.textPrimary,
        contentTextStyle:
            ThemeText.bodyMedium.copyWith(color: ThemeColors.surface),
        shape: RoundedRectangleBorder(
          borderRadius: ThemeRadius.brExtraSmall,
        ),
        elevation: 4,
      ),

      // ── Page transitions — M3 shared-axis on Android ──
      pageTransitionsTheme: const PageTransitionsTheme(
        builders: {
          TargetPlatform.android: ZoomPageTransitionsBuilder(),
          TargetPlatform.iOS: CupertinoPageTransitionsBuilder(),
        },
      ),
    );
  }
}
