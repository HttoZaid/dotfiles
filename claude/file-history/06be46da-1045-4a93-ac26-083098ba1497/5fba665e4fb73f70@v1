import 'dart:async';

import 'package:flutter/material.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';

const double kMapSheetMinExtent = 0.12;
const double kMapSheetMidExtent = 0.50;
const double kMapSheetMaxExtent = 0.92;

class MapBottomSheet extends StatefulWidget {
  const MapBottomSheet({super.key});

  @override
  State<MapBottomSheet> createState() => _MapBottomSheetState();
}

class _MapBottomSheetState extends State<MapBottomSheet> {
  final _controller = DraggableScrollableController();

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  void _onHandleTap() {
    if (!_controller.isAttached) return;
    final atMin = _controller.size < kMapSheetMinExtent + 0.05;
    unawaited(
      _controller.animateTo(
        atMin ? kMapSheetMidExtent : kMapSheetMinExtent,
        duration: ThemeMotion.durSlow,
        curve: ThemeMotion.smooth,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return DraggableScrollableSheet(
      controller: _controller,
      initialChildSize: kMapSheetMinExtent,
      minChildSize: kMapSheetMinExtent,
      maxChildSize: kMapSheetMaxExtent,
      snap: true,
      snapSizes: const [
        kMapSheetMinExtent,
        kMapSheetMidExtent,
        kMapSheetMaxExtent,
      ],
      builder: (context, scrollController) {
        return _SheetSurface(
          scrollController: scrollController,
          onHandleTap: _onHandleTap,
        );
      },
    );
  }
}

class _SheetSurface extends StatelessWidget {
  final ScrollController scrollController;
  final VoidCallback onHandleTap;

  const _SheetSurface({
    required this.scrollController,
    required this.onHandleTap,
  });

  @override
  Widget build(BuildContext context) {
    return DecoratedBox(
      decoration: const BoxDecoration(
        color: ThemeColors.bgRaised,
        borderRadius: BorderRadius.vertical(
          top: Radius.circular(ThemeRadius.r2xl),
        ),
        boxShadow: ThemeShadows.lg,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          // Drag handle — full-width tap target, collapses or expands sheet
          GestureDetector(
            behavior: HitTestBehavior.opaque,
            onTap: onHandleTap,
            child: const _DragHandle(),
          ),
          Expanded(
            child: CustomScrollView(
              controller: scrollController,
              slivers: const [
                // Content placeholder — fill this in when ready
                SliverPadding(
                  padding: EdgeInsets.fromLTRB(
                    ThemeSpacing.sp4,
                    ThemeSpacing.sp2,
                    ThemeSpacing.sp4,
                    ThemeSpacing.sp16,
                  ),
                  sliver: SliverToBoxAdapter(child: SizedBox.shrink()),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

class _DragHandle extends StatelessWidget {
  const _DragHandle();

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      height: 36,
      child: Center(
        child: Container(
          width: 36,
          height: 4,
          decoration: BoxDecoration(
            color: ThemeColors.stone300,
            borderRadius: BorderRadius.circular(2),
          ),
        ),
      ),
    );
  }
}
