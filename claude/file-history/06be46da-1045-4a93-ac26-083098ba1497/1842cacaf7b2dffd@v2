import 'package:riverpod_annotation/riverpod_annotation.dart';
import '../models/sheet_state.dart';

part 'sheet_state_provider.g.dart';

@Riverpod(keepAlive: true)
class SheetStateNotifier extends _$SheetStateNotifier {
  @override
  SheetState build() => const SheetState();

  void peek() => state = state.copyWith(mode: SheetMode.peek);

  void expand() => state = state.copyWith(mode: SheetMode.fullSearch);

  void showTripOverview() => state = state.copyWith(mode: SheetMode.tripOverview);

  void updateOrigin(String value) => state = state.copyWith(typedOrigin: value);

  void updateDest(String value) => state = state.copyWith(typedDest: value);
}
