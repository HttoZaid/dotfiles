import 'package:here_sdk/routing.dart';

/// Camera ownership during an active drive.
enum CameraOwnership {
  /// HERE SDK owns the camera — auto-follows, auto-zooms around turns.
  following,

  /// User has panned the map — camera is released (`cameraBehavior = null`).
  /// Arrow and all data updates continue; only the view has wandered.
  free,
}

/// The top-level navigation state machine.
///
/// Every screen that renders navigation UI switches on this.
/// Transitions happen only through NavStateNotifier — never mutated directly.
sealed class NavigationPhase {
  const NavigationPhase();
}

/// No route, no search — the default idle state.
final class Idle extends NavigationPhase {
  const Idle();
}

/// Autosuggest is running while the user types a destination.
final class Searching extends NavigationPhase {
  const Searching();
}

/// Route has been computed. Sheet is half-open at trip overview.
final class TripOverview extends NavigationPhase {
  final Route route;

  /// True while the async route-checkpoint filter is still running.
  final bool checkpointsLoading;

  const TripOverview({
    required this.route,
    this.checkpointsLoading = true,
  });

  TripOverview copyWith({Route? route, bool? checkpointsLoading}) =>
      TripOverview(
        route: route ?? this.route,
        checkpointsLoading: checkpointsLoading ?? this.checkpointsLoading,
      );
}

/// Turn-by-turn guidance is active.
final class ActiveDrive extends NavigationPhase {
  final Route route;
  final CameraOwnership camera;

  /// True while a silent reroute is in progress.
  final bool isRerouting;

  const ActiveDrive({
    required this.route,
    this.camera = CameraOwnership.following,
    this.isRerouting = false,
  });

  ActiveDrive copyWith({
    Route? route,
    CameraOwnership? camera,
    bool? isRerouting,
  }) =>
      ActiveDrive(
        route: route ?? this.route,
        camera: camera ?? this.camera,
        isRerouting: isRerouting ?? this.isRerouting,
      );
}
