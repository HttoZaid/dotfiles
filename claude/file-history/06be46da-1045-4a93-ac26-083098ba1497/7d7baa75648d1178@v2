import 'package:here_sdk/routing.dart';

// Maps every ManeuverAction enum value to an asset path.
//
// Icon filenames are taken directly from:
//   assets/maneuver_icons/  (copied from here-sdk_doc_local/.../graphics/maneuver_icons/)
//
// SDK FFI integer → enum value mapping verified from maneuver_action.dart.
// Roundabout exits 8–12 have no dedicated icon; they fall back to exit 7
// for the same traffic direction (the highest numbered icon available).
//
// UK drives on the left → left-hand traffic → use left-roundabout-* variants.

const String _base = 'assets/maneuver_icons';

/// Returns the asset path for [action], or the continue-on icon as fallback.
String maneuverIconPath(ManeuverAction action) {
  return _icons[action] ?? '$_base/continue-on_solid_24px.png';
}

