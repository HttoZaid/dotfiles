// ── Filter state (autoDispose so it resets when the section leaves the tree) ──

final _checkpointFilterProvider =
    StateProvider.autoDispose<ContributionStatusEnum?>((ref) => null);

// ── Section ────────────────────────────────────────────────────────────────

class RouteCheckpointsSection extends ConsumerWidget {
  const RouteCheckpointsSection({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final async = ref.watch(routeCheckpointsProvider);
    final allCheckpoints =
        ref.watch(checkpointNotifierProvider).value?.checkpoints ?? [];

    return async.when(
      loading: () => const Padding(
        padding: EdgeInsets.symmetric(vertical: ThemeSpacing.sp4),
        child: Center(child: CircularProgressIndicator.adaptive()),
      ),
      error: (_, __) => const SizedBox.shrink(),
      data: (results) {
        if (results.isEmpty) {
          return Padding(
            padding: const EdgeInsets.only(top: ThemeSpacing.sp2),
            child: Text(
              'No checkpoints on this route',
              style: ThemeText.subheadline.copyWith(
                color: ThemeColors.textTertiary,
              ),
              textAlign: TextAlign.center,
            ),
          );
        }

        final byId = {for (final c in allCheckpoints) c.id: c};
        final pairs = results
            .map((r) => (result: r, checkpoint: byId[r.checkpointId]))
            .where((p) => p.checkpoint != null)
            .toList();

        final filter = ref.watch(_checkpointFilterProvider);
        final filtered = filter == null
            ? pairs
            : pairs
                .where((p) {
                  final status = p.checkpoint!.contributions.isNotEmpty
                      ? p.checkpoint!.contributions.first.status
                      : null;
                  return status == filter;
                })
                .toList();

        // Which statuses are actually present in results?
        final presentStatuses = {
          for (final p in pairs)
            if (p.checkpoint!.contributions.isNotEmpty)
              p.checkpoint!.contributions.first.status,
        };

        return Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            // ── Header + count ────────────────────────────────────────────
            Text(
              'Checkpoints on route (${pairs.length})',
              style: ThemeText.labelSmall.copyWith(
                color: ThemeColors.textTertiary,
              ),
            ),

            const SizedBox(height: ThemeSpacing.sp2),

            // ── Filter chips ──────────────────────────────────────────────
            if (presentStatuses.length > 1) ...[
              SingleChildScrollView(
                scrollDirection: Axis.horizontal,
                child: Row(
                  children: [
                    _FilterChip(
                      label: 'All',
                      count: pairs.length,
                      selected: filter == null,
                      color: ThemeColors.accent,
                      onTap: () => ref
                          .read(_checkpointFilterProvider.notifier)
                          .state = null,
                    ),
                    ..._kFilterDefs.where((d) => presentStatuses.contains(d.$1)).map(
                      (d) {
                        final count = pairs
                            .where((p) {
                              final s = p.checkpoint!.contributions.isNotEmpty
                                  ? p.checkpoint!.contributions.first.status
                                  : null;
                              return s == d.$1;
                            })
                            .length;
                        return _FilterChip(
                          label: d.$2,
                          count: count,
                          selected: filter == d.$1,
                          color: d.$3,
                          onTap: () => ref
                              .read(_checkpointFilterProvider.notifier)
                              .state = d.$1,
                        );
                      },
                    ),
                  ],
                ),
              ),
              const SizedBox(height: ThemeSpacing.sp3),
            ],

            // ── List ──────────────────────────────────────────────────────
            if (filtered.isEmpty)
              Padding(
                padding: const EdgeInsets.symmetric(vertical: ThemeSpacing.sp3),
                child: Text(
                  'No checkpoints match this filter',
                  style: ThemeText.subheadline.copyWith(
                    color: ThemeColors.textTertiary,
                  ),
                ),
              )
            else
              ...filtered.map(
                (p) => _RouteCheckpointItem(
                  result: p.result,
                  checkpoint: p.checkpoint!,
                ),
              ),
          ],
        );
      },
    );
  }
}

// ── Filter chip definitions: (status, label, color) ───────────────────────

typedef _FilterDef = (ContributionStatusEnum, String, Color);

const List<_FilterDef> _kFilterDefs = [
  (ContributionStatusEnum.ACTIVE, 'Active', ThemeColors.danger),
  (ContributionStatusEnum.INACTIVE, 'Clear', Color(0xFF1F7A4D)),
  (ContributionStatusEnum.POLICE_ALERT, 'Police', Color(0xFFB45309)),
];

// ── Filter chip widget ─────────────────────────────────────────────────────

class _FilterChip extends StatelessWidget {
  final String label;
  final int count;
  final bool selected;
  final Color color;
  final VoidCallback onTap;

  const _FilterChip({
    required this.label,
    required this.count,
    required this.selected,
    required this.color,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.only(right: ThemeSpacing.sp2),
      child: GestureDetector(
        onTap: onTap,
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 150),
          padding: const EdgeInsets.symmetric(
            horizontal: ThemeSpacing.sp3,
            vertical: 6,
          ),
          decoration: BoxDecoration(
            color: selected ? color.withValues(alpha: 0.12) : Colors.transparent,
            border: Border.all(
              color: selected ? color : ThemeColors.border,
              width: selected ? 1.5 : 1,
            ),
            borderRadius: BorderRadius.circular(99),
          ),
          child: Text(
            '$label ($count)',
            style: ThemeText.labelSmall.copyWith(
              color: selected ? color : ThemeColors.textTertiary,
              fontWeight: selected ? FontWeight.w600 : FontWeight.w400,
            ),
          ),
        ),
      ),
    );
  }
}

// ── Checkpoint list item ───────────────────────────────────────────────────

class _RouteCheckpointItem extends ConsumerWidget {
  final RouteCheckpointResult result;
  final Checkpoint checkpoint;

  const _RouteCheckpointItem({
    required this.result,
    required this.checkpoint,
  });

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final status = checkpoint.contributions.isNotEmpty
        ? checkpoint.contributions.first.status
        : null;
    final lastUpdate = checkpoint.contributions.isNotEmpty
        ? checkpoint.contributions.first.createdAt
        : checkpoint.createdAt;
    final (Color sc, IconData si) = _statusStyle(status);

    return InkWell(
      borderRadius: ThemeRadius.brSmall,
      onTap: () => _onTap(context, ref),
      child: Padding(
        padding: const EdgeInsets.symmetric(vertical: ThemeSpacing.sp2),
        child: Row(
          children: [
            Container(
              width: 36,
              height: 36,
              decoration: BoxDecoration(
                color: sc.withValues(alpha: 0.09),
                shape: BoxShape.circle,
              ),
              child: Icon(si, color: sc, size: 16),
            ),
            const SizedBox(width: ThemeSpacing.sp3),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    checkpoint.name,
                    style: ThemeText.bodyMedium,
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                  ),
                  Text(
                    '${UkFormatter.formatDistance(result.distanceAlongRouteMeters)} · ${_timeAgo(lastUpdate)}',
                    style: ThemeText.subheadline.copyWith(
                      color: ThemeColors.textSecondary,
                    ),
                  ),
                ],
              ),
            ),
            const Icon(
              Icons.chevron_right,
              size: 16,
              color: ThemeColors.textTertiary,
            ),
          ],
        ),
      ),
    );
  }

  void _onTap(BuildContext context, WidgetRef ref) {
    ref.read(sheetStateNotifierProvider.notifier).peek();
    ref.read(mapControllerProvider.notifier).focusOnCheckpoint(checkpoint);
    unawaited(
      showModalBottomSheet(
        context: context,
        isScrollControlled: true,
        backgroundColor: Colors.transparent,
        builder: (_) => CheckpointActionSheet(checkpoint: checkpoint),
      ),
    );
  }
}

// ── Helpers ────────────────────────────────────────────────────────────────

String _timeAgo(DateTime dt) {
  final diff = DateTime.now().difference(dt.toLocal());
  if (diff.inMinutes < 1) return 'just now';
  if (diff.inMinutes < 60) return '${diff.inMinutes}m ago';
  if (diff.inHours < 24) return '${diff.inHours}h ago';
  return DateFormat('HH:mm').format(dt.toLocal());
}

(Color, IconData) _statusStyle(ContributionStatusEnum? status) =>
    switch (status) {
      ContributionStatusEnum.ACTIVE => (
        ThemeColors.danger,
        Icons.sensors_rounded,
      ),
      ContributionStatusEnum.INACTIVE => (
        const Color(0xFF1F7A4D),
        Icons.check_circle_outline_rounded,
      ),
      ContributionStatusEnum.POLICE_ALERT => (
        const Color(0xFFB45309),
        Icons.warning_amber_rounded,
      ),
      _ => (ThemeColors.stone300, Icons.help_outline_rounded),
    };
