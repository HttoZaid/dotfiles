import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:ukcheckpoints_app/core/theme/theme.dart';
import 'package:ukcheckpoints_app/features/navigation/models/navigation_phase.dart';
import 'package:ukcheckpoints_app/features/navigation/providers/nav_state_provider.dart';
import 'package:ukcheckpoints_app/features/navigation/search/nav_search_notifier.dart';
import 'package:ukcheckpoints_app/features/navigation/utils/strings.dart';

class NavPeekContent extends ConsumerWidget {
  final VoidCallback onTap;

  const NavPeekContent({required this.onTap, super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final phase = ref.watch(navStateNotifierProvider);

    return switch (phase) {
      TripOverview() => _TripReadyPeek(phase: phase),
      _ => _SearchPeek(onTap: onTap),
    };
  }
}

// ── Search pill (Idle / Searching) ─────────────────────────────────────────

class _SearchPeek extends ConsumerWidget {
  final VoidCallback onTap;

  const _SearchPeek({required this.onTap});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final dest = ref.watch(navSearchNotifierProvider).selectedDest;

    return Padding(
      padding: const EdgeInsets.fromLTRB(
        ThemeSpacing.sp4,
        ThemeSpacing.sp2,
        ThemeSpacing.sp4,
        ThemeSpacing.sp4,
      ),
      child: GestureDetector(
        onTap: onTap,
        child: Container(
          height: 52,
          decoration: BoxDecoration(
            color: ThemeColors.surfaceContainer,
            borderRadius: ThemeRadius.brFull,
          ),
          padding: const EdgeInsets.symmetric(horizontal: ThemeSpacing.sp4),
          child: Row(
            children: [
              const Icon(Icons.search, size: 20, color: ThemeColors.accent),
              const SizedBox(width: ThemeSpacing.sp3),
              Expanded(
                child: Text(
                  dest?.title ?? NavStrings.whereToHint,
                  style: ThemeText.bodyMedium.copyWith(
                    color: dest != null
                        ? ThemeColors.textPrimary
                        : ThemeColors.textTertiary,
                  ),
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                ),
              ),
              if (dest != null)
                const Icon(
                  Icons.chevron_right,
                  size: 18,
                  color: ThemeColors.textTertiary,
                ),
            ],
          ),
        ),
      ),
    );
  }
}

// ── Route-ready banner (TripOverview, drive not yet started) ───────────────

class _TripReadyPeek extends ConsumerWidget {
  final TripOverview phase;

  const _TripReadyPeek({required this.phase});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final dest = ref.watch(navSearchNotifierProvider).selectedDest;
    final navNotifier = ref.read(navStateNotifierProvider.notifier);

    return Padding(
      padding: const EdgeInsets.fromLTRB(
        ThemeSpacing.sp4,
        ThemeSpacing.sp3,
        ThemeSpacing.sp4,
        ThemeSpacing.sp4,
      ),
      child: Row(
        children: [
          const Icon(Icons.route, size: 20, color: ThemeColors.accent),
          const SizedBox(width: ThemeSpacing.sp3),
          Expanded(
            child: Text(
              dest?.title ?? NavStrings.goingToHint,
              style: ThemeText.bodyMedium,
              maxLines: 1,
              overflow: TextOverflow.ellipsis,
            ),
          ),
          const SizedBox(width: ThemeSpacing.sp2),
          OutlinedButton(
            style: OutlinedButton.styleFrom(
              minimumSize: const Size(0, 40),
              padding:
                  const EdgeInsets.symmetric(horizontal: ThemeSpacing.sp3),
            ),
            onPressed: () => navNotifier.closeTrip(),
            child: const Text(NavStrings.closeCta),
          ),
          const SizedBox(width: ThemeSpacing.sp2),
          FilledButton(
            style: FilledButton.styleFrom(
              minimumSize: const Size(0, 40),
              padding:
                  const EdgeInsets.symmetric(horizontal: ThemeSpacing.sp3),
            ),
            onPressed: () => navNotifier.startDrive(phase.route),
            child: const Text(NavStrings.startDriveCta),
          ),
        ],
      ),
    );
  }
}
