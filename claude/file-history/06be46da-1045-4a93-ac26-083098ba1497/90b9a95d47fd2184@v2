import 'package:here_sdk/core.dart';
import 'package:here_sdk/navigation.dart';
import 'package:here_sdk/routing.dart';

// Single file that owns UK-imperial configuration for routing and navigation.
// UnitSystem.imperialUk is the exact identifier — the lowercase 'k' matters.
// This is the ONLY place in the codebase that references UnitSystem.imperialUk.

/// Returns [CarOptions] configured for UK imperial routing.
CarOptions buildUkCarOptions() {
  final options = CarOptions();
  options.textOptions.language = LanguageCode.enGb;
  options.textOptions.unitSystem = UnitSystem.imperialUk;
  return options;
}

/// Returns [PedestrianOptions] configured for UK imperial routing.
PedestrianOptions buildUkPedestrianOptions() {
  final options = PedestrianOptions();
  options.textOptions.language = LanguageCode.enGb;
  options.textOptions.unitSystem = UnitSystem.imperialUk;
  return options;
}

/// Sets UK imperial units on [navigator]'s voice/text notifications.
///
/// Call this immediately after constructing the [VisualNavigator], before
/// [startRendering]. Must be called again after any reroute that
/// recreates the navigator.
void applyUkUnitsToNavigator(VisualNavigator navigator) {
  navigator.maneuverNotificationOptions = ManeuverNotificationOptions(
    LanguageCode.enGb,
    UnitSystem.imperialUk,
  );
}
