import 'package:riverpod_annotation/riverpod_annotation.dart';
import '../models/sheet_state.dart';

part 'sheet_state_provider.g.dart';

@Riverpod(keepAlive: true)
class SheetStateNotifier extends _$SheetStateNotifier {
  @override
  SheetState build() => const SheetState();

  void peek() {
    if (state.mode != SheetMode.peek) state = state.copyWith(mode: SheetMode.peek);
  }

  void expand() {
    if (state.mode != SheetMode.fullSearch) {
      state = state.copyWith(mode: SheetMode.fullSearch);
    }
  }

  void showTripOverview() {
    if (state.mode != SheetMode.tripOverview) {
      state = state.copyWith(mode: SheetMode.tripOverview);
    }
  }

  void updateOrigin(String value) {
    if (state.typedOrigin != value) state = state.copyWith(typedOrigin: value);
  }

  void updateDest(String value) {
    if (state.typedDest != value) state = state.copyWith(typedDest: value);
  }
}
