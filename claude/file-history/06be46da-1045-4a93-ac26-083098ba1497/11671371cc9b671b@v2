/// Visible state of the bottom sheet.
enum SheetMode {
  /// Collapsed — "Where to?" pill visible, map is primary.
  peek,

  /// Fully expanded — origin + destination inputs, autosuggest list.
  fullSearch,

  /// Half-open — trip summary card, route checkpoints, Start drive CTA.
  tripOverview,
}

/// Persistent sheet UI state.
///
/// Lives outside the widget tree so peeking / collapsing the sheet
/// never discards typed text, scroll position, or suggestions.
class SheetState {
  final SheetMode mode;

  /// Text in the origin field (may be empty if using current location).
  final String typedOrigin;

  /// Text in the destination field (what the user has typed so far).
  final String typedDest;

  const SheetState({
    this.mode = SheetMode.peek,
    this.typedOrigin = '',
    this.typedDest = '',
  });

  SheetState copyWith({
    SheetMode? mode,
    String? typedOrigin,
    String? typedDest,
  }) =>
      SheetState(
        mode: mode ?? this.mode,
        typedOrigin: typedOrigin ?? this.typedOrigin,
        typedDest: typedDest ?? this.typedDest,
      );
}
