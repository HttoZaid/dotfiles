  // Domain
  static const Color plateYellow = Color(0xFFFFD307);
}

// ─── Spacing ──────────────────────────────────────────────────

abstract final class ThemeSpacing {
  static const double sp1 = 4;
  static const double sp2 = 8;
  static const double sp3 = 12;
  static const double sp4 = 16; // ★ screen edge — sacred
  static const double sp5 = 20;
  static const double sp6 = 24;
  static const double sp8 = 32;
  static const double sp10 = 40;
  static const double sp12 = 48;
  static const double sp16 = 64;
}

// ─── Radius ───────────────────────────────────────────────────

abstract final class ThemeRadius {
  static const double rXs = 4;
  static const double rSm = 6;
  static const double rMd = 8;
  static const double rLg = 12;
  static const double rXl = 16;
  static const double r2xl = 22;
  static const double rFull = 999;

  static final BorderRadius brXs = BorderRadius.circular(rXs);
  static final BorderRadius brSm = BorderRadius.circular(rSm);
  static final BorderRadius brMd = BorderRadius.circular(rMd);
  static final BorderRadius brLg = BorderRadius.circular(rLg);
  static final BorderRadius brXl = BorderRadius.circular(rXl);
  static final BorderRadius br2xl = BorderRadius.circular(r2xl);
  static final BorderRadius brFull = BorderRadius.circular(rFull);
}

// ─── Shadows ──────────────────────────────────────────────────

abstract final class ThemeShadows {
  static const List<BoxShadow> sm = [
    BoxShadow(blurRadius: 2, offset: Offset(0, 1), color: Color(0x140E141B)),
  ];
  static const List<BoxShadow> md = [
    BoxShadow(blurRadius: 6, offset: Offset(0, 2), color: Color(0x140E141B)),
    BoxShadow(blurRadius: 12, offset: Offset(0, 4), color: Color(0x140E141B)),
  ];
  static const List<BoxShadow> lg = [
    BoxShadow(blurRadius: 24, offset: Offset(0, -4), color: Color(0x1A0E141B)),
    BoxShadow(blurRadius: 8, offset: Offset(0, 2), color: Color(0x100E141B)),
  ];
}

// ─── Motion ───────────────────────────────────────────────────

abstract final class ThemeMotion {
  static const Duration durFast = Duration(milliseconds: 120);
  static const Duration durBase = Duration(milliseconds: 220);
  static const Duration durSlow = Duration(milliseconds: 380);
  static const Duration durSlower = Duration(milliseconds: 500);

  /// Ease-in-out — data transitions, color changes, sheets.
  static const Curve smooth = Cubic(0.4, 0.0, 0.2, 1.0);

  /// Spring overshoot — toggles, drawers, physical interactions.
  static const Curve spring = Cubic(0.34, 1.56, 0.64, 1.0);

  /// Enter — elements arriving on screen.
  static const Curve easeOut = Cubic(0.0, 0.0, 0.2, 1.0);

  /// Exit — elements leaving screen.
  static const Curve easeIn = Cubic(0.4, 0.0, 1.0, 1.0);
}

