// ─── MaterialApp theme ────────────────────────────────────────

abstract final class AppTheme {
  static ThemeData get light {
    return ThemeData(
      useMaterial3: true,
      fontFamily: ThemeFonts.ui,
      scaffoldBackgroundColor: ThemeColors.bg,
      primaryColor: ThemeColors.accent,

      colorScheme: const ColorScheme.light(
        primary: ThemeColors.accent,
        onPrimary: Colors.white,
        secondary: ThemeColors.textSecondary,
        onSecondary: Colors.white,
        error: ThemeColors.danger,
        onError: Colors.white,
        surface: ThemeColors.bgRaised,
        onSurface: ThemeColors.textPrimary,
      ),

      textTheme: const TextTheme(
        displayLarge: TextStyle(
          fontFamily: ThemeFonts.display,
          fontSize: 32,
          fontWeight: FontWeight.w600,
          color: ThemeColors.textPrimary,
          letterSpacing: -0.5,
        ),
        displayMedium: TextStyle(
          fontFamily: ThemeFonts.display,
          fontSize: 24,
          fontWeight: FontWeight.w600,
          color: ThemeColors.textPrimary,
          letterSpacing: -0.3,
        ),
        titleLarge: ThemeText.title1,
        titleMedium: ThemeText.headline,
        bodyLarge: ThemeText.body,
        bodyMedium: ThemeText.callout,
        bodySmall: ThemeText.subheadline,
        labelSmall: ThemeText.eyebrow,
      ),

      elevatedButtonTheme: ElevatedButtonThemeData(
        style: ElevatedButton.styleFrom(
          backgroundColor: ThemeColors.accent,
          foregroundColor: Colors.white,
          elevation: 0,
          shadowColor: Colors.transparent,
          padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 12),
          shape: RoundedRectangleBorder(borderRadius: ThemeRadius.brMd),
          textStyle: ThemeText.callout.copyWith(color: Colors.white),
        ).copyWith(overlayColor: WidgetStateProperty.all(Colors.black12)),
      ),

      textButtonTheme: TextButtonThemeData(
        style: TextButton.styleFrom(
          foregroundColor: ThemeColors.textSecondary,
          padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 12),
          shape: RoundedRectangleBorder(borderRadius: ThemeRadius.brMd),
          textStyle: ThemeText.callout,
        ),
      ),

      inputDecorationTheme: InputDecorationTheme(
        filled: true,
        fillColor: ThemeColors.bgRaised,
        contentPadding: const EdgeInsets.symmetric(
          horizontal: 14,
          vertical: 12,
        ),
        hintStyle: ThemeText.body.copyWith(color: ThemeColors.textTertiary),
        labelStyle: ThemeText.callout,
        enabledBorder: OutlineInputBorder(
          borderRadius: ThemeRadius.brMd,
          borderSide: const BorderSide(color: ThemeColors.borderStrong),
        ),
        focusedBorder: OutlineInputBorder(
          borderRadius: ThemeRadius.brMd,
          borderSide: const BorderSide(color: ThemeColors.accent, width: 1.5),
        ),
        errorBorder: OutlineInputBorder(
          borderRadius: ThemeRadius.brMd,
          borderSide: const BorderSide(color: ThemeColors.danger),
        ),
        focusedErrorBorder: OutlineInputBorder(
          borderRadius: ThemeRadius.brMd,
          borderSide: const BorderSide(color: ThemeColors.danger, width: 1.5),
        ),
      ),

      cardTheme: CardThemeData(
        color: ThemeColors.bgRaised,
        elevation: 0,
        margin: EdgeInsets.zero,
        shape: RoundedRectangleBorder(
          borderRadius: ThemeRadius.brLg,
          side: const BorderSide(color: ThemeColors.border),
        ),
      ),

      dividerTheme: const DividerThemeData(
        color: ThemeColors.border,
        thickness: 1,
        space: 24,
      ),

      navigationBarTheme: NavigationBarThemeData(
        backgroundColor: ThemeColors.bgRaised,
        indicatorColor: ThemeColors.accentSubtle,
        elevation: 0,
        surfaceTintColor: Colors.transparent,
        iconTheme: WidgetStateProperty.resolveWith((states) {
          if (states.contains(WidgetState.selected)) {
            return const IconThemeData(color: ThemeColors.accent, size: 24);
          }
          return const IconThemeData(color: ThemeColors.stone500, size: 24);
        }),
        labelTextStyle: WidgetStateProperty.resolveWith((states) {
          if (states.contains(WidgetState.selected)) {
            return const TextStyle(
              fontFamily: ThemeFonts.ui,
              fontSize: 11,
              fontWeight: FontWeight.w500,
              letterSpacing: 0.5,
              color: ThemeColors.accent,
            );
          }
          return const TextStyle(
            fontFamily: ThemeFonts.ui,
            fontSize: 11,
            fontWeight: FontWeight.w500,
            letterSpacing: 0.5,
            color: ThemeColors.stone500,
          );
        }),
      ),

      switchTheme: SwitchThemeData(
        thumbColor: WidgetStateProperty.all(Colors.white),
        trackColor: WidgetStateProperty.resolveWith((states) {
          if (states.contains(WidgetState.selected)) return ThemeColors.accent;
          return ThemeColors.borderStrong;
        }),
      ),
    );
  }
}
