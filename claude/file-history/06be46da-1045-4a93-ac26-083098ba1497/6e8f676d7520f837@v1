import 'package:flutter/material.dart';

// ─── Fonts ────────────────────────────────────────────────────

abstract final class ThemeFonts {
  static const String ui = 'Inter';
  static const String display = 'Poppins';
}

// ─── Colors ───────────────────────────────────────────────────

abstract final class ThemeColors {
  // Stone ramp
  static const Color stone50 = Color(0xFFF7F7F9);
  static const Color stone100 = Color(0xFFF2F2F7);
  static const Color stone200 = Color(0xFFE5E5EA);
  static const Color stone300 = Color(0xFFD1D1D6);
  static const Color stone400 = Color(0xFFAEAEB2);
  static const Color stone500 = Color(0xFF8E8E93);
  static const Color stone600 = Color(0xFF636366);
  static const Color stone700 = Color(0xFF48484A);
  static const Color stone800 = Color(0xFF3A3A3C);
  static const Color stone900 = Color(0xFF111111);

  // Slate accent ramp
  static const Color slate50 = Color(0xFFE8EEFB);
  static const Color slate100 = Color(0xFFCFDAF7);
  static const Color slate500 = Color(0xFF1F5DD8); // ★ accent
  static const Color slate600 = Color(0xFF1A4FB8);

  // Semantic status
  static const Color success = Color(0xFF1F7A4D);
  static const Color successSubtle = Color(0xFFDFF1E6);
  static const Color warning = Color(0xFFB45309);
  static const Color warningSubtle = Color(0xFFFCEAC8);
  static const Color danger = Color(0xFFB42318);
  static const Color dangerSubtle = Color(0xFFFCE6E1);
  static const Color info = Color(0xFF1F5DD8);
  static const Color infoSubtle = Color(0xFFE8EEFB);

  // Surfaces
  static const Color bg = stone50;
  static const Color bgRaised = Color(0xFFFFFFFF);
  static const Color bgSubtle = Color(0xFFEFF2F5);

  // Borders (opaque — simpler than semi-transparent for dark mode later)
  static const Color border = Color(0xFFE3E6EB);
  static const Color borderStrong = Color(0xFFC8CDD4);

  // Text
  static const Color textPrimary = stone900;
  static const Color textSecondary = Color(0xFF5A6573);
  static const Color textTertiary = Color(0xFF8B95A2);

  // Accent
  static const Color accent = slate500;
  static const Color accentHover = slate600;
