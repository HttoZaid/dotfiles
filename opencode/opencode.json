{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CONTRIBUTING.md"],
  "plugin": ["opencode-gemini-auth@latest"],
  "provider": {
    "google": {
      "options": {
        "projectId": "notify-478811"
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "rm *": "deny",
      "git push*": "deny",
      "npm publish*": "deny"
    }
  }
}
