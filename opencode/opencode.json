{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/rules/read_only_rationale.md"],
  "plugin": ["@dietrichgebert/ponytail"],
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "edit": "deny",
    "write": "deny",
    "bash": {
      "*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "rm *": "deny",
      "git push*": "deny",
      "npm publish*": "deny"
    }
  }
}
